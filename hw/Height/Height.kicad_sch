	(text "GAL LOGIC NOTES\n\nDefinitions:\n  MEM      = BUS_OK & !HIGH_MEM_N\n  READ     = R_W\n  WRITE    = !R_W\n  ROMMODE  = !RAM_ROM\n  RAMMODE  = RAM_ROM\n\nLatch register:\n  ADDR03_N from 74LS688, active low when A7..A0 = $03\n\n  LATCH_CLK = BUS_OK & !IO_SEL_N & !ADDR03_N & WRITE\n\nROM chip selects:\n  ROM0_CS_N = !(MEM & ROMMODE & !SEL1 & !SEL0)\n  ROM1_CS_N = !(MEM & ROMMODE & !SEL1 &  SEL0)\n  ROM2_CS_N = !(MEM & ROMMODE &  SEL1 & !SEL0)\n  ROM3_CS_N = !(MEM & ROMMODE &  SEL1 &  SEL0)\n\nRAM:\n  RAM_CS_N = !MEM\n\n  RAM_OE_N = !(MEM & RAMMODE & READ)\n\n  ; write-through shadow RAM:\n  ; RAM remains writable even while ROM is visible\n  RAM_WE_N = !(MEM & WRITE & !RAM_WP)\n\nROM output enable:\n  ROM_OE_N = !(MEM & ROMMODE & READ)\n\nEEPROM write enable:\n  ROM_WE_N = 1  ; tied inactive unless programming support is added"
		(exclude_from_sim no)
		(at 194.564 155.448 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "be9d889a-fb03-4728-817a-161ccb77d2ec")
	)
	(text "RESET clears 74HCT273:\n  RAM_ROM = 0  -> ROM mode\n  SEL1:SEL0 = 00 -> ROM0\n  RAM_WP = 0 -> shadow RAM writable"
		(exclude_from_sim no)
		(at 244.348 151.384 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
