                        	   420: ; for user's terminal 
02:E2C1 B7E010          	   421:             staa acias                  ; inz acia
                        	   422: ; 
02:E2C4 7FBE16          	   423:             clr outsw                   ; make sure input is echoed
                        	   424: ; 
02:E2C7 CEE5A7          	   425:             ldx #mcloff                 ; terminal init string
02:E2CA BDE179          	   426:             jsr pdata1                  ; print data string
                        	   427: ; 
02:E2CD 8D92            	   428:             bsr inch1                   ; read command character
02:E2CF 16              	   429:             tab                         ; save character in b
02:E2D0 2002            	   430:             bra cnta                    ; skip over mikbug 1.0 vector
02:E2D2 2080            	   431: out2:       bra outch1                  ; mikbug 1.0 " output 1 char routine
02:E2D4 BDE1C7          	   432: cnta:       jsr outs                    ; print space after command
                        	   433: ; 
                        	   434: ; b register holds character input by user 
                        	   435: ; use jump table to go to appropriate routine. 
                        	   436: ; 
02:E2D7 7EFF80          	   437:             jmp flexdispatch            ; handle F, then original command table
02:E2DA E100            	   438: nxtchr:     cmpb 0,x                    ; does input char match?
02:E2DC 270A            	   439:             beq goodch                  ; yes, goto apropriate routine
02:E2DE 08              	   440:             inx                         ; else, update index into table
02:E2DF 08              	   441:             inx
02:E2E0 08              	   442:             inx
02:E2E1 8CE134          	   443:             cpx #fctben                 ; end of table reached?
02:E2E4 26F4            	   444:             bne nxtchr                  ; no, try next char
02:E2E6 20D3            	   445:             bra contrl                  ; no match, reprompt user
                        	   446: ; 
                        	   447: ; 
02:E2E8 EE01            	   448: goodch:     ldx 1,x                     ; get address from j.t.
02:E2EA 6E00            	   449:             jmp 0,x                     ; goto appropriate routine
                        	   450: ; 
