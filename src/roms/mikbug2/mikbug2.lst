01:E406 20B2            	   701:             bra bkcon3                  ; out4hs increments x,
                        	   702: ; so bypas 2 inx's 
                        	   703: ; 
                        	   704: ; print contents of stack 
                        	   705: ; 
01:E408 BDE199          	   706: print:      jsr pcrlf                   ; print cr lf
01:E40B FEBE08          	   707:             ldx sp                      ; print out stack
01:E40E 08              	   708:             inx
01:E40F 8DEA            	   709:             bsr ot2hs                   ; condition codes
01:E411 8DE8            	   710:             bsr ot2hs                   ; acc-b
01:E413 8DE6            	   711:             bsr ot2hs                   ; acc-a
01:E415 8DE7            	   712:             bsr ot4hs                   ; x-reg
01:E417 8DE5            	   713:             bsr ot4hs                   ; p-counter
01:E419 CEBE08          	   714:             ldx #sp
01:E41C 8DE0            	   715:             bsr ot4hs                   ; stack pointer
01:E41E 39              	   716:             rts
