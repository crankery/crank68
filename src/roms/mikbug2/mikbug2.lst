02:E323 8DF5            	   489: rstbrk:     bsr baddrj                  ; puts user entered address
                        	   490: ; into xhi,xlo 
02:E325 4F              	   491:             clra                        ; reset 1 break flag
02:E326 20F7            	   492:             bra bsrbrk                  ; go reset 1
                        	   493: ; 
                        	   494: ; print out all non-zero break addresses 
                        	   495: ; 
02:E328 BDE199          	   496: pntbrk:     jsr pcrlf                   ; do cr"lf
02:E32B 8602            	   497:             ldaa #2                     ; print break addresses flags
02:E32D 20F0            	   498:             bra bsrbrk                  ; go print
                        	   499: ; 
                        	   500: ; set one break 
                        	   501: ; 
02:E32F 8DE9            	   502: setbrk:     bsr baddrj                  ; get user entered address (xhi,xlo)
02:E331 8604            	   503:             ldaa #4                     ; set one break flag
02:E333 8D5B            	   504:             bsr brksub                  ; go set it
02:E335 20F1            	   505:             bra pntbrk                  ; print all breakpoints
                        	   506: ; 
                        	   507: ; go to requested 
                        	   508: ; 
02:E337 8DE1            	   509: goto:       bsr baddrj                  ; go get address from user
                        	   510: ; xhi,xlow hold address 
02:E339 86FF            	   511:             ldaa #0xff                  ; flag for putting in breaks
02:E33B 8D53            	   512:             bsr brksub                  ; go put in breaks
02:E33D 30              	   513:             tsx
02:E33E B6BE3E          	   514:             ldaa xhi                    ; save pch on stack
02:E341 A705            	   515:             staa 5,x
02:E343 B6BE3F          	   516:             ldaa xlow                   ; push pcl
02:E346 A706            	   517:             staa 6,x
02:E348 3B              	   518:             rti                         ; go to user prg
                        	   519: ; 
                        	   520: ; single instruction trace requested 
                        	   521: ; 
02:E349 CE0001          	   522: next:       ldx #1                      ; # instructions to trace
02:E34C 7FBE43          	   523: trace2:     clr brktrc                  ; clear flag indicating trace
                        	   524: ; is due to break 
02:E34F 7DBE45          	   525: trace3:     tst resume_valid
02:E352 260F            	   526:             bne trace3_ready
02:E354 7FBE43          	   527:             clr brktrc
02:E357 BDE199          	   528:             jsr pcrlf
02:E35A CEE5E6          	   529:             ldx #mcl_noresume
02:E35D BDE179          	   530:             jsr pdata1
02:E360 7EE2BB          	   531:             jmp contrl
02:E363 FFBE1A          	   532: trace3_ready: stx ntrace                ; save # inst's to trace
                        	   533: ; is due to break 
02:E366 FEBE08          	   534:             ldx sp                      ; x : = stack pointer
02:E369 EE06            	   535:             ldx 6,x                     ; x : = address of instr to be ex
02:E36B FFBE17          	   536:             stx trcadr                  ; save in trace address store
02:E36E A600            	   537:             ldaa 0,x                    ; get instruction to be traced
02:E370 B7BE19          	   538:             staa trcins                 ; save in trace instruction store
02:E373 7EE4F6          	   539:             jmp contrc                  ; go to continue trace part of
                        	   540: ; 
                        	   541: ; multiple instruction trace 
                        	   542: ; 
02:E376 8DA2            	   543: trace:      bsr baddrj                  ; get # of instructions to trace
02:E378 20D2            	   544:             bra trace2                  ; go trace'm
                        	   545: ; 
                        	   546: ; continue execution 
                        	   547: ; 
02:E37A 7CBE43          	   548: cont:       inc brktrc                  ; trace 1 to restore swi's
02:E37D CE0001          	   549:             ldx #1                      ; one trace only
02:E380 20CD            	   550:             bra trace3
                        	   551: ; 
                        	   552: ; 
                        	   553: ; r command 
                        	   554: ; 
                        	   555: ; print stack contents 
                        	   556: ; 
02:E382 BDE199          	   557: pstak1:     jsr pcrlf                   ; print cr lf
02:E385 CEE5C3          	   558:             ldx #mcl3                   ; print header
02:E388 BDE179          	   559:             jsr pdata1
