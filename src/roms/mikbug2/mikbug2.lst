                        	   347: ; 
                        	   348: ; input one char to areg 
02:E261 B6E010          	   349: inch1:      ldaa acias
02:E264 47              	   350:             asra
02:E265 24FA            	   351:             bcc inch1                   ; receiver not ready
02:E267 B6E011          	   352:             ldaa aciad                  ; input char
02:E26A 847F            	   353:             anda #0x7f                  ; reset parity bit
02:E26C 817F            	   354:             cmpa #0x7f
02:E26E 27F1            	   355:             beq inch1                   ; rubout"del
