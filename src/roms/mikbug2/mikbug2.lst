                        	   788: ; 
                        	   789: ; swi-1 software interrupt level 1 processing 
                        	   790: ; 
                        	   791: swi15:
01:E49C BFBE08          	   792:             sts sp                      ; save user's sp
01:E49F 8601            	   793:             ldaa #1
01:E4A1 B7BE45          	   794:             staa resume_valid
                        	   795: ; 
01:E4A4 8603            	   796:             ldaa #3
