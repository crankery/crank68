                        	  1083: 
                        	  1084: ; Shared SD transport at fixed ROM addresses.
                        	  1085:             .include "sdcard.s"

Source: "sdcard.s"
                        	     1: ; Instore direct-register SD transport, fixed ROM API for FLEX and boot loaders.
                        	     2: ; A=track, B=sector, X=256-byte buffer for READ/WRITE. READY preserves X.
                        	     3: ; Return B=0/Z=1/C=0, or B!=0/Z=0/C=1. Not reentrant.
                        	     4: ; The AVR owns $E080/$E081. Each host access must wait for its sequence ACK:
                        	     5: ; RX_SEQUENCE toggles after a command/data write, TX_SEQUENCE after a data read.
                        	     6: ; Scratch $9B00..$9B11 is reserved above FLEX's $7FFF application limit.
                        	     7: ; Scale the timeout loop for a 1..4 MHz host; hardware timing needs validation.
                        	     8:     .equ SD_CPU_MHZ, 1
                        	     9:     .equ SDPORT_COMMAND, 0xE080
                        	    10:     .equ SDPORT_STATUS, 0xE080
                        	    11:     .equ SDPORT_DATA, 0xE081
                        	    12:     .equ SD_RX_SPACE, 0x01
                        	    13:     .equ SD_TX_VALID, 0x02
                        	    14:     .equ SD_RX_SEQUENCE, 0x20
                        	    15:     .equ SD_TX_SEQUENCE, 0x40
                        	    16:     .org 0xF000
