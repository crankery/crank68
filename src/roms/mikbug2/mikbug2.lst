02:F006 7EF0F9          	    19: sd_ready_vector: jmp SDREADY
02:F009 7EF00F          	    20: sd_init_vector: jmp SDRESET
02:F00C 53              	    21: sd_signature: .byte 0x53,0x44,3
02:F00D 44
02:F00E 03
