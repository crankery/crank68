                        	   490: ; into xhi,xlo 
01:E325 4F              	   491:             clra                        ; reset 1 break flag
01:E326 20F7            	   492:             bra bsrbrk                  ; go reset 1
                        	   493: ; 
                        	   494: ; print out all non-zero break addresses 
