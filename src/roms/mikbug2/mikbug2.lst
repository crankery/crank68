02:E218 BDE142          	   311: change:     jsr baddr                   ; build address
02:E21B 8DAA            	   312:             bsr outs                    ; output space
02:E21D FEBE3E          	   313: chang:      ldx xhi
02:E220 8DA3            	   314:             bsr out2hs                  ; print data old
02:E222 09              	   315:             dex
02:E223 8D3C            	   316: cha1:       bsr inch1                   ; input char
02:E225 810A            	   317:             cmpa #0x0a
02:E227 2712            	   318:             beq lf                      ; check for line feed
02:E229 815E            	   319:             cmpa #0x5e
02:E22B 2711            	   320:             beq ua                      ; check for ^
