01:E33B 8D53            	   512:             bsr brksub                  ; go put in breaks
01:E33D 30              	   513:             tsx
01:E33E B6BE3E          	   514:             ldaa xhi                    ; save pch on stack
01:E341 A705            	   515:             staa 5,x
01:E343 B6BE3F          	   516:             ldaa xlow                   ; push pcl
01:E346 A706            	   517:             staa 6,x
01:E348 3B              	   518:             rti                         ; go to user prg
                        	   519: ; 
                        	   520: ; single instruction trace requested 
