02:E316 8615            	   474:             ldaa #0x15
02:E318 2082            	   475:             bra inz1                    ; set 2 stop bits
                        	   476: ; 
                        	   477: ; 
02:E31A 7EE142          	   478: baddrj:     jmp baddr                   ; go build address
                        	   479: ; 
                        	   480: ; 
                        	   481: ; reset all breakpoints 
                        	   482: ; 
02:E31D 8601            	   483: delbrk:     ldaa #1                     ; reset breaks flag
02:E31F 8D6F            	   484: bsrbrk:     bsr brksub                  ; break handling subr.
02:E321 206A            	   485:             bra cntrl2                  ; return to command level
                        	   486: ; 
                        	   487: ; reset 1 breakpoint 
