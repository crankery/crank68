02:E230 BDE152          	   322:             jsr byte2                   ; get new byte
02:E233 A700            	   323:             staa 0,x                    ; change memory
02:E235 A100            	   324:             cmpa 0,x
02:E237 26D8            	   325:             bne load19                  ; no change
