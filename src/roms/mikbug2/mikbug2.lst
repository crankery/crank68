01:E44D 8110            	   747:             cmpa #16
01:E44F 2502            	   748:             bcs pun23
01:E451 860F            	   749: pun22:      ldaa #15
01:E453 8B04            	   750: pun23:      adda #4
01:E455 B7BE3D          	   751:             staa mcont                  ; frame count this record
01:E458 8003            	   752:             suba #3
01:E45A B7BE3C          	   753:             staa temp                   ; byte count this record
                        	   754: ; punch c/r,l/f,nulls,s,1 
01:E45D CEE41F          	   755:             ldx #mtape1
01:E460 BDE179          	   756:             jsr pdata1
