                        	   360: ; 
                        	   361: ; constant initialization 
                        	   362: ; s = pointer to rom bytes to be copied to ram 
                        	   363: ; x = pointer to ram bytes to be initialized 
                        	   364: ; 
                        	   365: start:                                  ; actual code start
02:E276 8EE133          	   366:             lds #adrstr-1               ; start of constant data
02:E279 CEBE08          	   367:             ldx #sp                     ; start of ram area
                        	   368: ; 
02:E27C 32              	   369: inilp1:     pula                        ; get next constant byte
02:E27D A700            	   370:             staa 0,x                    ; init next ram byte
02:E27F 08              	   371:             inx                         ; update pointer
02:E280 8CBE16          	   372:             cpx #branen                 ; end of constant ram area?
02:E283 26F7            	   373:             bne inilp1                  ; no, continue initialization
                        	   374: ; 
                        	   375: ; initialization to 0 
                        	   376: ; x holds index of 1st byte to be set to 0 
                        	   377: ; 
02:E285 6F00            	   378: inilp2:     clr 0,x                     ; clear next byte of ram
02:E287 08              	   379:             inx                         ; update index
02:E288 8CBE44          	   380:             cpx #endin0                 ; any more bytes to init?
02:E28B 26F8            	   381:             bne inilp2                  ; no, continue clearing
02:E28D 7FBE45          	   382:             clr resume_valid            ; no interrupted program yet
                        	   383: ; 
                        	   384: ; set cc so when we 'GO' to user pgm the 
                        	   385: ; interupt mask is set 
                        	   386: ; 
02:E290 86D0            	   387:             ldaa #0xd0
02:E292 B7BE43          	   388:             staa brktrc                 ; put in stack to be pulled jdh: not sure about this one
                        	   389: ; 
