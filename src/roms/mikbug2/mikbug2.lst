                        	   718: 
                        	   719: ; punch dump 
                        	   720: ; punch from beginning address (bega) thru ending 
                        	   721: ; address (enda) 
                        	   722: ; 
                        	   723: 
02:E41F 0D              	   724: mtape1:     .byte 0xd,0xa,0,0,0,0,"S","1",4  ; punch format
02:E420 0A
02:E421 00
02:E422 00
02:E423 00
02:E424 00
02:E425 53
02:E426 31
02:E427 04
                        	   725: 
                        	   726: punch:
                        	   727: 
02:E428 BDE180          	   728:             jsr getadd                  ; get address
02:E42B 8612            	   729:             ldaa #0x12                  ; turn tty punch on
02:E42D BDE170          	   730:             jsr outch                   ; out char
                        	   731: ; 
                        	   732: ; punch leader - 25 nulls 
                        	   733: ; 
02:E430 C619            	   734:             ldab #25                    ; b holds # nulls to punch
02:E432 4F              	   735: pnull:      clra                        ; a=0 (null char)
02:E433 BDE170          	   736:             jsr outch                   ; go output null
02:E436 5A              	   737:             decb                        ; decrement counter
02:E437 26F9            	   738:             bne pnull                   ; if not done, then loop
                        	   739: ; 
02:E439 FEBE02          	   740:             ldx bega
02:E43C FFBE40          	   741:             stx tw                      ; temp beginning address
02:E43F B6BE05          	   742: pun11:      ldaa enda+1
02:E442 B0BE41          	   743:             suba tw+1
02:E445 F6BE04          	   744:             ldab enda
02:E448 F2BE40          	   745:             sbcb tw
02:E44B 2604            	   746:             bne pun22
02:E44D 8110            	   747:             cmpa #16
02:E44F 2502            	   748:             bcs pun23
02:E451 860F            	   749: pun22:      ldaa #15
02:E453 8B04            	   750: pun23:      adda #4
02:E455 B7BE3D          	   751:             staa mcont                  ; frame count this record
02:E458 8003            	   752:             suba #3
02:E45A B7BE3C          	   753:             staa temp                   ; byte count this record
                        	   754: ; punch c/r,l/f,nulls,s,1 
02:E45D CEE41F          	   755:             ldx #mtape1
02:E460 BDE179          	   756:             jsr pdata1
02:E463 5F              	   757:             clrb                        ; zero checksum
                        	   758: ; punch frame count 
02:E464 CEBE3D          	   759:             ldx #mcont
02:E467 8D2E            	   760:             bsr punt2                   ; punch 2 hex char
                        	   761: ; punch address 
02:E469 CEBE40          	   762:             ldx #tw
02:E46C 8D29            	   763:             bsr punt2
02:E46E 8D27            	   764:             bsr punt2
                        	   765: ; punch data 
02:E470 FEBE40          	   766:             ldx tw
02:E473 8D22            	   767: pun32:      bsr punt2                   ; punch one byte (2 frames)
02:E475 7ABE3C          	   768:             dec temp                    ; dec byte count
02:E478 26F9            	   769:             bne pun32
02:E47A FFBE40          	   770:             stx tw
02:E47D 53              	   771:             comb
02:E47E 37              	   772:             pshb
02:E47F 30              	   773:             tsx
02:E480 8D15            	   774:             bsr punt2                   ; punch checksum
02:E482 33              	   775:             pulb                        ; restore stack
02:E483 FEBE40          	   776:             ldx tw
02:E486 09              	   777:             dex
02:E487 BCBE04          	   778:             cpx enda
02:E48A 26B3            	   779:             bne pun11
02:E48C BDE199          	   780:             jsr pcrlf
02:E48F CEE59C          	   781:             ldx #meof
02:E492 BDE179          	   782:             jsr pdata1                  ; output eof
02:E495 2037            	   783:             bra ctrl                    ; branch to contrl
                        	   784: 
                        	   785: ; punch 2 hex char, update checksum 
02:E497 EB00            	   786: punt2:      addb 0,x                    ; update checksum
02:E499 7EE1BA          	   787:             jmp out2h                   ; output two hex chars and rts
                        	   788: ; 
                        	   789: ; swi-1 software interrupt level 1 processing 
                        	   790: ; 
                        	   791: swi15:
02:E49C BFBE08          	   792:             sts sp                      ; save user's sp
02:E49F 8601            	   793:             ldaa #1
02:E4A1 B7BE45          	   794:             staa resume_valid
                        	   795: ; 
02:E4A4 8603            	   796:             ldaa #3
02:E4A6 BDE390          	   797:             jsr brksub                  ; go take out all the breaks
                        	   798: ; 
                        	   799: ; decrement p-counter 
                        	   800: ; 
02:E4A9 30              	   801:             tsx                         ; x:=stack pointer - 1
02:E4AA 6D06            	   802:             tst 6,x                     ; if lower byte = 0 => borrow
02:E4AC 2602            	   803:             bne swi151                  ; branch if borrow not req'd
02:E4AE 6A05            	   804:             dec 5,x                     ; decrement upper byte
02:E4B0 6A06            	   805: swi151:     dec 6,x                     ; decrement lower byte
                        	   806: ; 
                        	   807: ; test for address trace or break 
                        	   808: ; 
02:E4B2 EE05            	   809:             ldx 5,x                     ; x:=p counter
02:E4B4 BCBE17          	   810:             cpx trcadr                  ; is swi for trace?
02:E4B7 2718            	   811:             beq trcinh                  ; yes, go to trace int handler
                        	   812: ; 
02:E4B9 A600            	   813:             ldaa 0,x                    ; get instruction causing swi
02:E4BB 813F            	   814:             cmpa #swiop                 ; was it replaced by call to break
02:E4BD 260C            	   815:             bne brkinh                  ; yes, so must be a break
                        	   816: ; 
                        	   817: ; user swi-transfer through level 2 swi 
                        	   818: ; 
02:E4BF 30              	   819:             tsx                         ; x:=stack pointer
02:E4C0 6C06            	   820:             inc 6,x                     ; update low byte of p-counter
02:E4C2 2602            	   821:             bne incnov                  ; branch if no carry
02:E4C4 6C05            	   822:             inc 5,x                     ; update high byte if necessary
02:E4C6 FEBE0C          	   823: incnov:     ldx swi2                    ; x:=pointer to level 2 swi handler
02:E4C9 6E00            	   824:             jmp 0,x                     ; go to level 2 handler
                        	   825: ; 
                        	   826: ; 
                        	   827: ; 
                        	   828: ; 
                        	   829: ; break interrupt handler 
                        	   830: ; 
                        	   831: brkinh:
02:E4CB BDE408          	   832:             jsr print                   ; stop and show regs to user
02:E4CE 7EE2BB          	   833: ctrl:       jmp contrl                  ; return to control loop
                        	   834: ; 
                        	   835: ; trace interrupt handler 
                        	   836: ; p-counter has been decremented to point at swi 
                        	   837: ; trcins holds op code replaced by swi 
                        	   838: ; x hold address where trace swi is 
                        	   839: ; 
02:E4D1 B6BE19          	   840: trcinh:     ldaa trcins                 ; get op code of traced instr
02:E4D4 A700            	   841:             staa 0,x                    ; restore to user's code
                        	   842: ; 
02:E4D6 7DBE43          	   843:             tst brktrc                  ; is processing to be
                        	   844: ; immediately continued? 
02:E4D9 270F            	   845:             beq nbktrc                  ; branch if not
                        	   846: ; 
                        	   847: ; processing is to 'CONTINUE' 
                        	   848: ; 
02:E4DB 7FBE43          	   849:             clr brktrc                  ; reset continue flag
02:E4DE 86FF            	   850:             ldaa #0xff                  ; flag to set breaks in code
02:E4E0 BDE390          	   851:             jsr brksub                  ; put breaks in
02:E4E3 7FBE17          	   852:             clr trcadr                  ; no more trace, so clear address
02:E4E6 7FBE18          	   853:             clr trcadr+1
02:E4E9 3B              	   854:             rti                         ; continue
                        	   855: ; 
                        	   856: ; trace is due to n or t trace commands 
                        	   857: ; 
02:E4EA BDE408          	   858: nbktrc:     jsr print                   ; print stack
02:E4ED FEBE1A          	   859:             ldx ntrace                  ; get # instructions to trace
02:E4F0 09              	   860:             dex                         ; decrement count
02:E4F1 FFBE1A          	   861:             stx ntrace                  ; and restore
02:E4F4 27D8            	   862:             beq ctrl                    ; branch if all traces done
                        	   863: ; 
                        	   864: ; trace not done - trace next instruction 
                        	   865: ; 
02:E4F6 B6BE19          	   866: contrc:     ldaa trcins                 ; get current instruction
02:E4F9 B7BE0E          	   867:             staa brins                  ; save in case it's a branch
02:E4FC 8D70            	   868:             bsr opcbyt                  ; go get # bytes"type
02:E4FE 4D              	   869:             tsta                        ; check for branch
02:E4FF 2A35            	   870:             bpl ckobra                  ; check for other than branch
                        	   871: ; 
                        	   872: ; relative branch type instruction 
                        	   873: ; determine where to put swi 
                        	   874: ; s- holds pointer to user stack after swi 
02:E501 32              	   875:             pula                        ; get condition code
02:E502 34              	   876:             des                         ; update stack pointer after pull
02:E503 8A10            	   877:             oraa #0b00010000            ; make int's inhibited
02:E505 06              	   878:             tap                         ; restore user's c. code reg
02:E506 7EBE0E          	   879:             jmp brins                   ; go see how relative branch
                        	   880: ; fares 
                        	   881: ; 
                        	   882: ; branch was nogo - put swi at next instruction 
                        	   883: ; 
02:E509 8602            	   884: brnogo:     ldaa #2                     ; a = # bytes after current instr
02:E50B 2029            	   885:             bra ckobra                  ; go put swi appropriately
                        	   886: ; 
                        	   887: ; branch was go, put swi at address being 
                        	   888: ; jumped to 
                        	   889: ; 
02:E50D FEBE17          	   890: brgo:       ldx trcadr                  ; x : = trace address
02:E510 A601            	   891:             ldaa 1,x                    ; get branch offset
02:E512 08              	   892:             inx                         ; offset is relative to
02:E513 08              	   893:             inx                         ; instr following branch
02:E514 2B12            	   894:             bmi brgodc                  ; branch if offset negative
02:E516 8D16            	   895: brg1:       bsr incx_                   ; increment x by amount in
                        	   896: ; a reg 
02:E518 FFBE17          	   897: brg2:       stx trcadr                  ; save address of next
                        	   898: ; instr to stop on 
02:E51B A600            	   899:             ldaa 0,x                    ; get instruction to be replaced
02:E51D B7BE19          	   900:             staa trcins                 ; save
02:E520 863F            	   901:             ldaa #swiop                 ; get swi op code
02:E522 A700            	   902:             staa 0,x                    ; replace instr with swi
02:E524 BEBE08          	   903:             lds sp                      ; get original stack pointer
02:E527 3B              	   904:             rti                         ; trace another instr
                        	   905: ; 
                        	   906: ; x needs to be decremented (offset negative) 
                        	   907: ; 
02:E528 09              	   908: brgodc:     dex                         ; decrement address
02:E529 4C              	   909:             inca                        ; increment counter
02:E52A 26FC            	   910:             bne brgodc                  ; if counter not 0, branch
02:E52C 20EA            	   911:             bra brg2                    ; if done, go return to user prog
                        	   912: ; 
                        	   913: ; subroutine to increment x by contents of a 
                        	   914: ; 
02:E52E 4D              	   915: incx_:      tsta                        ; is a = 0?
02:E52F 2704            	   916:             beq incxr                   ; if so, inc done
02:E531 08              	   917: inxlp:      inx                         ; else increment x
02:E532 4A              	   918:             deca                        ; decrement count
02:E533 26FC            	   919:             bne inxlp                   ; if count not yet 0, loop
02:E535 39              	   920: incxr:      rts                         ; return from this subroutine
                        	   921: ; 
                        	   922: ; instruction to be traced is not a branch 
                        	   923: ; 
02:E536 FEBE17          	   924: ckobra:     ldx trcadr                  ; x : = trace address
02:E539 E600            	   925:             ldab 0,x                    ; get instr to be traced
02:E53B C16E            	   926:             cmpb #0x6e                  ; is it a jump, indexed?
02:E53D 271A            	   927:             beq jmpidx                  ; yes, go simulate jump idxed
02:E53F C17E            	   928:             cmpb #0x7e                  ; jump, extended?
02:E541 271D            	   929:             beq jmpext
02:E543 C1AD            	   930:             cmpb #0xad                  ; jsr, indexed?
02:E545 2712            	   931:             beq jmpidx                  ; (jump idxed is same as
                        	   932: ; transfer of control) 
02:E547 C1BD            	   933:             cmpb #0xbd                  ; jsr, extended?
02:E549 2715            	   934:             beq jmpext
02:E54B C13B            	   935:             cmpb #0x3b                  ; rti?
02:E54D 2715            	   936:             beq rtisim
02:E54F C139            	   937:             cmpb #0x39                  ; rts?
02:E551 2716            	   938:             beq rtssim
02:E553 C18D            	   939:             cmpb #0x8d                  ; bsr?
02:E555 27B6            	   940:             beq brgo                    ; (branch processing)
                        	   941: ; 
                        	   942: ; not a branch, jump. rti, rts 
                        	   943: ; a register holds # bytes in instruction 
                        	   944: ; 
02:E557 20BD            	   945:             bra brg1                    ; put in new swi and
                        	   946: ; trace next instruction 
                        	   947: ; 
                        	   948: ; jump, jsr indexed simulation 
                        	   949: ; 
02:E559 A601            	   950: jmpidx:     ldaa 1,x                    ; a : = address offset
02:E55B 30              	   951:             tsx
02:E55C EE03            	   952:             ldx 3,x                     ; get targets x reg
02:E55E 20B6            	   953:             bra brg1                    ; update x, trace next instr
                        	   954: ; 
                        	   955: ; jump, jsr extended 
                        	   956: ; 
02:E560 EE01            	   957: jmpext:     ldx 1,x                     ; get address to be jumped to
02:E562 20B4            	   958:             bra brg2                    ; go trace next instr.
                        	   959: ; 
                        	   960: ; rti encountered 
                        	   961: ; 
02:E564 30              	   962: rtisim:     tsx
02:E565 EE0C            	   963:             ldx 12,x                    ; get p-counter from stack
02:E567 20AF            	   964:             bra brg2                    ; go trace next instr.
                        	   965: ; 
                        	   966: ; rts encountered 
                        	   967: ; 
02:E569 30              	   968: rtssim:     tsx
02:E56A EE07            	   969:             ldx 7,x                     ; get return p-reg from stack
02:E56C 20AA            	   970:             bra brg2                    ; go trace next instr
                        	   971: ; 
                        	   972: ; 
                        	   973: ; opbcyt 
                        	   974: ; 
                        	   975: ; this routine determines the # of bytes in an instruction 
                        	   976: ; given its op code. 
                        	   977: ; 
                        	   978: ; input: a holds the op code 
                        	   979: ; 
                        	   980: ; output: x holds the index of table element 
                        	   981: ; b not restored 
                        	   982: ; a holds # bytes in instruction 
                        	   983: ; except for branches in which case is negative 
                        	   984: ; 
                        	   985: ; 
                        	   986: ; 
                        	   987: opcbyt:
02:E56E 16              	   988:             tab                         ; b:= op code
02:E56F 44              	   989:             lsra
02:E570 44              	   990:             lsra
02:E571 44              	   991:             lsra                        ; put 4 upper bits of op code in
02:E572 44              	   992:             lsra                        ; lower 4 bits of a
                        	   993: ; 
02:E573 CEE58C          	   994:             ldx #opbttb                 ; x:= address of table
02:E576 8DB6            	   995:             bsr incx_                   ; increment x to point to correct
                        	   996: ; 
02:E578 A600            	   997:             ldaa 0,x                    ; get table entry
02:E57A 260F            	   998:             bne opbtrt                  ; if not 0 then no further
                        	   999: ; processing needed 
                        	  1000: ; 
                        	  1001: ; if top 4 bits = 8 or c, then there are two classes 
                        	  1002: ; of instructions: 2 byte instructions and 
                        	  1003: ; ce, 8c and 8e which are 3 byte instructions 
                        	  1004: ; 
02:E57C 8602            	  1005:             ldaa #2                     ; # bytes in most of 8# instructions
02:E57E C18C            	  1006:             cmpb #0x8c                  ; 3 byte instruction?
02:E580 2708            	  1007:             beq opbt3                   ; yes, update a
02:E582 C1CE            	  1008:             cmpb #0xce                  ; 3 byte instr?
02:E584 2704            	  1009:             beq opbt3                   ; yes, update a
02:E586 C18E            	  1010:             cmpb #0x8e                  ; 3 byte instruction?
02:E588 2601            	  1011:             bne opbtrt                  ; no, return
                        	  1012: ; 
02:E58A 4C              	  1013: opbt3:      inca                        ; # bytes in instruction:=3
                        	  1014: ; 
02:E58B 39              	  1015: opbtrt:     rts                         ; return to caller
                        	  1016: ; 
                        	  1017: ; op code to number of bytes conversion table 
                        	  1018: ; 
                        	  1019: ; # bytes top 4 bits of opcode 
