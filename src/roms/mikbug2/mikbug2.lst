01:E2F7 BFBE08          	   458: nmi_ready:  sts sp                      ; save stack
01:E2FA 8601            	   459:             ldaa #1
01:E2FC B7BE45          	   460:             staa resume_valid
01:E2FF BDE199          	   461:             jsr pcrlf
