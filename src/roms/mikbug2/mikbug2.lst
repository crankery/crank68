Source: "mikbug2.s"
                        	   113: 
                        	   114:             .equ acias, 0xe010 ; slot 1 ACIA I/O addresses
                        	   115:             .equ aciad, 0xe011
                        	   116: 
                        	   117:             .org 0xe100
                        	   118: baseorg:    
                        	   119: 
                        	   120: ; 
                        	   121: ; i/o interrupt sequence 
                        	   122: ; 
01:E100 FEBE00          	   123: io:         ldx iov
01:E103 6E00            	   124:             jmp 0,x
                        	   125: ; 
                        	   126: ; nmi sequence 
                        	   127: ; 
01:E105 7EE2EC          	   128: powdwn:     jmp nmi                     ; fixed NMI target survives FLEX RAM use
                        	   129: ; 
                        	   130: ; swi interrupt sequence 
                        	   131: ; 
01:E108 FEBE0A          	   132: sfei:       ldx swi1
01:E10B 6E00            	   133:             jmp 0,x
                        	   134: ; 
                        	   135: ; jump table to routines performing mikbug fctn's 
                        	   136: ; 
                        	   137: fctabl:
01:E10D 42              	   138:             .byte "B"                   ; "B" - print all breaks
01:E10E E328            	   139:             .word pntbrk
01:E110 43              	   140:             .byte "C"                   ; "C" - continue
01:E111 E37A            	   141:             .word cont
01:E113 44              	   142:             .byte "D"                   ; "D" - delete all breaks
01:E114 E31D            	   143:             .word delbrk
01:E116 47              	   144:             .byte "G"                   ; "G" - go to entered address
01:E117 E337            	   145:             .word goto
01:E119 4C              	   146:             .byte "L"                   ; "L" - load
01:E11A E1CB            	   147:             .word load
01:E11C 4D              	   148:             .byte "M"                   ; "M" - memory change
01:E11D E218            	   149:             .word change
01:E11F 4E              	   150:             .byte "N"                   ; "N" - next (trace 1 instr)
01:E120 E349            	   151:             .word next
01:E122 50              	   152:             .byte "P"                   ; "P" - punch
01:E123 E428            	   153:             .word punch
01:E125 52              	   154:             .byte "R"                   ; "R" - print stack
01:E126 E382            	   155:             .word pstak1
01:E128 53              	   156:             .byte "S"                   ; "S" - change speed for tty
01:E129 E310            	   157:             .word spd
01:E12B 54              	   158:             .byte "T"                   ; "T" - trace n instructions
01:E12C E376            	   159:             .word trace
01:E12E 55              	   160:             .byte "U"                   ; "U" - reset a breakpoint
01:E12F E323            	   161:             .word rstbrk
01:E131 56              	   162:             .byte "V"                   ; "V" - set a breakpoint
01:E132 E32F            	   163:             .word setbrk
                        	   164: fctben:
                        	   165: ; 
                        	   166: ; initialization/reset code 
                        	   167: ; 
                        	   168: adrstr:
01:E134 BCFF            	   169:             .word stack                 ; init for "SP"
01:E136 E49C            	   170:             .word swi15                 ; init for "SWI1"
01:E138 E4CB            	   171:             .word brkinh                ; init for "SWI2"
                        	   172: ; 
01:E13A 2003            	   173:             bra brg                     ; "BRA" inst is replaced by
01:E13C 7EE509          	   174:             jmp brnogo                  ; cond bra inst in rout.
01:E13F 7EE50D          	   175: brg:        jmp brgo                    ; which determines if
                        	   176: ; bra is go/nogo 
                        	   177: ; 
                        	   178: ; build address 
                        	   179: ; 
01:E142 8D0C            	   180: baddr:      bsr byte                    ; read 2 frames
01:E144 B7BE3E          	   181:             staa xhi
01:E147 8D07            	   182:             bsr byte
01:E149 B7BE3F          	   183:             staa xlow
01:E14C FEBE3E          	   184:             ldx xhi                     ; (x) address we built
01:E14F 39              	   185:             rts
                        	   186: ; input byte (two frames) 
01:E150 8D53            	   187: byte:       bsr inhex                   ; get hex char
01:E152 48              	   188: byte2:      asla
01:E153 48              	   189:             asla
01:E154 48              	   190:             asla
01:E155 48              	   191:             asla
01:E156 16              	   192:             tab
01:E157 8D4C            	   193:             bsr inhex
01:E159 1B              	   194:             aba
01:E15A 16              	   195:             tab
01:E15B FBBE3C          	   196:             addb cksm
01:E15E F7BE3C          	   197:             stab cksm
01:E161 39              	   198:             rts
01:E162 44              	   199: outhl:      lsra                        ; out hex left bcd digit
01:E163 44              	   200:             lsra
01:E164 44              	   201:             lsra
01:E165 44              	   202:             lsra
01:E166 840F            	   203: outhr:      anda #0xf                   ; out hex right bcd digit
01:E168 8B30            	   204:             adda #0x30
01:E16A 8139            	   205:             cmpa #0x39
01:E16C 2302            	   206:             bls outch
01:E16E 8B07            	   207:             adda #0x7
                        	   208: ; output one char 
01:E170 7EE254          	   209: outch:      jmp outch1
01:E173 7EE261          	   210: inch:       jmp inch1
                        	   211: ; print data pointed at by x-reg 
01:E176 8DF8            	   212: pdata2:     bsr outch
01:E178 08              	   213:             inx
01:E179 A600            	   214: pdata1:     ldaa 0,x
01:E17B 8104            	   215:             cmpa #4
01:E17D 26F7            	   216:             bne pdata2
01:E17F 39              	   217:             rts                         ; stop on eot
                        	   218: ; 
                        	   219: ; input address 
                        	   220: ; 
01:E180 8D17            	   221: getadd:     bsr pcrlf                   ; print cr lf
01:E182 CEE5D2          	   222:             ldx #mcl4
01:E185 8DF2            	   223:             bsr pdata1                  ; ask for begaddr
01:E187 8DB9            	   224:             bsr baddr                   ; get beg addr
01:E189 FFBE02          	   225:             stx bega
01:E18C 8D0B            	   226:             bsr pcrlf                   ; print cr lf
01:E18E CEE5DD          	   227:             ldx #mcl5
01:E191 8DE6            	   228:             bsr pdata1                  ; ask for end addr
01:E193 8DAD            	   229:             bsr baddr                   ; get end address
01:E195 FFBE04          	   230:             stx enda
01:E198 39              	   231:             rts                         ; *
                        	   232: ; print cr lf 
                        	   233: ; 
01:E199 FFBE3E          	   234: pcrlf:      stx xhi                     ; save xr
01:E19C CEE5B1          	   235:             ldx #mcl1
01:E19F 8DD8            	   236:             bsr pdata1                  ; print crlf
01:E1A1 FEBE3E          	   237:             ldx xhi
01:E1A4 39              	   238:             rts
                        	   239: 
                        	   240: ; 
01:E1A5 8DCC            	   241: inhex:      bsr inch
01:E1A7 8030            	   242: inhex2:     suba #0x30
01:E1A9 2B6A            	   243:             bmi c1                      ; not hex
01:E1AB 8109            	   244:             cmpa #0x09
01:E1AD 2F0A            	   245:             ble in1hg
01:E1AF 8111            	   246:             cmpa #0x11
01:E1B1 2B62            	   247:             bmi c1                      ; not hex
01:E1B3 8116            	   248:             cmpa #0x16
01:E1B5 2E5E            	   249:             bgt c1                      ; not hex
01:E1B7 8007            	   250:             suba #7
01:E1B9 39              	   251: in1hg:      rts
                        	   252: ; 
01:E1BA A600            	   253: out2h:      ldaa 0,x                    ; output 2 hex char
01:E1BC 8DA4            	   254: out2ha:     bsr outhl                   ; out left hex char
01:E1BE A600            	   255:             ldaa 0,x                    ; pick up byte again
01:E1C0 08              	   256:             inx
01:E1C1 20A3            	   257:             bra outhr                   ; output right hex char and rts
01:E1C3 8DF5            	   258: out4hs:     bsr out2h                   ; output 4 hex char + space
01:E1C5 8DF3            	   259: out2hs:     bsr out2h                   ; output 2 hex char + space
01:E1C7 8620            	   260: outs:       ldaa #0x20                  ; space
01:E1C9 20A5            	   261:             bra outch                   ; (bsr & rts)
                        	   262: load:
01:E1CB 8611            	   263:             ldaa #021
01:E1CD 8DA1            	   264:             bsr outch                   ; output char
                        	   265: ; 
                        	   266: ; turn reader relay on 
                        	   267: ; 
01:E1CF B6BE44          	   268:             ldaa aciat                  ; get acia control reg format
01:E1D2 8A40            	   269:             oraa #0x40                  ; set rts to turn rdr relay on
01:E1D4 B7E010          	   270:             staa acias                  ; turn it on
                        	   271: ; 
01:E1D7 7CBE16          	   272:             inc outsw                   ; do not echo tape
                        	   273: ; 
01:E1DA 8D97            	   274: load3:      bsr inch
01:E1DC 2003            	   275:             bra load4
01:E1DE 7EE2A2          	   276: enter:      jmp ent1                    ; mikbug 1 entry point
                        	   277: load4:
01:E1E1 8153            	   278:             cmpa #'S'
01:E1E3 26F5            	   279:             bne load3                   ; 1st char not (s)
01:E1E5 8D8C            	   280:             bsr inch                    ; read char
01:E1E7 8139            	   281:             cmpa #'9'
01:E1E9 272A            	   282:             beq c1
01:E1EB 8131            	   283:             cmpa #'1'
01:E1ED 26EB            	   284:             bne load3                   ; 2nd char not (1)
01:E1EF 7FBE3C          	   285:             clr cksm                    ; zero checksum
01:E1F2 BDE150          	   286:             jsr byte                    ; read byte
01:E1F5 8002            	   287:             suba #2
01:E1F7 B7BE3D          	   288:             staa bytect                 ; byte count
                        	   289: ; build address 
01:E1FA BDE142          	   290:             jsr baddr
                        	   291: ; store data 
01:E1FD BDE150          	   292: load11:     jsr byte
01:E200 7ABE3D          	   293:             dec bytect
01:E203 2709            	   294:             beq load15                  ; zero byte count
01:E205 A700            	   295:             staa 0,x                    ; store data
01:E207 A100            	   296:             cmpa 0,x                    ; check data
01:E209 2606            	   297:             bne load19                  ; data not stored
01:E20B 08              	   298:             inx
01:E20C 20EF            	   299:             bra load11
                        	   300: ; 
                        	   301: ; does checksum check? 
                        	   302: ; 
01:E20E 5C              	   303: load15:     incb
01:E20F 27C9            	   304:             beq load3
01:E211 863F            	   305: load19:     ldaa #'?'                   ;  print question mark
01:E213 8D3F            	   306:             bsr outch1
01:E215 7EE2BB          	   307: c1:         jmp contrl
                        	   308: ; 
                        	   309: ; change memory (m aaaa dd nn) 
                        	   310: ; 
01:E218 BDE142          	   311: change:     jsr baddr                   ; build address
01:E21B 8DAA            	   312:             bsr outs                    ; output space
01:E21D FEBE3E          	   313: chang:      ldx xhi
01:E220 8DA3            	   314:             bsr out2hs                  ; print data old
01:E222 09              	   315:             dex
01:E223 8D3C            	   316: cha1:       bsr inch1                   ; input char
01:E225 810A            	   317:             cmpa #0x0a
01:E227 2712            	   318:             beq lf                      ; check for line feed
01:E229 815E            	   319:             cmpa #0x5e
01:E22B 2711            	   320:             beq ua                      ; check for ^
01:E22D BDE1A7          	   321:             jsr inhex2                  ; s bsr byte
01:E230 BDE152          	   322:             jsr byte2                   ; get new byte
01:E233 A700            	   323:             staa 0,x                    ; change memory
01:E235 A100            	   324:             cmpa 0,x
01:E237 26D8            	   325:             bne load19                  ; no change
01:E239 20E8            	   326:             bra cha1
01:E23B 08              	   327: lf:         inx                         ; inc addr
01:E23C 2005            	   328:             bra ua1
01:E23E 860A            	   329: ua:         ldaa #0x0a
01:E240 8D12            	   330:             bsr outch1                  ; output lf
01:E242 09              	   331:             dex                         ; dec addr
01:E243 FFBE3E          	   332: ua1:        stx xhi                     ; sav data addr
01:E246 CEE5A9          	   333:             ldx #mcl+1
01:E249 BDE179          	   334:             jsr pdata1                  ; print cr
01:E24C CEBE3E          	   335:             ldx #xhi
01:E24F BDE1C3          	   336:             jsr out4hs                  ; output data addr
01:E252 20C9            	   337:             bra chang
                        	   338: ; 
01:E254 37              	   339: outch1:     pshb                        ; save breg
01:E255 F6E010          	   340: outc1:      ldab acias
01:E258 57              	   341:             asrb
01:E259 57              	   342:             asrb
01:E25A 24F9            	   343:             bcc outc1                   ; xmit not ready
01:E25C B7E011          	   344:             staa aciad                  ; output char
01:E25F 33              	   345:             pulb
01:E260 39              	   346:             rts
                        	   347: ; 
                        	   348: ; input one char to areg 
01:E261 B6E010          	   349: inch1:      ldaa acias
01:E264 47              	   350:             asra
01:E265 24FA            	   351:             bcc inch1                   ; receiver not ready
01:E267 B6E011          	   352:             ldaa aciad                  ; input char
01:E26A 847F            	   353:             anda #0x7f                  ; reset parity bit
01:E26C 817F            	   354:             cmpa #0x7f
01:E26E 27F1            	   355:             beq inch1                   ; rubout"del
01:E270 7DBE16          	   356:             tst outsw                   ; should input be echoed?
01:E273 27DF            	   357:             beq outch1                  ; if so, output the char
01:E275 39              	   358:             rts                         ; else,return to caller of inch1
                        	   359: 
                        	   360: ; 
                        	   361: ; constant initialization 
                        	   362: ; s = pointer to rom bytes to be copied to ram 
                        	   363: ; x = pointer to ram bytes to be initialized 
                        	   364: ; 
                        	   365: start:                                  ; actual code start
01:E276 8EE133          	   366:             lds #adrstr-1               ; start of constant data
01:E279 CEBE08          	   367:             ldx #sp                     ; start of ram area
                        	   368: ; 
01:E27C 32              	   369: inilp1:     pula                        ; get next constant byte
01:E27D A700            	   370:             staa 0,x                    ; init next ram byte
01:E27F 08              	   371:             inx                         ; update pointer
01:E280 8CBE16          	   372:             cpx #branen                 ; end of constant ram area?
01:E283 26F7            	   373:             bne inilp1                  ; no, continue initialization
                        	   374: ; 
                        	   375: ; initialization to 0 
                        	   376: ; x holds index of 1st byte to be set to 0 
                        	   377: ; 
01:E285 6F00            	   378: inilp2:     clr 0,x                     ; clear next byte of ram
01:E287 08              	   379:             inx                         ; update index
01:E288 8CBE44          	   380:             cpx #endin0                 ; any more bytes to init?
01:E28B 26F8            	   381:             bne inilp2                  ; no, continue clearing
