Source: "mikbug2.s"
                        	     1: ; vasm buildable hack
                        	     2: ; dave hamilton, 2026
                        	     3: ; 
                        	     4: ; this was originally generated from the copy of mikbug2.asm and the translate.py script in the tools directory
                        	     5: ; gettig the variable address equates properly setup was a bit too much to bother trying to automate.
                        	     6: ; 
                        	     7: ; i claim no ownership of this file and if the rightful owners object to my posting it I will remove it.
                        	     8: 
                        	     9: ; anyway, this builds on vasm6800_std, no vlink required
                        	    10: ; it should be possible to move the main binary. i removed all the hard coded addresses (there were two of them)
                        	    11: ; you might want to change baseorg, RAM_PTR and stack the io area (currently 0xE000-0xE0FF)
                        	    12: ; for your M6800 machine :) haha
                        	    13: ; - dave
                        	    14: 
                        	    15: ; converted to an assembly file from a crappy pdf by 
                        	    16: ; members of the motorola 6809 / 6309, 6800 assembly 
                        	    17: ; language programming facebook group 
                        	    18: ; by craig jones,ray bellis 
                        	    19: ; 
                        	    20: 
                        	    21: 
                        	    22: ; 
                        	    23: ; 
                        	    24: ; ram - locations devoted to variable information 
                        	    25: ; 
                        	    26: ; 
                        	    27: 
                        	    28:     .equ RAM_PTR, 0xBE00
                        	    29: 
                        	    30: .macro ALLOC name, size
                        	    31:     .equ \name, RAM_PTR
                        	    32:     .equ RAM_PTR, RAM_PTR + \size
                        	    33: .endm
                        	    34: 
                        	    35:     .equ nbrbpt, 8
                        	    36: 
                        	    37: ; initialized from rom at start
                        	    38:     ALLOC iov, 2
                        	     1M     .equ iov, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    39:     ALLOC bega, 2
                        	     1M     .equ bega, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    40:     ALLOC enda, 2
                        	     1M     .equ enda, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    41:     ALLOC nio, 2
                        	     1M     .equ nio, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    42:     ALLOC sp, 2
                        	     1M     .equ sp, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    43:     ALLOC swi1, 2
                        	     1M     .equ swi1, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    44:     ALLOC swi2, 2
                        	     1M     .equ swi2, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    45:     ALLOC brins, 8
                        	     1M     .equ brins, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 8
                        	    46:     .equ branen, RAM_PTR
                        	    47: 
                        	    48: ; initialized to zero at start
                        	    49:     ALLOC outsw, 1
                        	     1M     .equ outsw, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    50:     ALLOC trcadr, 2
                        	     1M     .equ trcadr, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    51:     ALLOC trcins, 1
                        	     1M     .equ trcins, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    52:     ALLOC ntrace, 2
                        	     1M     .equ ntrace, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    53: 
                        	    54:     ALLOC brkadr, nbrbpt*2
                        	     1M     .equ brkadr, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + nbrbpt*2
                        	    55:     ALLOC brkins, nbrbpt*2
                        	     1M     .equ brkins, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + nbrbpt*2
                        	    56: 
                        	    57:     ALLOC cksm, 1
                        	     1M     .equ cksm, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    58:     .equ asave, cksm
                        	    59:     .equ temp, cksm
                        	    60: 
                        	    61:     ALLOC bytect, 1
                        	     1M     .equ bytect, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    62:     .equ mcont, bytect
                        	    63: 
                        	    64:     ALLOC xhi, 1
                        	     1M     .equ xhi, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    65:     ALLOC xlow, 1
                        	     1M     .equ xlow, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    66: 
                        	    67:     ALLOC ssave, 2
                        	     1M     .equ ssave, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    68:     .equ tw, ssave
                        	    69: 
                        	    70:     ALLOC brksin, 1
                        	     1M     .equ brksin, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    71:     ALLOC brktrc, 1
                        	     1M     .equ brktrc, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    72: 
                        	    73:     .equ endin0, RAM_PTR
                        	    74:     ALLOC aciat, 1
                        	     1M     .equ aciat, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    75:     ALLOC resume_valid, 1
                        	     1M     .equ resume_valid, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    76: 
                        	    77: ; stack is at 0x100
                        	    78: 
                        	    79:     .equ stackpage, 0xBC00
                        	    80:     .equ stack, stackpage + 0xff
                        	    81: 
                        	    82: ; nam mikbug 
                        	    83: ; ttl 2.0 monitor
                        	    84: ; rev 0 
                        	    85: ; copyright (c) 1977 by motorola inc. 
                        	    86: ; 
                        	    87: ; mikbug (tm) motorola 
                        	    88: ; 
                        	    89: ; austin, texas 
                        	    90: ; microcomputer capital of the world! 
                        	    91: ; 
                        	    92: ; l load 
                        	    93: ; m memory change 
                        	    94: ; p print/punch dump 
                        	    95: ; r display contents of target stack 
                        	    96: ; cc b a x p s 
                        	    97: ; s 1,set speed for 10 cps 
                        	    98: ; 3,set speed for 30 cps 
                        	    99: ; b print out all breakpoints 
                        	   100: ; c continue execution from current location 
                        	   101: ; n next instruction 
                        	   102: ; t trace 'N' instructions 
                        	   103: ; f boot FLEX 2 from banked SRAM (cold handoff)
                        	   104: ; g go to location 'N' 
                        	   105: ; d delete all breakpoints 
                        	   106: ; u reset breakpoint with address 'N' 
                        	   107: ; v set a breakpoint with address 'N' 
                        	   108: ; 
                        	   109:             .equ swiop, 0x3f            ; swi op code
                        	   110: 
                        	   111:             .org 0xe000 ; slot 0
                        	   112: 
                        	   113:             .org 0xe010 ; slot 1
01:E010 00              	   114: acias:      .space 0x01
01:E011 00              	   115: aciad:      .space 0x01
                        	   116: 
                        	   117:             .org 0xe100
                        	   118: baseorg:    
                        	   119: 
                        	   120: ; 
                        	   121: ; i/o interrupt sequence 
                        	   122: ; 
02:E100 FEBE00          	   123: io:         ldx iov
02:E103 6E00            	   124:             jmp 0,x
                        	   125: ; 
                        	   126: ; nmi sequence 
                        	   127: ; 
02:E105 7EE2EC          	   128: powdwn:     jmp nmi                     ; fixed NMI target survives FLEX RAM use
                        	   129: ; 
                        	   130: ; swi interrupt sequence 
                        	   131: ; 
02:E108 FEBE0A          	   132: sfei:       ldx swi1
02:E10B 6E00            	   133:             jmp 0,x
                        	   134: ; 
                        	   135: ; jump table to routines performing mikbug fctn's 
                        	   136: ; 
                        	   137: fctabl:
02:E10D 42              	   138:             .byte "B"                   ; "B" - print all breaks
02:E10E E328            	   139:             .word pntbrk
02:E110 43              	   140:             .byte "C"                   ; "C" - continue
02:E111 E37A            	   141:             .word cont
02:E113 44              	   142:             .byte "D"                   ; "D" - delete all breaks
02:E114 E31D            	   143:             .word delbrk
02:E116 47              	   144:             .byte "G"                   ; "G" - go to entered address
02:E117 E337            	   145:             .word goto
02:E119 4C              	   146:             .byte "L"                   ; "L" - load
02:E11A E1CB            	   147:             .word load
02:E11C 4D              	   148:             .byte "M"                   ; "M" - memory change
02:E11D E218            	   149:             .word change
02:E11F 4E              	   150:             .byte "N"                   ; "N" - next (trace 1 instr)
02:E120 E349            	   151:             .word next
02:E122 50              	   152:             .byte "P"                   ; "P" - punch
02:E123 E428            	   153:             .word punch
02:E125 52              	   154:             .byte "R"                   ; "R" - print stack
02:E126 E382            	   155:             .word pstak1
02:E128 53              	   156:             .byte "S"                   ; "S" - change speed for tty
02:E129 E310            	   157:             .word spd
02:E12B 54              	   158:             .byte "T"                   ; "T" - trace n instructions
02:E12C E376            	   159:             .word trace
02:E12E 55              	   160:             .byte "U"                   ; "U" - reset a breakpoint
02:E12F E323            	   161:             .word rstbrk
02:E131 56              	   162:             .byte "V"                   ; "V" - set a breakpoint
02:E132 E32F            	   163:             .word setbrk
                        	   164: fctben:
                        	   165: ; 
                        	   166: ; initialization/reset code 
                        	   167: ; 
                        	   168: adrstr:
02:E134 BCFF            	   169:             .word stack                 ; init for "SP"
02:E136 E49C            	   170:             .word swi15                 ; init for "SWI1"
02:E138 E4CB            	   171:             .word brkinh                ; init for "SWI2"
                        	   172: ; 
02:E13A 2003            	   173:             bra brg                     ; "BRA" inst is replaced by
02:E13C 7EE509          	   174:             jmp brnogo                  ; cond bra inst in rout.
02:E13F 7EE50D          	   175: brg:        jmp brgo                    ; which determines if
                        	   176: ; bra is go/nogo 
                        	   177: ; 
                        	   178: ; build address 
                        	   179: ; 
02:E142 8D0C            	   180: baddr:      bsr byte                    ; read 2 frames
02:E144 B7BE3E          	   181:             staa xhi
02:E147 8D07            	   182:             bsr byte
02:E149 B7BE3F          	   183:             staa xlow
02:E14C FEBE3E          	   184:             ldx xhi                     ; (x) address we built
02:E14F 39              	   185:             rts
                        	   186: ; input byte (two frames) 
02:E150 8D53            	   187: byte:       bsr inhex                   ; get hex char
02:E152 48              	   188: byte2:      asla
02:E153 48              	   189:             asla
02:E154 48              	   190:             asla
02:E155 48              	   191:             asla
02:E156 16              	   192:             tab
02:E157 8D4C            	   193:             bsr inhex
02:E159 1B              	   194:             aba
02:E15A 16              	   195:             tab
02:E15B FBBE3C          	   196:             addb cksm
02:E15E F7BE3C          	   197:             stab cksm
02:E161 39              	   198:             rts
02:E162 44              	   199: outhl:      lsra                        ; out hex left bcd digit
02:E163 44              	   200:             lsra
02:E164 44              	   201:             lsra
02:E165 44              	   202:             lsra
02:E166 840F            	   203: outhr:      anda #0xf                   ; out hex right bcd digit
02:E168 8B30            	   204:             adda #0x30
02:E16A 8139            	   205:             cmpa #0x39
02:E16C 2302            	   206:             bls outch
02:E16E 8B07            	   207:             adda #0x7
                        	   208: ; output one char 
02:E170 7EE254          	   209: outch:      jmp outch1
02:E173 7EE261          	   210: inch:       jmp inch1
                        	   211: ; print data pointed at by x-reg 
02:E176 8DF8            	   212: pdata2:     bsr outch
02:E178 08              	   213:             inx
02:E179 A600            	   214: pdata1:     ldaa 0,x
02:E17B 8104            	   215:             cmpa #4
02:E17D 26F7            	   216:             bne pdata2
02:E17F 39              	   217:             rts                         ; stop on eot
                        	   218: ; 
                        	   219: ; input address 
                        	   220: ; 
02:E180 8D17            	   221: getadd:     bsr pcrlf                   ; print cr lf
02:E182 CEE5D0          	   222:             ldx #mcl4
02:E185 8DF2            	   223:             bsr pdata1                  ; ask for begaddr
02:E187 8DB9            	   224:             bsr baddr                   ; get beg addr
02:E189 FFBE02          	   225:             stx bega
02:E18C 8D0B            	   226:             bsr pcrlf                   ; print cr lf
02:E18E CEE5DB          	   227:             ldx #mcl5
02:E191 8DE6            	   228:             bsr pdata1                  ; ask for end addr
02:E193 8DAD            	   229:             bsr baddr                   ; get end address
02:E195 FFBE04          	   230:             stx enda
02:E198 39              	   231:             rts                         ; *
                        	   232: ; print cr lf 
                        	   233: ; 
02:E199 FFBE3E          	   234: pcrlf:      stx xhi                     ; save xr
02:E19C CEE5B1          	   235:             ldx #mcl1
02:E19F 8DD8            	   236:             bsr pdata1                  ; print crlf
02:E1A1 FEBE3E          	   237:             ldx xhi
02:E1A4 39              	   238:             rts
                        	   239: 
