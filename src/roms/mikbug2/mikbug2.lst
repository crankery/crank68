                        	  1084: ; Shared SD transport at fixed ROM addresses.
                        	  1085:             .include "sdcard.s"

Source: "sdcard.s"
                        	     1: ; SD bridge transport, fixed ROM API for FLEX and future boot loaders.
                        	     2: ; A=track, B=sector, X=256-byte buffer for READ/WRITE.
                        	     3: ; READY checks protocol/geometry/mount, preserving X. INIT configures the PIA.
                        	     4: ; Return B=0/Z=1/C=0, or B!=0/Z=0/C=1. Not reentrant.
                        	     5: ; Scratch $9B00..$9B11 is reserved above FLEX's $7FFF application limit.
                        	     6: ; Set SD_CPU_MHZ to the host clock (1..4) to scale timeout/settling loops.
                        	     7: ; Bench timing is still required.
                        	     8:     .equ SD_CPU_MHZ, 1
                        	     9:     .equ SDPA, 0xE020
                        	    10:     .equ SDCRA, 0xE021
                        	    11:     .equ SDPB, 0xE022
                        	    12:     .equ SDCRB, 0xE023
                        	    13:     .org 0xF000
