01:E2CF 16              	   429:             tab                         ; save character in b
01:E2D0 2002            	   430:             bra cnta                    ; skip over mikbug 1.0 vector
01:E2D2 2080            	   431: out2:       bra outch1                  ; mikbug 1.0 " output 1 char routine
01:E2D4 BDE1C7          	   432: cnta:       jsr outs                    ; print space after command
                        	   433: ; 
                        	   434: ; b register holds character input by user 
                        	   435: ; use jump table to go to appropriate routine. 
                        	   436: ; 
01:E2D7 7EFF80          	   437:             jmp flexdispatch            ; handle F, then original command table
01:E2DA E100            	   438: nxtchr:     cmpb 0,x                    ; does input char match?
01:E2DC 270A            	   439:             beq goodch                  ; yes, goto apropriate routine
01:E2DE 08              	   440:             inx                         ; else, update index into table
01:E2DF 08              	   441:             inx
01:E2E0 08              	   442:             inx
