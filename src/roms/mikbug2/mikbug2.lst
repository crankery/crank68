                        	  1086: 
                        	  1087: ; Startup sound and monitor help live after the SD transport.
                        	  1088:             .include "sound.s"

Source: "sound.s"
                        	     1: ; Reset-time boop for the SN76489AN board at $E060.
                        	     2: ; Revision 1 has TI D0 wired to CPU D0, so its command bytes are reversed.
                        	     3: ; Revision 2 crosses the data lines and takes native SN76489AN commands.
                        	     4:     .if SOUND_BOARD_REV=2
                        	     5:     .equ SOUND_MUTE1, 0x9f
                        	     6:     .equ SOUND_MUTE2, 0xbf
                        	     7:     .equ SOUND_MUTE3, 0xdf
                        	     8:     .equ SOUND_MUTE_NOISE, 0xff
                        	     9:     .equ SOUND_TONE_LOW, 0x8c
                        	    10:     .equ SOUND_TONE_HIGH, 0x11
                        	    11:     .equ SOUND_VOLUME, 0x92
                        	    12:     .else
                        	    13:     .equ SOUND_MUTE1, 0xf9
                        	    14:     .equ SOUND_MUTE2, 0xfd
                        	    15:     .equ SOUND_MUTE3, 0xfb
                        	    16:     .equ SOUND_MUTE_NOISE, 0xff
                        	    17:     .equ SOUND_TONE_LOW, 0x31
                        	    18:     .equ SOUND_TONE_HIGH, 0x88
                        	    19:     .equ SOUND_VOLUME, 0x49
                        	    20:     .endif
                        	    21: 
                        	    22:     .org 0xf300
                        	    23: sound_startup:
                        	    24:     ; Establish a known silent state before playing the short tone.
03:F300 86F9            	    25:     ldaa #SOUND_MUTE1
03:F302 BDF333          	    26:     jsr sound_write
03:F305 86FD            	    27:     ldaa #SOUND_MUTE2
03:F307 BDF333          	    28:     jsr sound_write
03:F30A 86FB            	    29:     ldaa #SOUND_MUTE3
03:F30C BDF333          	    30:     jsr sound_write
03:F30F 86FF            	    31:     ldaa #SOUND_MUTE_NOISE
03:F311 BDF333          	    32:     jsr sound_write
                        	    33: 
                        	    34:     ; Divider $11C at 4 MHz gives about 440 Hz.
03:F314 8631            	    35:     ldaa #SOUND_TONE_LOW
03:F316 BDF333          	    36:     jsr sound_write
03:F319 8688            	    37:     ldaa #SOUND_TONE_HIGH
03:F31B BDF333          	    38:     jsr sound_write
03:F31E 8649            	    39:     ldaa #SOUND_VOLUME
03:F320 BDF333          	    40:     jsr sound_write
                        	    41: 
03:F323 C6C0            	    42:     ldab #0xc0
                        	    43: sound_duration_outer:
03:F325 86FF            	    44:     ldaa #0xff
                        	    45: sound_duration_inner:
03:F327 4A              	    46:     deca
03:F328 26FD            	    47:     bne sound_duration_inner
03:F32A 5A              	    48:     decb
03:F32B 26F8            	    49:     bne sound_duration_outer
                        	    50: 
03:F32D 86F9            	    51:     ldaa #SOUND_MUTE1
03:F32F BDF333          	    52:     jsr sound_write
03:F332 39              	    53:     rts
                        	    54: 
                        	    55: ; READY is not connected. 20 iterations exceed the chip's 32-clock
                        	    56: ; transfer time even at a 2 MHz CPU clock and 4 MHz sound clock.
                        	    57: sound_write:
03:F333 B7E060          	    58:     staa 0xe060
03:F336 C614            	    59:     ldab #20
                        	    60: sound_write_wait:
03:F338 5A              	    61:     decb
03:F339 26FD            	    62:     bne sound_write_wait
03:F33B 39              	    63:     rts
                        	    64: 

