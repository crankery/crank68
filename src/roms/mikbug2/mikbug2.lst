01:E433 BDE170          	   736:             jsr outch                   ; go output null
01:E436 5A              	   737:             decb                        ; decrement counter
01:E437 26F9            	   738:             bne pnull                   ; if not done, then loop
                        	   739: ; 
01:E439 FEBE02          	   740:             ldx bega
