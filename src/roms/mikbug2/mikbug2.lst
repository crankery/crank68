01:E32F 8DE9            	   502: setbrk:     bsr baddrj                  ; get user entered address (xhi,xlo)
01:E331 8604            	   503:             ldaa #4                     ; set one break flag
01:E333 8D5B            	   504:             bsr brksub                  ; go set it
01:E335 20F1            	   505:             bra pntbrk                  ; print all breakpoints
                        	   506: ; 
                        	   507: ; go to requested 
