02:E23E 860A            	   329: ua:         ldaa #0x0a
02:E240 8D12            	   330:             bsr outch1                  ; output lf
02:E242 09              	   331:             dex                         ; dec addr
02:E243 FFBE3E          	   332: ua1:        stx xhi                     ; sav data addr
