Source: "mikbug2.s"
                        	     1: ; vasm buildable hack
                        	     2: ; dave hamilton, 2026
                        	     3: ; 
                        	     4: ; this was originally generated from the copy of mikbug2.asm and the translate.py script in the tools directory
                        	     5: ; gettig the variable address equates properly setup was a bit too much to bother trying to automate.
                        	     6: ; 
                        	     7: ; i claim no ownership of this file and if the rightful owners object to my posting it I will remove it.
                        	     8: 
                        	     9: ; anyway, this builds on vasm6800_std, no vlink required
                        	    10: ; it should be possible to move the main binary. i removed all the hard coded addresses (there were two of them)
                        	    11: ; you might want to change baseorg, RAM_PTR and stack the io area (currently 0xE000-0xE0FF)
                        	    12: ; for your M6800 machine :) haha
                        	    13: ; - dave
                        	    14: 
                        	    15: ; converted to an assembly file from a crappy pdf by 
                        	    16: ; members of the motorola 6809 / 6309, 6800 assembly 
                        	    17: ; language programming facebook group 
                        	    18: ; by craig jones,ray bellis 
                        	    19: ; 
                        	    20: 
                        	    21: 
                        	    22: ; 
                        	    23: ; 
                        	    24: ; ram - locations devoted to variable information 
                        	    25: ; 
                        	    26: ; 
                        	    27: 
                        	    28:     .equ RAM_PTR, 0xBE00
                        	    29: 
                        	    30: .macro ALLOC name, size
                        	    31:     .equ \name, RAM_PTR
                        	    32:     .equ RAM_PTR, RAM_PTR + \size
                        	    33: .endm
                        	    34: 
                        	    35:     .equ nbrbpt, 8
                        	    36: 
                        	    37: ; initialized from rom at start
                        	    38:     ALLOC iov, 2
                        	     1M     .equ iov, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    39:     ALLOC bega, 2
                        	     1M     .equ bega, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    40:     ALLOC enda, 2
                        	     1M     .equ enda, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    41:     ALLOC nio, 2
                        	     1M     .equ nio, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    42:     ALLOC sp, 2
                        	     1M     .equ sp, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    43:     ALLOC swi1, 2
                        	     1M     .equ swi1, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    44:     ALLOC swi2, 2
                        	     1M     .equ swi2, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    45:     ALLOC brins, 8
                        	     1M     .equ brins, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 8
                        	    46:     .equ branen, RAM_PTR
                        	    47: 
                        	    48: ; initialized to zero at start
                        	    49:     ALLOC outsw, 1
                        	     1M     .equ outsw, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    50:     ALLOC trcadr, 2
                        	     1M     .equ trcadr, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    51:     ALLOC trcins, 1
                        	     1M     .equ trcins, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    52:     ALLOC ntrace, 2
                        	     1M     .equ ntrace, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    53: 
                        	    54:     ALLOC brkadr, nbrbpt*2
                        	     1M     .equ brkadr, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + nbrbpt*2
                        	    55:     ALLOC brkins, nbrbpt*2
                        	     1M     .equ brkins, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + nbrbpt*2
                        	    56: 
                        	    57:     ALLOC cksm, 1
                        	     1M     .equ cksm, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    58:     .equ asave, cksm
                        	    59:     .equ temp, cksm
                        	    60: 
                        	    61:     ALLOC bytect, 1
                        	     1M     .equ bytect, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    62:     .equ mcont, bytect
                        	    63: 
                        	    64:     ALLOC xhi, 1
                        	     1M     .equ xhi, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    65:     ALLOC xlow, 1
                        	     1M     .equ xlow, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    66: 
                        	    67:     ALLOC ssave, 2
                        	     1M     .equ ssave, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 2
                        	    68:     .equ tw, ssave
                        	    69: 
                        	    70:     ALLOC brksin, 1
                        	     1M     .equ brksin, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    71:     ALLOC brktrc, 1
                        	     1M     .equ brktrc, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    72: 
                        	    73:     .equ endin0, RAM_PTR
                        	    74:     ALLOC aciat, 1
                        	     1M     .equ aciat, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    75:     ALLOC resume_valid, 1
                        	     1M     .equ resume_valid, RAM_PTR
                        	     2M     .equ RAM_PTR, RAM_PTR + 1
                        	    76: 
                        	    77: ; stack is at 0x100
                        	    78: 
                        	    79:     .equ stackpage, 0xBC00
                        	    80:     .equ stack, stackpage + 0xff
                        	    81: 
                        	    82: ; nam mikbug 
                        	    83: ; ttl 2.0 monitor
                        	    84: ; rev 0 
                        	    85: ; copyright (c) 1977 by motorola inc. 
                        	    86: ; 
                        	    87: ; mikbug (tm) motorola 
                        	    88: ; 
                        	    89: ; austin, texas 
                        	    90: ; microcomputer capital of the world! 
                        	    91: ; 
                        	    92: ; l load 
                        	    93: ; m memory change 
                        	    94: ; p print/punch dump 
                        	    95: ; r display contents of target stack 
                        	    96: ; cc b a x p s 
                        	    97: ; s 1,set speed for 10 cps 
                        	    98: ; 3,set speed for 30 cps 
                        	    99: ; b print out all breakpoints 
                        	   100: ; c continue execution from current location 
                        	   101: ; n next instruction 
                        	   102: ; t trace 'N' instructions 
                        	   103: ; f boot FLEX 2 from banked SRAM (cold handoff)
                        	   104: ; g go to location 'N' 
                        	   105: ; d delete all breakpoints 
                        	   106: ; u reset breakpoint with address 'N' 
                        	   107: ; v set a breakpoint with address 'N' 
                        	   108: ; 
                        	   109:             .equ swiop, 0x3f            ; swi op code
                        	   110: 
                        	   111:             .org 0xe000 ; physical ROM bytes shadowed by I/O
                        	   112: rom_id:     .include "build/rom-id.s"

Source: "build/rom-id.s"
                        	     1: ; Physical ROM bytes at $E000; CPU reads in this range select I/O.
00:E000 4352414E4B363820	     2:     .byte "CRANK68 MIKBUG2",0
00:E008 4D494B42554732
00:E00F 00
00:E010 524F4D2056455253	     3:     .byte "ROM VERSION 1",0
00:E018 494F4E2031
00:E01D 00
00:E01E 4255494C54203230	     4:     .byte "BUILT 2026-11-12 22:03 UTC",0
00:E026 32362D31312D3132
00:E02E 2032323A30332055
00:E036 5443
00:E038 00
00:E039 5344204142492033	     5:     .byte "SD ABI 3",0
00:E041 00
00:E042 534F554E44205245	     6:     .byte "SOUND REV 1",0
00:E04A 562031
00:E04D 00
