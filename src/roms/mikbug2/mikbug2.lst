01:E4AA 6D06            	   802:             tst 6,x                     ; if lower byte = 0 => borrow
01:E4AC 2602            	   803:             bne swi151                  ; branch if borrow not req'd
01:E4AE 6A05            	   804:             dec 5,x                     ; decrement upper byte
01:E4B0 6A06            	   805: swi151:     dec 6,x                     ; decrement lower byte
                        	   806: ; 
                        	   807: ; test for address trace or break 
                        	   808: ; 
01:E4B2 EE05            	   809:             ldx 5,x                     ; x:=p counter
01:E4B4 BCBE17          	   810:             cpx trcadr                  ; is swi for trace?
01:E4B7 2718            	   811:             beq trcinh                  ; yes, go to trace int handler
                        	   812: ; 
01:E4B9 A600            	   813:             ldaa 0,x                    ; get instruction causing swi
01:E4BB 813F            	   814:             cmpa #swiop                 ; was it replaced by call to break
01:E4BD 260C            	   815:             bne brkinh                  ; yes, so must be a break
                        	   816: ; 
                        	   817: ; user swi-transfer through level 2 swi 
                        	   818: ; 
01:E4BF 30              	   819:             tsx                         ; x:=stack pointer
01:E4C0 6C06            	   820:             inc 6,x                     ; update low byte of p-counter
01:E4C2 2602            	   821:             bne incnov                  ; branch if no carry
01:E4C4 6C05            	   822:             inc 5,x                     ; update high byte if necessary
01:E4C6 FEBE0C          	   823: incnov:     ldx swi2                    ; x:=pointer to level 2 swi handler
01:E4C9 6E00            	   824:             jmp 0,x                     ; go to level 2 handler
                        	   825: ; 
                        	   826: ; 
                        	   827: ; 
                        	   828: ; 
                        	   829: ; break interrupt handler 
                        	   830: ; 
                        	   831: brkinh:
01:E4CB BDE408          	   832:             jsr print                   ; stop and show regs to user
01:E4CE 7EE2BB          	   833: ctrl:       jmp contrl                  ; return to control loop
                        	   834: ; 
                        	   835: ; trace interrupt handler 
                        	   836: ; p-counter has been decremented to point at swi 
                        	   837: ; trcins holds op code replaced by swi 
                        	   838: ; x hold address where trace swi is 
                        	   839: ; 
01:E4D1 B6BE19          	   840: trcinh:     ldaa trcins                 ; get op code of traced instr
01:E4D4 A700            	   841:             staa 0,x                    ; restore to user's code
                        	   842: ; 
01:E4D6 7DBE43          	   843:             tst brktrc                  ; is processing to be
                        	   844: ; immediately continued? 
01:E4D9 270F            	   845:             beq nbktrc                  ; branch if not
                        	   846: ; 
                        	   847: ; processing is to 'CONTINUE' 
                        	   848: ; 
01:E4DB 7FBE43          	   849:             clr brktrc                  ; reset continue flag
01:E4DE 86FF            	   850:             ldaa #0xff                  ; flag to set breaks in code
01:E4E0 BDE390          	   851:             jsr brksub                  ; put breaks in
01:E4E3 7FBE17          	   852:             clr trcadr                  ; no more trace, so clear address
01:E4E6 7FBE18          	   853:             clr trcadr+1
01:E4E9 3B              	   854:             rti                         ; continue
                        	   855: ; 
                        	   856: ; trace is due to n or t trace commands 
                        	   857: ; 
01:E4EA BDE408          	   858: nbktrc:     jsr print                   ; print stack
01:E4ED FEBE1A          	   859:             ldx ntrace                  ; get # instructions to trace
01:E4F0 09              	   860:             dex                         ; decrement count
01:E4F1 FFBE1A          	   861:             stx ntrace                  ; and restore
01:E4F4 27D8            	   862:             beq ctrl                    ; branch if all traces done
                        	   863: ; 
                        	   864: ; trace not done - trace next instruction 
                        	   865: ; 
01:E4F6 B6BE19          	   866: contrc:     ldaa trcins                 ; get current instruction
01:E4F9 B7BE0E          	   867:             staa brins                  ; save in case it's a branch
01:E4FC 8D70            	   868:             bsr opcbyt                  ; go get # bytes"type
01:E4FE 4D              	   869:             tsta                        ; check for branch
01:E4FF 2A35            	   870:             bpl ckobra                  ; check for other than branch
                        	   871: ; 
                        	   872: ; relative branch type instruction 
                        	   873: ; determine where to put swi 
                        	   874: ; s- holds pointer to user stack after swi 
01:E501 32              	   875:             pula                        ; get condition code
01:E502 34              	   876:             des                         ; update stack pointer after pull
01:E503 8A10            	   877:             oraa #0b00010000            ; make int's inhibited
01:E505 06              	   878:             tap                         ; restore user's c. code reg
01:E506 7EBE0E          	   879:             jmp brins                   ; go see how relative branch
                        	   880: ; fares 
                        	   881: ; 
                        	   882: ; branch was nogo - put swi at next instruction 
                        	   883: ; 
01:E509 8602            	   884: brnogo:     ldaa #2                     ; a = # bytes after current instr
01:E50B 2029            	   885:             bra ckobra                  ; go put swi appropriately
                        	   886: ; 
                        	   887: ; branch was go, put swi at address being 
                        	   888: ; jumped to 
                        	   889: ; 
01:E50D FEBE17          	   890: brgo:       ldx trcadr                  ; x : = trace address
01:E510 A601            	   891:             ldaa 1,x                    ; get branch offset
01:E512 08              	   892:             inx                         ; offset is relative to
01:E513 08              	   893:             inx                         ; instr following branch
01:E514 2B12            	   894:             bmi brgodc                  ; branch if offset negative
01:E516 8D16            	   895: brg1:       bsr incx_                   ; increment x by amount in
                        	   896: ; a reg 
01:E518 FFBE17          	   897: brg2:       stx trcadr                  ; save address of next
                        	   898: ; instr to stop on 
01:E51B A600            	   899:             ldaa 0,x                    ; get instruction to be replaced
01:E51D B7BE19          	   900:             staa trcins                 ; save
01:E520 863F            	   901:             ldaa #swiop                 ; get swi op code
01:E522 A700            	   902:             staa 0,x                    ; replace instr with swi
01:E524 BEBE08          	   903:             lds sp                      ; get original stack pointer
01:E527 3B              	   904:             rti                         ; trace another instr
                        	   905: ; 
                        	   906: ; x needs to be decremented (offset negative) 
                        	   907: ; 
01:E528 09              	   908: brgodc:     dex                         ; decrement address
01:E529 4C              	   909:             inca                        ; increment counter
01:E52A 26FC            	   910:             bne brgodc                  ; if counter not 0, branch
01:E52C 20EA            	   911:             bra brg2                    ; if done, go return to user prog
                        	   912: ; 
                        	   913: ; subroutine to increment x by contents of a 
                        	   914: ; 
01:E52E 4D              	   915: incx_:      tsta                        ; is a = 0?
01:E52F 2704            	   916:             beq incxr                   ; if so, inc done
01:E531 08              	   917: inxlp:      inx                         ; else increment x
01:E532 4A              	   918:             deca                        ; decrement count
01:E533 26FC            	   919:             bne inxlp                   ; if count not yet 0, loop
01:E535 39              	   920: incxr:      rts                         ; return from this subroutine
                        	   921: ; 
                        	   922: ; instruction to be traced is not a branch 
                        	   923: ; 
01:E536 FEBE17          	   924: ckobra:     ldx trcadr                  ; x : = trace address
01:E539 E600            	   925:             ldab 0,x                    ; get instr to be traced
01:E53B C16E            	   926:             cmpb #0x6e                  ; is it a jump, indexed?
01:E53D 271A            	   927:             beq jmpidx                  ; yes, go simulate jump idxed
01:E53F C17E            	   928:             cmpb #0x7e                  ; jump, extended?
01:E541 271D            	   929:             beq jmpext
01:E543 C1AD            	   930:             cmpb #0xad                  ; jsr, indexed?
01:E545 2712            	   931:             beq jmpidx                  ; (jump idxed is same as
                        	   932: ; transfer of control) 
01:E547 C1BD            	   933:             cmpb #0xbd                  ; jsr, extended?
01:E549 2715            	   934:             beq jmpext
01:E54B C13B            	   935:             cmpb #0x3b                  ; rti?
01:E54D 2715            	   936:             beq rtisim
01:E54F C139            	   937:             cmpb #0x39                  ; rts?
01:E551 2716            	   938:             beq rtssim
01:E553 C18D            	   939:             cmpb #0x8d                  ; bsr?
01:E555 27B6            	   940:             beq brgo                    ; (branch processing)
                        	   941: ; 
                        	   942: ; not a branch, jump. rti, rts 
                        	   943: ; a register holds # bytes in instruction 
                        	   944: ; 
01:E557 20BD            	   945:             bra brg1                    ; put in new swi and
                        	   946: ; trace next instruction 
                        	   947: ; 
                        	   948: ; jump, jsr indexed simulation 
                        	   949: ; 
01:E559 A601            	   950: jmpidx:     ldaa 1,x                    ; a : = address offset
01:E55B 30              	   951:             tsx
01:E55C EE03            	   952:             ldx 3,x                     ; get targets x reg
01:E55E 20B6            	   953:             bra brg1                    ; update x, trace next instr
                        	   954: ; 
                        	   955: ; jump, jsr extended 
                        	   956: ; 
01:E560 EE01            	   957: jmpext:     ldx 1,x                     ; get address to be jumped to
01:E562 20B4            	   958:             bra brg2                    ; go trace next instr.
                        	   959: ; 
                        	   960: ; rti encountered 
                        	   961: ; 
01:E564 30              	   962: rtisim:     tsx
01:E565 EE0C            	   963:             ldx 12,x                    ; get p-counter from stack
01:E567 20AF            	   964:             bra brg2                    ; go trace next instr.
                        	   965: ; 
                        	   966: ; rts encountered 
                        	   967: ; 
01:E569 30              	   968: rtssim:     tsx
01:E56A EE07            	   969:             ldx 7,x                     ; get return p-reg from stack
01:E56C 20AA            	   970:             bra brg2                    ; go trace next instr
                        	   971: ; 
                        	   972: ; 
                        	   973: ; opbcyt 
                        	   974: ; 
                        	   975: ; this routine determines the # of bytes in an instruction 
                        	   976: ; given its op code. 
                        	   977: ; 
                        	   978: ; input: a holds the op code 
                        	   979: ; 
                        	   980: ; output: x holds the index of table element 
                        	   981: ; b not restored 
                        	   982: ; a holds # bytes in instruction 
                        	   983: ; except for branches in which case is negative 
                        	   984: ; 
                        	   985: ; 
                        	   986: ; 
                        	   987: opcbyt:
01:E56E 16              	   988:             tab                         ; b:= op code
01:E56F 44              	   989:             lsra
01:E570 44              	   990:             lsra
01:E571 44              	   991:             lsra                        ; put 4 upper bits of op code in
01:E572 44              	   992:             lsra                        ; lower 4 bits of a
                        	   993: ; 
01:E573 CEE58C          	   994:             ldx #opbttb                 ; x:= address of table
01:E576 8DB6            	   995:             bsr incx_                   ; increment x to point to correct
                        	   996: ; 
01:E578 A600            	   997:             ldaa 0,x                    ; get table entry
01:E57A 260F            	   998:             bne opbtrt                  ; if not 0 then no further
                        	   999: ; processing needed 
                        	  1000: ; 
                        	  1001: ; if top 4 bits = 8 or c, then there are two classes 
                        	  1002: ; of instructions: 2 byte instructions and 
                        	  1003: ; ce, 8c and 8e which are 3 byte instructions 
                        	  1004: ; 
01:E57C 8602            	  1005:             ldaa #2                     ; # bytes in most of 8# instructions
01:E57E C18C            	  1006:             cmpb #0x8c                  ; 3 byte instruction?
01:E580 2708            	  1007:             beq opbt3                   ; yes, update a
01:E582 C1CE            	  1008:             cmpb #0xce                  ; 3 byte instr?
01:E584 2704            	  1009:             beq opbt3                   ; yes, update a
01:E586 C18E            	  1010:             cmpb #0x8e                  ; 3 byte instruction?
01:E588 2601            	  1011:             bne opbtrt                  ; no, return
                        	  1012: ; 
01:E58A 4C              	  1013: opbt3:      inca                        ; # bytes in instruction:=3
                        	  1014: ; 
01:E58B 39              	  1015: opbtrt:     rts                         ; return to caller
                        	  1016: ; 
                        	  1017: ; op code to number of bytes conversion table 
                        	  1018: ; 
                        	  1019: ; # bytes top 4 bits of opcode 
                        	  1020: ; ------- -------------------- 
                        	  1021: ; 
                        	  1022: opbttb:
01:E58C 01              	  1023:             .byte 1                     ; 0
01:E58D 01              	  1024:             .byte 1                     ; 1
01:E58E 82              	  1025:             .byte 2+0b10000000          ; 2 ( minus=> branches )
01:E58F 01              	  1026:             .byte 1                     ; 3
01:E590 01              	  1027:             .byte 1                     ; 4
01:E591 01              	  1028:             .byte 1                     ; 5
01:E592 02              	  1029:             .byte 2                     ; 6
01:E593 03              	  1030:             .byte 3                     ; 7
01:E594 00              	  1031:             .byte 0                     ; 8 # bytes=2 except 8c,8e
01:E595 02              	  1032:             .byte 2                     ; 9
01:E596 02              	  1033:             .byte 2                     ; a
01:E597 03              	  1034:             .byte 3                     ; b
01:E598 00              	  1035:             .byte 0                     ; c # bytes = 2 except ce
01:E599 02              	  1036:             .byte 2                     ; d
01:E59A 02              	  1037:             .byte 2                     ; e
01:E59B 03              	  1038:             .byte 3                     ; f
