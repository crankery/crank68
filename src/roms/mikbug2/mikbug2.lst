02:E38D 7EE2BB          	   561: cntrl2:     jmp contrl                  ; return to command level
                        	   562: ; 
                        	   563: ; 
                        	   564: ; brksub 
                        	   565: ; 
                        	   566: ; 
                        	   567: ; this routine does a number of operations having 
                        	   568: ; to do with breakpoints. 
                        	   569: ; 
                        	   570: ; the a register determines function performed: 
                        	   571: ; 
                        	   572: ; a = -1 => breaks are put into user's code 
                        	   573: ; a = 0 => the breakpoint whose address is in 
                        	   574: ; xhi, xlo is purged; 
                        	   575: ; all breakpoints are temporarily removed 
                        	   576: ; a = 1 => all breakpoints are purged 
                        	   577: ; a = 2 => all breakpoints are printed out 
                        	   578: ; all breakpoints are temporarily removed 
                        	   579: ; a = 3 => all breakpoints are temporarily removed 
                        	   580: ; a = 4 => the break address in xhi, xlo is 
                        	   581: ; put into the first zero breakpoint 
                        	   582: ; position; all breaks are temporarily removed 
                        	   583: ; 
                        	   584: ; 
                        	   585: ; 
                        	   586: brksub:
02:E390 BFBE40          	   587:             sts ssave                   ; save s so we can use
02:E393 B7BE3C          	   588:             staa asave                  ; a holds the function #
                        	   589: ; 
02:E396 CEBE1C          	   590:             ldx #brkadr                 ; init x for loop through breaks
                        	   591: ; 
                        	   592: ; start of loop through break addresses 
                        	   593: ; 
02:E399 B6BE3C          	   594: brklp:      ldaa asave                  ; get function #
02:E39C AE00            	   595:             lds 0,x                     ; s:=next address in brrkpt list
02:E39E 272D            	   596:             beq ln                      ; if 0, then not a valid break
                        	   597: ; 
02:E3A0 7DBE42          	   598:             tst brksin                  ; are breaks in user's code?
02:E3A3 2736            	   599:             beq nobrin                  ; branch, if not
                        	   600: ; 
                        	   601: ; breaks are in user's code 
                        	   602: ; 
02:E3A5 4D              	   603:             tsta                        ; should breaks be in?
02:E3A6 2B21            	   604:             bmi bkdone                  ; yes, return to caller
                        	   605: ; 
                        	   606: ; breaks are to be taken out of user's 
                        	   607: ; code temporarily 
                        	   608: ; 
02:E3A8 A610            	   609: brk2:       ldaa 2*nbrbpt,x             ; get instr. belong-
                        	   610: ; ing in user code 
02:E3AA 36              	   611:             psha                        ; put it there
                        	   612: ; 
                        	   613: ; other loop actions to be performed each time through 
                        	   614: ; loop when break address not equal to 0. 
                        	   615: ; 
02:E3AB B6BE3C          	   616: bkcon1:     ldaa asave                  ; what function is to be done
02:E3AE 2737            	   617:             beq fndrpl                  ; see if breakpoint needs to
                        	   618: ; be replaced 
02:E3B0 8101            	   619:             cmpa #1                     ; is break address to be reset?
02:E3B2 2741            	   620:             beq clrbrk                  ; yes, set brkadr to 0
                        	   621: ; 
02:E3B4 8102            	   622:             cmpa #2                     ; is brk addr to be printed?
02:E3B6 2749            	   623:             beq prntbk                  ; yes, go print address
                        	   624: ; 
                        	   625: ; update loop index and loop if appropriate 
                        	   626: ; 
02:E3B8 08              	   627: bkcon2:     inx                         ; make x point to
02:E3B9 08              	   628:             inx                         ; next break address
02:E3BA 8CBE2C          	   629: bkcon3:     cpx #brkins                 ; any more breaks?
02:E3BD 26DA            	   630:             bne brklp                   ; yes,loop
                        	   631: ; 
                        	   632: ; wrap-up processing and exit 
                        	   633: ; 
02:E3BF 4F              	   634:             clra                        ; a = breaks in flag
02:E3C0 7DBE3C          	   635:             tst asave                   ; is function = -1?
02:E3C3 2A01            	   636:             bpl bkput                   ; no, so brksin = 0
02:E3C5 4C              	   637:             inca                        ; fctn = -1 => brksin:=1
02:E3C6 B7BE42          	   638: bkput:      staa brksin                 ; store appropriate flag
                        	   639: ; 
                        	   640: ; restore s-reg and return to caller 
                        	   641: ; 
02:E3C9 BEBE40          	   642: bkdone:     lds ssave                   ; restore user s-reg
02:E3CC 39              	   643:             rts                         ; return
                        	   644: ; 
                        	   645: ; 
                        	   646: ; miscellaneous routines for brksub 
                        	   647: ; 
                        	   648: ; breakpoint address = 0 - if function = 4 then 
                        	   649: ; put breakpoint address in current position 
                        	   650: ; a holds the function #, x holds breakpoint index 
                        	   651: ; 
02:E3CD 8104            	   652: ln:         cmpa #4                     ; is function = 4
02:E3CF 26E7            	   653:             bne bkcon2                  ; if not, then continue loop
                        	   654: ; 
02:E3D1 BEBE3E          	   655:             lds xhi                     ; get new break address
02:E3D4 AF00            	   656:             sts 0,x                     ; put in current position
                        	   657: ; 
02:E3D6 7ABE3C          	   658:             dec asave                   ; do not place address more
                        	   659: ; than once-cont to 
                        	   660: ; take out breakpoints 
02:E3D9 20DD            	   661:             bra bkcon2                  ; continue loop
                        	   662: ; 
                        	   663: ; breaks are not in and address is non-zero. 
                        	   664: ; if function = -1 then swi's are to be put in. 
                        	   665: ; a holds function number, s holds address 
                        	   666: ; 
02:E3DB 4D              	   667: nobrin:     tsta                        ; is function = -1
02:E3DC 2ACD            	   668:             bpl bkcon1                  ; no, continue
                        	   669: ; 
02:E3DE 34              	   670:             des                         ; make address point to 1 less
02:E3DF 32              	   671:             pula                        ; get user instruction
02:E3E0 A710            	   672:             staa 2*nbrbpt,x             ; save
02:E3E2 863F            	   673:             ldaa #swiop                 ; get swi op code
02:E3E4 36              	   674:             psha                        ; replace user instruction
02:E3E5 20D1            	   675:             bra bkcon2                  ; continue loop
                        	   676: ; 
                        	   677: ; function=0 brk addr not = 0, user's instr 
                        	   678: ; is in (not swi). 
                        	   679: ; if address = xhi,xlo then set address = 0 
02:E3E7 A600            	   680: fndrpl:     ldaa 0,x                    ; get top byte of address
02:E3E9 B1BE3E          	   681:             cmpa xhi                    ; do top bytes compare
02:E3EC 26CA            	   682:             bne bkcon2                  ; no,continue loop
02:E3EE E601            	   683:             ldab 1,x                    ; get low byte of addr
02:E3F0 F1BE3F          	   684:             cmpb xlow                   ; same for low bytes
02:E3F3 26C3            	   685:             bne bkcon2
                        	   686: ; 
02:E3F5 6F00            	   687: clrbrk:     clr 0,x                     ; clear out break
02:E3F7 6F01            	   688:             clr 1,x                     ; address field
02:E3F9 20BD            	   689:             bra bkcon2                  ; continue loop
                        	   690: ; 
                        	   691: ; 
02:E3FB 7EE1C5          	   692: ot2hs:      jmp out2hs
02:E3FE 7EE1C3          	   693: ot4hs:      jmp out4hs
                        	   694: ; 
                        	   695: ; 
                        	   696: ; print out break address 
                        	   697: ; function = 2, break address not = 0, x = address in 
                        	   698: ; 
02:E401 BEBE40          	   699: prntbk:     lds ssave
02:E404 8DF8            	   700:             bsr ot4hs                   ; output address and space
02:E406 20B2            	   701:             bra bkcon3                  ; out4hs increments x,
                        	   702: ; so bypas 2 inx's 
                        	   703: ; 
                        	   704: ; print contents of stack 
                        	   705: ; 
02:E408 BDE199          	   706: print:      jsr pcrlf                   ; print cr lf
02:E40B FEBE08          	   707:             ldx sp                      ; print out stack
02:E40E 08              	   708:             inx
02:E40F 8DEA            	   709:             bsr ot2hs                   ; condition codes
02:E411 8DE8            	   710:             bsr ot2hs                   ; acc-b
02:E413 8DE6            	   711:             bsr ot2hs                   ; acc-a
02:E415 8DE7            	   712:             bsr ot4hs                   ; x-reg
02:E417 8DE5            	   713:             bsr ot4hs                   ; p-counter
02:E419 CEBE08          	   714:             ldx #sp
02:E41C 8DE0            	   715:             bsr ot4hs                   ; stack pointer
02:E41E 39              	   716:             rts
