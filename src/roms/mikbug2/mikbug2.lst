01:E306 BDE1C7          	   464:             jsr outs
01:E309 8602            	   465:             ldaa #2                     ; remove breakpoints
01:E30B BDE390          	   466:             jsr brksub                  ; outside BSR range after context guard
01:E30E 2072            	   467:             bra pstak1
                        	   468: ; 
                        	   469: ; set speed for user tty 
