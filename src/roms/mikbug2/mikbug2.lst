                        	  1090: 
                        	  1091: ; Keep existing monitor entry addresses stable by extending dispatch here.
                        	  1092:             .org 0xff80
                        	  1093: flexdispatch:
05:FF80 C161            	  1094:             cmpb #0x61                  ; fold lowercase command letters
05:FF82 2506            	  1095:             bcs flexcommand
05:FF84 C17A            	  1096:             cmpb #0x7a
05:FF86 2202            	  1097:             bhi flexcommand
05:FF88 C020            	  1098:             subb #0x20
                        	  1099: flexcommand:
05:FF8A C13F            	  1100:             cmpb #0x3f                  ; ? - show commands
05:FF8C 270E            	  1101:             beq flexhelp
05:FF8E C148            	  1102:             cmpb #0x48                  ; H/h - show commands
05:FF90 270A            	  1103:             beq flexhelp
05:FF92 C146            	  1104:             cmpb #0x46                  ; F - boot FLEX
05:FF94 272A            	  1105:             beq flexboot
05:FF96 CEE10D          	  1106:             ldx #fctabl
05:FF99 7EE2DA          	  1107:             jmp nxtchr
05:FF9C 7EF350          	  1108: flexhelp:   jmp help_command
                        	  1109: 
                        	  1110: ; FLEX 2 cold boot entry. Fixed address for JMP/JSR callers and G FFC0.
                        	  1111: ; Does not return: FLEX replaces monitor workspace/stack. Requires a
                        	  1112: ; preloaded raw FLEX SRAM disk, as built by src/flex2. A, X and SP clobbered.
                        	  1113: ; The sector loader sets its own stack; no monitor RAM or stack is needed.
                        	  1114:             .org 0xffc0
06:FFC0 0F              	  1115: flexboot:   sei
06:FFC1 8603            	  1116:             ldaa #3                     ; reset first MC6850
06:FFC3 B7E010          	  1117:             staa acias
06:FFC6 8611            	  1118:             ldaa #0x11                  ; polling, 8 data bits, 2 stop bits
06:FFC8 B7E010          	  1119:             staa acias
06:FFCB 7FE002          	  1120:             clr 0xe002                  ; select SRAM page zero
06:FFCE 8E01FF          	  1121:             lds #0x01ff                 ; copy backwards using stack stores
06:FFD1 CEC100          	  1122:             ldx #0xc100
06:FFD4 09              	  1123: flexcopy:   dex
06:FFD5 A600            	  1124:             ldaa 0,x
06:FFD7 36              	  1125:             psha
06:FFD8 8CC000          	  1126:             cpx #0xc000
06:FFDB 26F7            	  1127:             bne flexcopy
06:FFDD 7E0100          	  1128:             jmp 0x0100                  ; linked boot sector owns the machine
                        	  1129: 
                        	  1130: ; 
                        	  1131: ; interrupt vectors 
                        	  1132: ; 
                        	  1133:             .org 0xFFF8
                        	  1134: 
07:FFF8 E100            	  1135:             .word io
