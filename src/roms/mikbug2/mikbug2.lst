                        	   452: ; nmi entry 
                        	   453: ; 
02:E2EC FEBE06          	   454: nmi:        ldx nio                     ; monitor workspace still intact?
02:E2EF 8CE2EC          	   455:             cpx #nmi
02:E2F2 2703            	   456:             beq nmi_ready
02:E2F4 7EE276          	   457:             jmp start                   ; FLEX replaced workspace: cold monitor entry
02:E2F7 BFBE08          	   458: nmi_ready:  sts sp                      ; save stack
02:E2FA 8601            	   459:             ldaa #1
02:E2FC B7BE45          	   460:             staa resume_valid
02:E2FF BDE199          	   461:             jsr pcrlf
02:E302 8642            	   462:             ldaa #'B'                   ;  print b
02:E304 8DCC            	   463:             bsr out2
02:E306 BDE1C7          	   464:             jsr outs
02:E309 8602            	   465:             ldaa #2                     ; remove breakpoints
02:E30B BDE390          	   466:             jsr brksub                  ; outside BSR range after context guard
02:E30E 2072            	   467:             bra pstak1
                        	   468: ; 
                        	   469: ; set speed for user tty 
