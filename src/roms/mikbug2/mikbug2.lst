02:E58D 01              	  1024:             .byte 1                     ; 1
02:E58E 82              	  1025:             .byte 2+0b10000000          ; 2 ( minus=> branches )
02:E58F 01              	  1026:             .byte 1                     ; 3
02:E590 01              	  1027:             .byte 1                     ; 4
02:E591 01              	  1028:             .byte 1                     ; 5
02:E592 02              	  1029:             .byte 2                     ; 6
02:E593 03              	  1030:             .byte 3                     ; 7
02:E594 00              	  1031:             .byte 0                     ; 8 # bytes=2 except 8c,8e
02:E595 02              	  1032:             .byte 2                     ; 9
02:E596 02              	  1033:             .byte 2                     ; a
02:E597 03              	  1034:             .byte 3                     ; b
02:E598 00              	  1035:             .byte 0                     ; c # bytes = 2 except ce
02:E599 02              	  1036:             .byte 2                     ; d
02:E59A 02              	  1037:             .byte 2                     ; e
