02:E1A5 8DCC            	   241: inhex:      bsr inch
02:E1A7 8030            	   242: inhex2:     suba #0x30
02:E1A9 2B6A            	   243:             bmi c1                      ; not hex
02:E1AB 8109            	   244:             cmpa #0x09
02:E1AD 2F0A            	   245:             ble in1hg
02:E1AF 8111            	   246:             cmpa #0x11
02:E1B1 2B62            	   247:             bmi c1                      ; not hex
02:E1B3 8116            	   248:             cmpa #0x16
02:E1B5 2E5E            	   249:             bgt c1                      ; not hex
02:E1B7 8007            	   250:             suba #7
02:E1B9 39              	   251: in1hg:      rts
                        	   252: ; 
02:E1BA A600            	   253: out2h:      ldaa 0,x                    ; output 2 hex char
02:E1BC 8DA4            	   254: out2ha:     bsr outhl                   ; out left hex char
02:E1BE A600            	   255:             ldaa 0,x                    ; pick up byte again
02:E1C0 08              	   256:             inx
02:E1C1 20A3            	   257:             bra outhr                   ; output right hex char and rts
02:E1C3 8DF5            	   258: out4hs:     bsr out2h                   ; output 4 hex char + space
02:E1C5 8DF3            	   259: out2hs:     bsr out2h                   ; output 2 hex char + space
02:E1C7 8620            	   260: outs:       ldaa #0x20                  ; space
02:E1C9 20A5            	   261:             bra outch                   ; (bsr & rts)
                        	   262: load:
02:E1CB 8611            	   263:             ldaa #021
02:E1CD 8DA1            	   264:             bsr outch                   ; output char
                        	   265: ; 
                        	   266: ; turn reader relay on 
                        	   267: ; 
02:E1CF B6BE44          	   268:             ldaa aciat                  ; get acia control reg format
02:E1D2 8A40            	   269:             oraa #0x40                  ; set rts to turn rdr relay on
02:E1D4 B7E010          	   270:             staa acias                  ; turn it on
                        	   271: ; 
02:E1D7 7CBE16          	   272:             inc outsw                   ; do not echo tape
                        	   273: ; 
02:E1DA 8D97            	   274: load3:      bsr inch
02:E1DC 2003            	   275:             bra load4
02:E1DE 7EE2A2          	   276: enter:      jmp ent1                    ; mikbug 1 entry point
                        	   277: load4:
02:E1E1 8153            	   278:             cmpa #'S'
02:E1E3 26F5            	   279:             bne load3                   ; 1st char not (s)
02:E1E5 8D8C            	   280:             bsr inch                    ; read char
02:E1E7 8139            	   281:             cmpa #'9'
02:E1E9 272A            	   282:             beq c1
02:E1EB 8131            	   283:             cmpa #'1'
02:E1ED 26EB            	   284:             bne load3                   ; 2nd char not (1)
02:E1EF 7FBE3C          	   285:             clr cksm                    ; zero checksum
02:E1F2 BDE150          	   286:             jsr byte                    ; read byte
02:E1F5 8002            	   287:             suba #2
02:E1F7 B7BE3D          	   288:             staa bytect                 ; byte count
                        	   289: ; build address 
02:E1FA BDE142          	   290:             jsr baddr
                        	   291: ; store data 
02:E1FD BDE150          	   292: load11:     jsr byte
02:E200 7ABE3D          	   293:             dec bytect
02:E203 2709            	   294:             beq load15                  ; zero byte count
02:E205 A700            	   295:             staa 0,x                    ; store data
02:E207 A100            	   296:             cmpa 0,x                    ; check data
02:E209 2606            	   297:             bne load19                  ; data not stored
02:E20B 08              	   298:             inx
02:E20C 20EF            	   299:             bra load11
                        	   300: ; 
                        	   301: ; does checksum check? 
                        	   302: ; 
02:E20E 5C              	   303: load15:     incb
02:E20F 27C9            	   304:             beq load3
02:E211 863F            	   305: load19:     ldaa #'?'                   ;  print question mark
02:E213 8D3F            	   306:             bsr outch1
02:E215 7EE2BB          	   307: c1:         jmp contrl
