                        	   410: ; 
                        	   411: ; main command/control loop 
                        	   412: ; 
                        	   413: contrl:
                        	   414: ; 
                        	   415: ; restore stack pointer register 
                        	   416: ; 
02:E2BB BEBE08          	   417:             lds sp                      ; sp was initialized earlier
                        	   418: ; 
