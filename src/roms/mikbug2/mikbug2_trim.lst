02:E819 8D54            	  1560:             bsr ttyo1
02:E81B 4F              	  1561:             clra
02:E81C 20D1            	  1562:             bra bytov1                  ; extra bits
                        	  1563: ; 
                        	  1564: ; sencrc sends the crc registers to tape 
                        	  1565: ; 
                        	  1566: ; 
                        	  1567: ; ram: r, s (freed after this); l (scratch) 
                        	  1568: ; regs: acca, accb (destroyed) 
                        	  1569: ; 
02:E81E B6BE52          	  1570: sencrc:     ldaa s
02:E821 B7BE4F          	  1571:             staa l                      ; temporary crc(l) storage
02:E824 B6BE51          	  1572:             ldaa r
02:E827 8DC6            	  1573:             bsr bytov1                  ; send crc(h)
02:E829 B6BE4F          	  1574:             ldaa l
02:E82C 20C1            	  1575:             bra bytov1                  ; send crc(l)
                        	  1576: ; 
                        	  1577: ; masterdump sends a complete file to tape: 
                        	  1578: ; headerecore, dumpagerecords (1-256), trailerecord 
                        	  1579: ; 
                        	  1580: ; ram: startp, stoppg (unmodified) 
                        	  1581: ; h, l (temp) 
