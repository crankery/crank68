                        	  1058: ; 
                        	  1059: ; 
                        	  1060: ; maximal software implementation of the 
                        	  1061: ; ritter-zettner standards 
                        	  1062: ; 
                        	  1063: ; copyright (c) 1977 motorola inc. and t. f. ritter 
                        	  1064: ; 
                        	  1065: ; commands for exortape 
                        	  1066: ; c l d s : 
                        	  1067: ; c - check tape 
                        	  1068: ; l - load from tape to memory 
                        	  1069: ; d - dump from memory to tape 
                        	  1070: ; s - set baud rate 
                        	  1071: ; 
                        	  1072: ; speed : 
                        	  1073: ; enter 04 08 12 16 20 
                        	  1074: ; 
                        	  1075: ; file id : 
                        	  1076: ; enter four hex characters 
                        	  1077: ; 
                        	  1078: ; startstop pages: 
                        	  1079: ; enter starting page, two hex characters 
                        	  1080: ; enter stoppage, two hex characters 
                        	  1081: ; 
                        	  1082: ; 
                        	  1083: ; 
                        	  1084: ; file specifications 
                        	  1085: ; alc := undefined bit; automatic level control 
                        	  1086: ; post := undefined bit; missing pulse protect 
                        	  1087: ; start sequence := 89afh 
                        	  1088: ; crc := cyclic redundency check bit; x16+x15+x2+x0 
                        	  1089: ; headerecord := (32 alc) (start sequence) (08h) 
                        	  1090: ; (16 file id) (8 # of good pages) (8 post) 
                        	  1091: ; trailerecord := (16 alc) (start sequence) 
                        	  1092: ; (20h) (8 # of bad pages) (8 post) 
                        	  1093: ; dumpagerecord := (16 alc) (start sequence) (10h) 
                        	  1094: ; (8 page #) (2048 data) (16 crc) (8 post) 
                        	  1095: ; charecord := (32 alc) (start sequence) (40h) 
                        	  1096: ; (8 length) (1-256 chars) (16 crc) (8 post) 
                        	  1097: ; otherecord := neither header nor trailer record 
                        	  1098: ; subfile := (headerecord) (0-n otherecords) 
                        	  1099: ; file := (1-n subfiles) (trailerecord) 
                        	  1100: ; 
                        	  1101: ; 
                        	  1102: ; data specifications 
                        	  1103: ; synchronous data; no start or stop bits 
                        	  1104: ; msb sent first (correct order on scope) 
                        	  1105: ; voice messages may be present between files 
                        	  1106: ; 
                        	  1107: ; 
                        	  1108: ; audio modulation specifications 
                        	  1109: ; double-frequency return-to-bias modulation 
                        	  1110: ; logic one = five element pattern: 0 1 0 1 0 
                        	  1111: ; logic zero = five element pattern 0 1 0 0 0 
                        	  1112: ; local el cheapo (realistic ctr-34) does 1200 baud 
                        	  1113: ; (data rate equals 1650 baud 2-stop async) 
                        	  1114: ; 0 erros in 2.6 million bits recovered 
                        	  1115: ; from memorex mrx2 
                        	  1116: ; 
                        	  1117: ; 
                        	  1118: ; audio hardware specifications 
                        	  1119: ; output from pia b2 through 11:1 voltage divider 
                        	  1120: ; (4.7k, 470) into mike jack 
                        	  1121: ; input from spkr jack, through dc-restoring 
                        	  1122: ; circuit and schmidtt trigger 
                        	  1123: ; (mc14583 preferred) into pia b0 
                        	  1124: ; recovered pulse phase matters, so use switch to 
                        	  1125: ; select phase -- both available from mc14583 
                        	  1126: ; 
                        	  1127: ;baud rates: 400 800 1200 1600 2000 
                        	  1128: ;equiv async: 550 1100 1650 2200 2750 
                        	  1129: ;element (usec): 500 250 167 125 100 
                        	  1130: ;totcnt: 35 1b 12 0d 0b 
                        	  1131: ;patdel: 50 26 18 11 0d 
                        	  1132: ; 
                        	  1133: ;system storage 
                        	  1134:             .equ ttycon, 0x8008         ; acia control
                        	  1135:             .equ tty, 0x8009            ; tty acia
                        	  1136:             .equ tp, 0x8004             ; tape port
                        	  1137:             .equ tacon, 0x8005          ; tape control
                        	  1138:             .equ esc, 0x1b              ; escape char
                        	  1139: ; 
                        	  1140: ; 
                        	  1141: ; 
                        	  1142: ; 
                        	  1143: ; 
                        	  1144:             .equ eot, 4
                        	  1145: ; 
                        	  1146: ; 
                        	  1147: ; messages 
                        	  1148: ; 
                        	  1149: ; 
