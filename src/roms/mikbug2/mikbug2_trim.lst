                        	  1609: ; the tape system. 
                        	  1610: ; 
02:E860 7EE878          	  1611: tain1:      jmp tain2                   ; tape in port vector
02:E863 7EE885          	  1612: taou1:      jmp taou2                   ; tape out port vector
02:E866 7EE741          	  1613: loadbv:     jmp loadby                  ; tape byte in vector
02:E869 7EE79B          	  1614: byteov:     jmp byteou                  ; tape byte out vector
02:E86C 7EE87D          	  1615: ttyin1:     jmp ttyin2                  ; control in port vector
02:E86F 7EE881          	  1616: ttyo1:      jmp ttyo2                   ; control out port vector
02:E872 7EE854          	  1617: lsetup:     jmp setup                   ; tape out pia init
02:E875 7EE854          	  1618: dsetup:     jmp setup                   ; tape in pai init
                        	  1619: ; 
                        	  1620: ; 
02:E878 B68004          	  1621: tain2:      ldaa tp                     ; acca from tape
02:E87B 46              	  1622:             rora                        ; data bit in carry
02:E87C 39              	  1623:             rts
02:E87D B68009          	  1624: ttyin2:     ldaa tty                    ; acca from acia
02:E880 39              	  1625:             rts
02:E881 B78009          	  1626: ttyo2:      staa tty                    ; send acca to acia
02:E884 39              	  1627:             rts
02:E885 F78004          	  1628: taou2:      stab tp                     ; accb to tape
02:E888 39              	  1629:             rts
                        	  1630: ; 
                        	  1631: ; copyright (c) 1977 motorola inc - austin texas 
                        	  1632: ; 
                        	  1633: ; 
                        	  1634: ; 
                        	  1635: ; 
                        	  1636: ; unsigned multiply ----- 
                        	  1637: ; 
                        	  1638: ; this routine multiplies the unsigned number in the 
                        	  1639: ; a register with the unsigned number in the b 
                        	  1640: ; register and puts the answers in the concatenated 
                        	  1641: ; a:b where a is the msb. the routine is 
                        	  1642: ; re-entrant and position independent as well 
                        	  1643: ; as being romable. the x register is destroyed 
                        	  1644: ; by the routine. 
                        	  1645: ; 
                        	  1646: ; during execution the stack contains: 
                        	  1647: ; 0,x = loop counter 
                        	  1648: ; 1,x = multiplier (b reg on entry) 
                        	  1649: ; 
                        	  1650: ; the algorithm used may not appear the fastest 
                        	  1651: ; on paper because it always requires 8 passes 
                        	  1652: ; the the loop but because of the fact all 
                        	  1653: ; calculations can be done in the registers it 
                        	  1654: ; is faster except for when the multiplicand 
                        	  1655: ; is very small (<10). the method is a shift and 
                        	  1656: ; add technique that begings with the ms bit 
                        	  1657: ; and works down to the ls bit. 
                        	  1658: ; 
                        	  1659: ; execution time: (29 + zeroes19 + ones26) cycles 
                        	  1660: ; where zeroes and ones are the 0'S AND 1's in 
                        	  1661: ; the a-reg on call. 
                        	  1662: ; 
                        	  1663: ; average execution time: 209 cycles 
                        	  1664: ; 
                        	  1665: ; 
                        	  1666: ; 
02:E889 37              	  1667: mul_:       pshb
02:E88A C608            	  1668:             ldab #8                     ; put counter on stack
02:E88C 37              	  1669:             pshb
02:E88D 30              	  1670:             tsx                         ; set x to point to stack
02:E88E 5F              	  1671:             clrb                        ; clear place to start answer
02:E88F 58              	  1672: ml1:        aslb                        ; shift ans 1 left and into a
02:E890 49              	  1673:             rola                        ; shift whats left of the multiplier
02:E891 2404            	  1674:             bcc ml2                     ; branch if no add needed
02:E893 EB01            	  1675:             addb 1,x                    ; add multiplier at this position
02:E895 8900            	  1676:             adca #0                     ; add carry to a if any
02:E897 6A00            	  1677: ml2:        dec 0,x                     ; done?
02:E899 26F4            	  1678:             bne ml1                     ; nope
02:E89B 31              	  1679:             ins                         ; yes,clean up the stack
02:E89C 31              	  1680:             ins
02:E89D 39              	  1681:             rts
                        	  1682: ;
