                        	   438: ; for user's terminal 
02:E2C0 B7E010          	   439:             staa acias                  ; inz acia
                        	   440: ; 
02:E2C3 7FBE16          	   441:             clr outsw                   ; make sure input is echoed
                        	   442: ; 
02:E2C6 CEE57C          	   443:             ldx #mcloff                 ; terminal init string
02:E2C9 BDE17E          	   444:             jsr pdata1                  ; print data string
                        	   445: ; 
02:E2CC 8D98            	   446:             bsr inch1                   ; read command character
02:E2CE 16              	   447:             tab                         ; save character in b
02:E2CF 2002            	   448:             bra cnta                    ; skip over mikbug 1.0 vector
02:E2D1 2086            	   449: out2:       bra outch1                  ; mikbug 1.0 " output 1 char routine
02:E2D3 BDE1CC          	   450: cnta:       jsr outs                    ; print space after command
                        	   451: ; 
