02:E313 4F              	   503:             clra                        ; reset 1 break flag
02:E314 20F7            	   504:             bra bsrbrk                  ; go reset 1
                        	   505: ; 
                        	   506: ; print out all non-zero break addresses 
                        	   507: ; 
02:E316 BDE19E          	   508: pntbrk:     jsr pcrlf                   ; do cr"lf
