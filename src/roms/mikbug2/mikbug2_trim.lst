02:E656 CEE5D2          	  1233:             ldx #msg3                   ; send file id prompt
02:E659 8D9B            	  1234: ti4:        bsr pdata
02:E65B BDE147          	  1235:             jsr baddr                   ; get file id
02:E65E FFBE45          	  1236:             stx fidh
02:E661 BDE19E          	  1237:             jsr pcrlf
02:E664 B6BE4B          	  1238:             ldaa t1
02:E667 8144            	  1239:             cmpa #'D'                   ;  dump mode?
02:E669 2611            	  1240:             bne tin7
02:E66B CEE5DC          	  1241:             ldx #msg4                   ; send start"stop prompt
02:E66E 8D89            	  1242:             bsr pdat1p
02:E670 BDE147          	  1243:             jsr baddr
02:E673 FFBE47          	  1244:             stx startp
02:E676 BDE19E          	  1245:             jsr pcrlf
02:E679 7EE82E          	  1246:             jmp master
