02:E3E8 08              	   713:             inx
02:E3E9 8DEA            	   714:             bsr ot2hs                   ; condition codes
02:E3EB 8DE8            	   715:             bsr ot2hs                   ; acc-b
02:E3ED 8DE6            	   716:             bsr ot2hs                   ; acc-a
02:E3EF 8DE7            	   717:             bsr ot4hs                   ; x-reg
02:E3F1 8DE5            	   718:             bsr ot4hs                   ; p-counter
02:E3F3 CEBE08          	   719:             ldx #sp
