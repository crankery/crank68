02:E7F8 20F5            	  1537:             bra bytov1                  ; extra bits
                        	  1538: ; 
                        	  1539: ; dumpagerecord sends the start sequence, dumpage-type, 
                        	  1540: ; page number, 2048 bits data, and the crc characters 
                        	  1541: ; 
                        	  1542: ; ram: h, r, s (perm); l (scratch) 
                        	  1543: ; regs: acca, accb (destroyed), new ix 
                        	  1544: ; exit: acca = 0 
                        	  1545: ; 
02:E7FA 8DC3            	  1546: dumpag:     bsr preamb                  ; start a record
02:E7FC 8610            	  1547:             ldaa #0x10                  ; dumpage type
02:E7FE 8DEF            	  1548:             bsr bytov1
