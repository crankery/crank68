                        	   811: ; 
02:E487 EE05            	   812:             ldx 5,x                     ; x:=p counter
02:E489 BCBE17          	   813:             cpx trcadr                  ; is swi for trace?
02:E48C 2718            	   814:             beq trcinh                  ; yes, go to trace int handler
                        	   815: ; 
02:E48E A600            	   816:             ldaa 0,x                    ; get instruction causing swi
02:E490 813F            	   817:             cmpa #swiop                 ; was it replaced by call to break
02:E492 260C            	   818:             bne brkinh                  ; yes, so must be a break
                        	   819: ; 
                        	   820: ; user swi-transfer through level 2 swi 
                        	   821: ; 
02:E494 30              	   822:             tsx                         ; x:=stack pointer
02:E495 6C06            	   823:             inc 6,x                     ; update low byte of p-counter
02:E497 2602            	   824:             bne incnov                  ; branch if no carry
02:E499 6C05            	   825:             inc 5,x                     ; update high byte if necessary
02:E49B FEBE0C          	   826: incnov:     ldx swi2                    ; x:=pointer to level 2 swi handler
02:E49E 6E00            	   827:             jmp 0,x                     ; go to level 2 handler
                        	   828: ; 
                        	   829: ; 
                        	   830: ; 
                        	   831: ; 
                        	   832: ; break interrupt handler 
                        	   833: ; 
                        	   834: brkinh:
02:E4A0 BDE3E2          	   835:             jsr print                   ; stop and show regs to user
02:E4A3 7EE2BA          	   836: ctrl:       jmp contrl                  ; return to control loop
                        	   837: ; 
                        	   838: ; trace interrupt handler 
                        	   839: ; p-counter has been decremented to point at swi 
                        	   840: ; trcins holds op code replaced by swi 
                        	   841: ; x hold address where trace swi is 
                        	   842: ; 
02:E4A6 B6BE19          	   843: trcinh:     ldaa trcins                 ; get op code of traced instr
02:E4A9 A700            	   844:             staa 0,x                    ; restore to user's code
                        	   845: ; 
02:E4AB 7DBE43          	   846:             tst brktrc                  ; is processing to be
                        	   847: ; immediately continued? 
02:E4AE 270F            	   848:             beq nbktrc                  ; branch if not
                        	   849: ; 
                        	   850: ; processing is to 'CONTINUE' 
                        	   851: ; 
02:E4B0 7FBE43          	   852:             clr brktrc                  ; reset continue flag
02:E4B3 86FF            	   853:             ldaa #0xff                  ; flag to set breaks in code
02:E4B5 BDE36A          	   854:             jsr brksub                  ; put breaks in
02:E4B8 7FBE17          	   855:             clr trcadr                  ; no more trace, so clear address
02:E4BB 7FBE18          	   856:             clr trcadr+1
02:E4BE 3B              	   857:             rti                         ; continue
                        	   858: ; 
                        	   859: ; trace is due to n or t trace commands 
                        	   860: ; 
02:E4BF BDE3E2          	   861: nbktrc:     jsr print                   ; print stack
02:E4C2 FEBE1A          	   862:             ldx ntrace                  ; get # instructions to trace
02:E4C5 09              	   863:             dex                         ; decrement count
02:E4C6 FFBE1A          	   864:             stx ntrace                  ; and restore
02:E4C9 27D8            	   865:             beq ctrl                    ; branch if all traces done
                        	   866: ; 
                        	   867: ; trace not done - trace next instruction 
                        	   868: ; 
02:E4CB B6BE19          	   869: contrc:     ldaa trcins                 ; get current instruction
02:E4CE B7BE0E          	   870:             staa brins                  ; save in case it's a branch
02:E4D1 8D70            	   871:             bsr opcbyt                  ; go get # bytes"type
02:E4D3 4D              	   872:             tsta                        ; check for branch
02:E4D4 2A35            	   873:             bpl ckobra                  ; check for other than branch
                        	   874: ; 
                        	   875: ; relative branch type instruction 
                        	   876: ; determine where to put swi 
                        	   877: ; s- holds pointer to user stack after swi 
02:E4D6 32              	   878:             pula                        ; get condition code
02:E4D7 34              	   879:             des                         ; update stack pointer after pull
02:E4D8 8A10            	   880:             oraa #0b00010000            ; make int's inhibited
02:E4DA 06              	   881:             tap                         ; restore user's c. code reg
02:E4DB 7EBE0E          	   882:             jmp brins                   ; go see how relative branch
                        	   883: ; fares 
                        	   884: ; 
                        	   885: ; branch was nogo - put swi at next instruction 
                        	   886: ; 
02:E4DE 8602            	   887: brnogo:     ldaa #2                     ; a = # bytes after current instr
02:E4E0 2029            	   888:             bra ckobra                  ; go put swi appropriately
                        	   889: ; 
                        	   890: ; branch was go, put swi at address being 
                        	   891: ; jumped to 
                        	   892: ; 
02:E4E2 FEBE17          	   893: brgo:       ldx trcadr                  ; x : = trace address
02:E4E5 A601            	   894:             ldaa 1,x                    ; get branch offset
02:E4E7 08              	   895:             inx                         ; offset is relative to
02:E4E8 08              	   896:             inx                         ; instr following branch
02:E4E9 2B12            	   897:             bmi brgodc                  ; branch if offset negative
02:E4EB 8D16            	   898: brg1:       bsr incx_                   ; increment x by amount in
                        	   899: ; a reg 
02:E4ED FFBE17          	   900: brg2:       stx trcadr                  ; save address of next
                        	   901: ; instr to stop on 
02:E4F0 A600            	   902:             ldaa 0,x                    ; get instruction to be replaced
02:E4F2 B7BE19          	   903:             staa trcins                 ; save
02:E4F5 863F            	   904:             ldaa #swiop                 ; get swi op code
02:E4F7 A700            	   905:             staa 0,x                    ; replace instr with swi
02:E4F9 BEBE08          	   906:             lds sp                      ; get original stack pointer
02:E4FC 3B              	   907:             rti                         ; trace another instr
                        	   908: ; 
                        	   909: ; x needs to be decremented (offset negative) 
                        	   910: ; 
02:E4FD 09              	   911: brgodc:     dex                         ; decrement address
02:E4FE 4C              	   912:             inca                        ; increment counter
02:E4FF 26FC            	   913:             bne brgodc                  ; if counter not 0, branch
02:E501 20EA            	   914:             bra brg2                    ; if done, go return to user prog
                        	   915: ; 
                        	   916: ; subroutine to increment x by contents of a 
                        	   917: ; 
02:E503 4D              	   918: incx_:      tsta                        ; is a = 0?
02:E504 2704            	   919:             beq incxr                   ; if so, inc done
02:E506 08              	   920: inxlp:      inx                         ; else increment x
02:E507 4A              	   921:             deca                        ; decrement count
02:E508 26FC            	   922:             bne inxlp                   ; if count not yet 0, loop
02:E50A 39              	   923: incxr:      rts                         ; return from this subroutine
                        	   924: ; 
                        	   925: ; instruction to be traced is not a branch 
                        	   926: ; 
02:E50B FEBE17          	   927: ckobra:     ldx trcadr                  ; x : = trace address
02:E50E E600            	   928:             ldab 0,x                    ; get instr to be traced
02:E510 C16E            	   929:             cmpb #0x6e                  ; is it a jump, indexed?
02:E512 271A            	   930:             beq jmpidx                  ; yes, go simulate jump idxed
02:E514 C17E            	   931:             cmpb #0x7e                  ; jump, extended?
02:E516 271D            	   932:             beq jmpext
02:E518 C1AD            	   933:             cmpb #0xad                  ; jsr, indexed?
02:E51A 2712            	   934:             beq jmpidx                  ; (jump idxed is same as
                        	   935: ; transfer of control) 
02:E51C C1BD            	   936:             cmpb #0xbd                  ; jsr, extended?
02:E51E 2715            	   937:             beq jmpext
02:E520 C13B            	   938:             cmpb #0x3b                  ; rti?
02:E522 2715            	   939:             beq rtisim
02:E524 C139            	   940:             cmpb #0x39                  ; rts?
02:E526 2716            	   941:             beq rtssim
02:E528 C18D            	   942:             cmpb #0x8d                  ; bsr?
02:E52A 27B6            	   943:             beq brgo                    ; (branch processing)
                        	   944: ; 
                        	   945: ; not a branch, jump. rti, rts 
                        	   946: ; a register holds # bytes in instruction 
                        	   947: ; 
02:E52C 20BD            	   948:             bra brg1                    ; put in new swi and
                        	   949: ; trace next instruction 
                        	   950: ; 
                        	   951: ; jump, jsr indexed simulation 
                        	   952: ; 
02:E52E A601            	   953: jmpidx:     ldaa 1,x                    ; a : = address offset
02:E530 30              	   954:             tsx
02:E531 EE03            	   955:             ldx 3,x                     ; get targets x reg
02:E533 20B6            	   956:             bra brg1                    ; update x, trace next instr
                        	   957: ; 
                        	   958: ; jump, jsr extended 
                        	   959: ; 
02:E535 EE01            	   960: jmpext:     ldx 1,x                     ; get address to be jumped to
02:E537 20B4            	   961:             bra brg2                    ; go trace next instr.
                        	   962: ; 
                        	   963: ; rti encountered 
                        	   964: ; 
02:E539 30              	   965: rtisim:     tsx
02:E53A EE0C            	   966:             ldx 12,x                    ; get p-counter from stack
02:E53C 20AF            	   967:             bra brg2                    ; go trace next instr.
                        	   968: ; 
                        	   969: ; rts encountered 
                        	   970: ; 
02:E53E 30              	   971: rtssim:     tsx
02:E53F EE07            	   972:             ldx 7,x                     ; get return p-reg from stack
02:E541 20AA            	   973:             bra brg2                    ; go trace next instr
                        	   974: ; 
                        	   975: ; 
                        	   976: ; opbcyt 
                        	   977: ; 
                        	   978: ; this routine determines the # of bytes in an instruction 
                        	   979: ; given its op code. 
                        	   980: ; 
                        	   981: ; input: a holds the op code 
                        	   982: ; 
                        	   983: ; output: x holds the index of table element 
                        	   984: ; b not restored 
                        	   985: ; a holds # bytes in instruction 
                        	   986: ; except for branches in which case is negative 
                        	   987: ; 
                        	   988: ; 
                        	   989: ; 
                        	   990: opcbyt:
02:E543 16              	   991:             tab                         ; b:= op code
02:E544 44              	   992:             lsra
02:E545 44              	   993:             lsra
02:E546 44              	   994:             lsra                        ; put 4 upper bits of op code in
02:E547 44              	   995:             lsra                        ; lower 4 bits of a
                        	   996: ; 
02:E548 CEE561          	   997:             ldx #opbttb                 ; x:= address of table
02:E54B 8DB6            	   998:             bsr incx_                   ; increment x to point to correct
                        	   999: ; 
02:E54D A600            	  1000:             ldaa 0,x                    ; get table entry
02:E54F 260F            	  1001:             bne opbtrt                  ; if not 0 then no further
                        	  1002: ; processing needed 
                        	  1003: ; 
                        	  1004: ; if top 4 bits = 8 or c, then there are two classes 
                        	  1005: ; of instructions: 2 byte instructions and 
                        	  1006: ; ce, 8c and 8e which are 3 byte instructions 
                        	  1007: ; 
02:E551 8602            	  1008:             ldaa #2                     ; # bytes in most of 8# instructions
02:E553 C18C            	  1009:             cmpb #0x8c                  ; 3 byte instruction?
02:E555 2708            	  1010:             beq opbt3                   ; yes, update a
02:E557 C1CE            	  1011:             cmpb #0xce                  ; 3 byte instr?
02:E559 2704            	  1012:             beq opbt3                   ; yes, update a
02:E55B C18E            	  1013:             cmpb #0x8e                  ; 3 byte instruction?
02:E55D 2601            	  1014:             bne opbtrt                  ; no, return
                        	  1015: ; 
02:E55F 4C              	  1016: opbt3:      inca                        ; # bytes in instruction:=3
                        	  1017: ; 
02:E560 39              	  1018: opbtrt:     rts                         ; return to caller
                        	  1019: ; 
                        	  1020: ; op code to number of bytes conversion table 
                        	  1021: ; 
                        	  1022: ; # bytes top 4 bits of opcode 
                        	  1023: ; ------- -------------------- 
                        	  1024: ; 
                        	  1025: opbttb:
02:E561 01              	  1026:             .byte 1                     ; 0
02:E562 01              	  1027:             .byte 1                     ; 1
02:E563 82              	  1028:             .byte 2+0b10000000          ; 2 ( minus=> branches )
02:E564 01              	  1029:             .byte 1                     ; 3
02:E565 01              	  1030:             .byte 1                     ; 4
02:E566 01              	  1031:             .byte 1                     ; 5
02:E567 02              	  1032:             .byte 2                     ; 6
02:E568 03              	  1033:             .byte 3                     ; 7
02:E569 00              	  1034:             .byte 0                     ; 8 # bytes=2 except 8c,8e
02:E56A 02              	  1035:             .byte 2                     ; 9
02:E56B 02              	  1036:             .byte 2                     ; a
02:E56C 03              	  1037:             .byte 3                     ; b
02:E56D 00              	  1038:             .byte 0                     ; c # bytes = 2 except ce
02:E56E 02              	  1039:             .byte 2                     ; d
02:E56F 02              	  1040:             .byte 2                     ; e
02:E570 03              	  1041:             .byte 3                     ; f
