02:E2DE 08              	   459:             inx
02:E2DF 08              	   460:             inx
02:E2E0 8CE139          	   461:             cpx #fctben                 ; end of table reached?
02:E2E3 26F4            	   462:             bne nxtchr                  ; no, try next char
02:E2E5 20D3            	   463:             bra contrl                  ; no match, reprompt user
                        	   464: ; 
