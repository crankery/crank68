                        	    99: ; nam mikbug f
                        	   100: ; ttl 2.0 with audio cassette 
                        	   101: ; rev 0 
                        	   102: ; copyright (c) 1977 by motorola inc. 
                        	   103: ; 
                        	   104: ; mikbug (tm) motorola 
                        	   105: ; 
                        	   106: ; austin, texas 
                        	   107: ; microcomputer capital of the world! 
                        	   108: ; 
                        	   109: ; l load 
                        	   110: ; m memory change 
                        	   111: ; p print/punch dump 
                        	   112: ; r display contents of target stack 
                        	   113: ; cc b a x p s 
                        	   114: ; s 1,set speed for 10 cps 
                        	   115: ; 3,set speed for 30 cps 
                        	   116: ; b print out all breakpoints 
                        	   117: ; c continue execution from current location 
                        	   118: ; n next instruction 
                        	   119: ; t trace 'N' instructions 
                        	   120: ; g go to location 'N' 
                        	   121: ; d delete all breakpoints 
                        	   122: ; u reset breakpoint with address 'N' 
                        	   123: ; v set a breakpoint with address 'N' 
                        	   124: ; e exortape cassette interface 
                        	   125: ; 
                        	   126:             .equ swiop, 0x3f            ; swi op code
                        	   127: 
                        	   128:             .org 0xe000 ; slot 0
                        	   129: 
                        	   130:             .org 0xe010 ; slot 1
01:E010 00              	   131: acias:      .space 0x01
01:E011 00              	   132: aciad:      .space 0x01
                        	   133: 
                        	   134:             .org 0xe100
                        	   135: baseorg:    
                        	   136: 
                        	   137: ; 
                        	   138: ; i/o interrupt sequence 
                        	   139: ; 
02:E100 FEBE00          	   140: io:         ldx iov
02:E103 6E00            	   141:             jmp 0,x
                        	   142: ; 
                        	   143: ; nmi sequence 
                        	   144: ; 
02:E105 FEBE06          	   145: powdwn:     ldx nio                     ; get nmi vector
02:E108 6E00            	   146:             jmp 0,x
                        	   147: ; 
                        	   148: ; swi interrupt sequence 
                        	   149: ; 
02:E10A FEBE0A          	   150: sfei:       ldx swi1
02:E10D 6E00            	   151:             jmp 0,x
                        	   152: ; 
                        	   153: ; jump table to routines performing mikbug fctn's 
                        	   154: ; 
                        	   155: fctabl:
02:E10F 42              	   156:             .byte "B"                   ; "B" - print all breaks
02:E110 E316            	   157:             .word pntbrk
02:E112 43              	   158:             .byte "C"                   ; "C" - continue
02:E113 E354            	   159:             .word cont
02:E115 44              	   160:             .byte "D"                   ; "D" - delete all breaks
02:E116 E30B            	   161:             .word delbrk
02:E118 47              	   162:             .byte "G"                   ; "G" - go to entered address
02:E119 E325            	   163:             .word goto
02:E11B 4C              	   164:             .byte "L"                   ; "L" - load
02:E11C E1D0            	   165:             .word load
02:E11E 4D              	   166:             .byte "M"                   ; "M" - memory change
02:E11F E21D            	   167:             .word change
02:E121 4E              	   168:             .byte "N"                   ; "N" - next (trace 1 instr)
02:E122 E337            	   169:             .word next
02:E124 50              	   170:             .byte "P"                   ; "P" - punch
02:E125 E402            	   171:             .word punch
02:E127 52              	   172:             .byte "R"                   ; "R" - print stack
02:E128 E35C            	   173:             .word pstak1
02:E12A 53              	   174:             .byte "S"                   ; "S" - change speed for tty
02:E12B E2FE            	   175:             .word spd
02:E12D 54              	   176:             .byte "T"                   ; "T" - trace n instructions
02:E12E E350            	   177:             .word trace
02:E130 55              	   178:             .byte "U"                   ; "U" - reset a breakpoint
02:E131 E311            	   179:             .word rstbrk
02:E133 45              	   180:             .byte "E"                   ; "E" - exortape cassette interface
02:E134 E5FC            	   181:             .word exort
02:E136 56              	   182:             .byte "V"                   ; "V" - set a breakpoint
02:E137 E31D            	   183:             .word setbrk
                        	   184: fctben:
                        	   185: ; 
                        	   186: ; initialization/reset code 
                        	   187: ; 
                        	   188: adrstr:
02:E139 BFFF            	   189:             .word stack                 ; init for "SP"
02:E13B E476            	   190:             .word swi15                 ; init for "SWI1"
02:E13D E4A0            	   191:             .word brkinh                ; init for "SWI2"
                        	   192: ; 
02:E13F 2003            	   193:             bra brg                     ; "BRA" inst is replaced by
02:E141 7EE4DE          	   194:             jmp brnogo                  ; cond bra inst in rout.
02:E144 7EE4E2          	   195: brg:        jmp brgo                    ; which determines if
                        	   196: ; bra is go/nogo 
                        	   197: ; 
                        	   198: ; build address 
                        	   199: ; 
02:E147 8D0C            	   200: baddr:      bsr byte                    ; read 2 frames
02:E149 B7BE3E          	   201:             staa xhi
02:E14C 8D07            	   202:             bsr byte
02:E14E B7BE3F          	   203:             staa xlow
02:E151 FEBE3E          	   204:             ldx xhi                     ; (x) address we built
02:E154 39              	   205:             rts
                        	   206: ; input byte (two frames) 
02:E155 8D53            	   207: byte:       bsr inhex                   ; get hex char
02:E157 48              	   208: byte2:      asla
02:E158 48              	   209:             asla
02:E159 48              	   210:             asla
02:E15A 48              	   211:             asla
02:E15B 16              	   212:             tab
02:E15C 8D4C            	   213:             bsr inhex
02:E15E 1B              	   214:             aba
02:E15F 16              	   215:             tab
02:E160 FBBE3C          	   216:             addb cksm
02:E163 F7BE3C          	   217:             stab cksm
02:E166 39              	   218:             rts
02:E167 44              	   219: outhl:      lsra                        ; out hex left bcd digit
02:E168 44              	   220:             lsra
02:E169 44              	   221:             lsra
02:E16A 44              	   222:             lsra
02:E16B 840F            	   223: outhr:      anda #0xf                   ; out hex right bcd digit
02:E16D 8B30            	   224:             adda #0x30
02:E16F 8139            	   225:             cmpa #0x39
02:E171 2302            	   226:             bls outch
02:E173 8B07            	   227:             adda #0x7
                        	   228: ; output one char 
02:E175 7EE259          	   229: outch:      jmp outch1
02:E178 7EE266          	   230: inch:       jmp inch1
                        	   231: ; print data pointed at by x-reg 
02:E17B 8DF8            	   232: pdata2:     bsr outch
02:E17D 08              	   233:             inx
02:E17E A600            	   234: pdata1:     ldaa 0,x
02:E180 8104            	   235:             cmpa #4
02:E182 26F7            	   236:             bne pdata2
02:E184 39              	   237:             rts                         ; stop on eot
                        	   238: ; 
                        	   239: ; input address 
                        	   240: ; 
02:E185 8D17            	   241: getadd:     bsr pcrlf                   ; print cr lf
02:E187 CEE5A5          	   242:             ldx #mcl4
02:E18A 8DF2            	   243:             bsr pdata1                  ; ask for begaddr
02:E18C 8DB9            	   244:             bsr baddr                   ; get beg addr
02:E18E FFBE02          	   245:             stx bega
02:E191 8D0B            	   246:             bsr pcrlf                   ; print cr lf
02:E193 CEE5B0          	   247:             ldx #mcl5
02:E196 8DE6            	   248:             bsr pdata1                  ; ask for end addr
02:E198 8DAD            	   249:             bsr baddr                   ; get end address
02:E19A FFBE04          	   250:             stx enda
02:E19D 39              	   251:             rts                         ; *
                        	   252: ; print cr lf 
                        	   253: ; 
02:E19E FFBE3E          	   254: pcrlf:      stx xhi                     ; save xr
02:E1A1 CEE586          	   255:             ldx #mcl1
02:E1A4 8DD8            	   256:             bsr pdata1                  ; print crlf
02:E1A6 FEBE3E          	   257:             ldx xhi
02:E1A9 39              	   258:             rts
                        	   259: 
