02:E329 8D3F            	   524:             bsr brksub                  ; go put in breaks
02:E32B 30              	   525:             tsx
02:E32C B6BE3E          	   526:             ldaa xhi                    ; save pch on stack
02:E32F A705            	   527:             staa 5,x
02:E331 B6BE3F          	   528:             ldaa xlow                   ; push pcl
02:E334 A706            	   529:             staa 6,x
02:E336 3B              	   530:             rti                         ; go to user prg
                        	   531: ; 
                        	   532: ; single instruction trace requested 
