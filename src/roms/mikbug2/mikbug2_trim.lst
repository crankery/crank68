02:E222 FEBE3E          	   333: chang:      ldx xhi
02:E225 8DA3            	   334:             bsr out2hs                  ; print data old
02:E227 09              	   335:             dex
02:E228 8D3C            	   336: cha1:       bsr inch1                   ; input char
