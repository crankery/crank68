                        	   567: ; 
                        	   568: ; 
                        	   569: ; brksub 
                        	   570: ; 
                        	   571: ; 
                        	   572: ; this routine does a number of operations having 
                        	   573: ; to do with breakpoints. 
                        	   574: ; 
                        	   575: ; the a register determines function performed: 
                        	   576: ; 
                        	   577: ; a = -1 => breaks are put into user's code 
                        	   578: ; a = 0 => the breakpoint whose address is in 
                        	   579: ; xhi, xlo is purged; 
                        	   580: ; all breakpoints are temporarily removed 
                        	   581: ; a = 1 => all breakpoints are purged 
                        	   582: ; a = 2 => all breakpoints are printed out 
                        	   583: ; all breakpoints are temporarily removed 
                        	   584: ; a = 3 => all breakpoints are temporarily removed 
                        	   585: ; a = 4 => the break address in xhi, xlo is 
                        	   586: ; put into the first zero breakpoint 
                        	   587: ; position; all breaks are temporarily removed 
                        	   588: ; 
                        	   589: ; 
                        	   590: ; 
                        	   591: brksub:
02:E36A BFBE40          	   592:             sts ssave                   ; save s so we can use
02:E36D B7BE3C          	   593:             staa asave                  ; a holds the function #
                        	   594: ; 
02:E370 CEBE1C          	   595:             ldx #brkadr                 ; init x for loop through breaks
                        	   596: ; 
                        	   597: ; start of loop through break addresses 
                        	   598: ; 
02:E373 B6BE3C          	   599: brklp:      ldaa asave                  ; get function #
02:E376 AE00            	   600:             lds 0,x                     ; s:=next address in brrkpt list
02:E378 272D            	   601:             beq ln                      ; if 0, then not a valid break
                        	   602: ; 
02:E37A 7DBE42          	   603:             tst brksin                  ; are breaks in user's code?
02:E37D 2736            	   604:             beq nobrin                  ; branch, if not
                        	   605: ; 
                        	   606: ; breaks are in user's code 
                        	   607: ; 
02:E37F 4D              	   608:             tsta                        ; should breaks be in?
02:E380 2B21            	   609:             bmi bkdone                  ; yes, return to caller
                        	   610: ; 
                        	   611: ; breaks are to be taken out of user's 
                        	   612: ; code temporarily 
                        	   613: ; 
02:E382 A610            	   614: brk2:       ldaa 2*nbrbpt,x             ; get instr. belong-
                        	   615: ; ing in user code 
02:E384 36              	   616:             psha                        ; put it there
                        	   617: ; 
                        	   618: ; other loop actions to be performed each time through 
                        	   619: ; loop when break address not equal to 0. 
                        	   620: ; 
02:E385 B6BE3C          	   621: bkcon1:     ldaa asave                  ; what function is to be done
02:E388 2737            	   622:             beq fndrpl                  ; see if breakpoint needs to
                        	   623: ; be replaced 
02:E38A 8101            	   624:             cmpa #1                     ; is break address to be reset?
02:E38C 2741            	   625:             beq clrbrk                  ; yes, set brkadr to 0
                        	   626: ; 
02:E38E 8102            	   627:             cmpa #2                     ; is brk addr to be printed?
02:E390 2749            	   628:             beq prntbk                  ; yes, go print address
                        	   629: ; 
                        	   630: ; update loop index and loop if appropriate 
                        	   631: ; 
02:E392 08              	   632: bkcon2:     inx                         ; make x point to
02:E393 08              	   633:             inx                         ; next break address
02:E394 8CBE2C          	   634: bkcon3:     cpx #brkins                 ; any more breaks?
02:E397 26DA            	   635:             bne brklp                   ; yes,loop
                        	   636: ; 
                        	   637: ; wrap-up processing and exit 
                        	   638: ; 
02:E399 4F              	   639:             clra                        ; a = breaks in flag
02:E39A 7DBE3C          	   640:             tst asave                   ; is function = -1?
02:E39D 2A01            	   641:             bpl bkput                   ; no, so brksin = 0
02:E39F 4C              	   642:             inca                        ; fctn = -1 => brksin:=1
02:E3A0 B7BE42          	   643: bkput:      staa brksin                 ; store appropriate flag
                        	   644: ; 
                        	   645: ; restore s-reg and return to caller 
                        	   646: ; 
02:E3A3 BEBE40          	   647: bkdone:     lds ssave                   ; restore user s-reg
02:E3A6 39              	   648:             rts                         ; return
                        	   649: ; 
                        	   650: ; 
                        	   651: ; miscellaneous routines for brksub 
                        	   652: ; 
                        	   653: ; breakpoint address = 0 - if function = 4 then 
                        	   654: ; put breakpoint address in current position 
                        	   655: ; a holds the function #, x holds breakpoint index 
                        	   656: ; 
02:E3A7 8104            	   657: ln:         cmpa #4                     ; is function = 4
02:E3A9 26E7            	   658:             bne bkcon2                  ; if not, then continue loop
                        	   659: ; 
02:E3AB BEBE3E          	   660:             lds xhi                     ; get new break address
02:E3AE AF00            	   661:             sts 0,x                     ; put in current position
                        	   662: ; 
02:E3B0 7ABE3C          	   663:             dec asave                   ; do not place address more
                        	   664: ; than once-cont to 
                        	   665: ; take out breakpoints 
02:E3B3 20DD            	   666:             bra bkcon2                  ; continue loop
                        	   667: ; 
                        	   668: ; breaks are not in and address is non-zero. 
                        	   669: ; if function = -1 then swi's are to be put in. 
                        	   670: ; a holds function number, s holds address 
                        	   671: ; 
02:E3B5 4D              	   672: nobrin:     tsta                        ; is function = -1
02:E3B6 2ACD            	   673:             bpl bkcon1                  ; no, continue
                        	   674: ; 
02:E3B8 34              	   675:             des                         ; make address point to 1 less
02:E3B9 32              	   676:             pula                        ; get user instruction
02:E3BA A710            	   677:             staa 2*nbrbpt,x             ; save
02:E3BC 863F            	   678:             ldaa #swiop                 ; get swi op code
02:E3BE 36              	   679:             psha                        ; replace user instruction
02:E3BF 20D1            	   680:             bra bkcon2                  ; continue loop
                        	   681: ; 
                        	   682: ; function=0 brk addr not = 0, user's instr 
                        	   683: ; is in (not swi). 
                        	   684: ; if address = xhi,xlo then set address = 0 
02:E3C1 A600            	   685: fndrpl:     ldaa 0,x                    ; get top byte of address
02:E3C3 B1BE3E          	   686:             cmpa xhi                    ; do top bytes compare
02:E3C6 26CA            	   687:             bne bkcon2                  ; no,continue loop
02:E3C8 E601            	   688:             ldab 1,x                    ; get low byte of addr
02:E3CA F1BE3F          	   689:             cmpb xlow                   ; same for low bytes
02:E3CD 26C3            	   690:             bne bkcon2
                        	   691: ; 
02:E3CF 6F00            	   692: clrbrk:     clr 0,x                     ; clear out break
02:E3D1 6F01            	   693:             clr 1,x                     ; address field
02:E3D3 20BD            	   694:             bra bkcon2                  ; continue loop
                        	   695: ; 
                        	   696: ; 
02:E3D5 7EE1CA          	   697: ot2hs:      jmp out2hs
02:E3D8 7EE1C8          	   698: ot4hs:      jmp out4hs
                        	   699: ; 
                        	   700: ; 
