02:E695 8639            	  1260:             ldaa #0x39                  ; insert rts
02:E697 B7BE4D          	  1261:             staa clll
                        	  1262: ; fall into getload 
                        	  1263: ; 
                        	  1264: ; getload searches for the desired file, 
                        	  1265: ; then loads it into ram 
                        	  1266: ; 
                        	  1267: ; ram: q, r, s, h, l (scratch) 
                        	  1268: ; totcnt, fidh, fidl (perm) 
                        	  1269: ; 
02:E69A BDE872          	  1270: getloa:     jsr lsetup                  ; set up pia
02:E69D 8D5E            	  1271:             bsr getfil                  ; search for correct file
02:E69F 2722            	  1272:             beq get4                    ; out iff escaped
02:E6A1 8D54            	  1273: get2:       bsr startv                  ; get the next record-type
02:E6A3 271E            	  1274:             beq get4                    ; out if escape
02:E6A5 C120            	  1275:             cmpb #0x20                  ; trailerecord?
02:E6A7 270A            	  1276:             beq get1
02:E6A9 C110            	  1277:             cmpb #0x10                  ; dumpagerecord?
02:E6AB 26F4            	  1278:             bne get2
02:E6AD 8D15            	  1279:             bsr dumpr                   ; bring it in!
02:E6AF 2712            	  1280:             beq get4                    ; out iff escape
02:E6B1 20EE            	  1281:             bra get2
02:E6B3 7DBE53          	  1282: get1:       tst v                       ; check page count
02:E6B6 270B            	  1283:             beq get4
02:E6B8 2B04            	  1284:             bmi get3
02:E6BA 862D            	  1285:             ldaa #'-'                   ;  '-'  for missing page(s)
02:E6BC 2002            	  1286:             bra get5
02:E6BE 862B            	  1287: get3:       ldaa #'+'                   ;  '+'  for extra page(s)
02:E6C0 BDE175          	  1288: get5:       jsr outch                   ; print it!
02:E6C3 39              	  1289: get4:       rts                         ; return
                        	  1290: ; 
                        	  1291: ; dumpr brings in a dumpage record 
                        	  1292: ; 
                        	  1293: ; ram: h, l (scratch) 
                        	  1294: ; regs: acca, accb (scratch); ix (perm) 
                        	  1295: ; exit: falls into crck 
                        	  1296: ; 
02:E6C4 8D2E            	  1297: dumpr:      bsr ldv                     ; get page number
02:E6C6 F7BE4E          	  1298:             stab h                      ; )
02:E6C9 7FBE4F          	  1299:             clr l                       ; ) load ix!
02:E6CC FEBE4E          	  1300:             ldx h                       ; )
02:E6CF 8D23            	  1301: dum1:       bsr ldv
02:E6D1 2749            	  1302:             beq g2                      ; out iff escape
02:E6D3 BDBE4B          	  1303:             jsr cl                      ; check, or load
02:E6D6 08              	  1304:             inx                         ; storage ptr
02:E6D7 7CBE4F          	  1305:             inc l                       ; byte count
02:E6DA 26F3            	  1306:             bne dum1
02:E6DC 7ABE53          	  1307:             dec v                       ; page count
                        	  1308: ; fall into crck 
                        	  1309: ; 
                        	  1310: ; crck shecks the crc and print a char 
                        	  1311: ; 
                        	  1312: ; ram: q, r, s, totcnt (from loadbyte) 
                        	  1313: ; regs: acca (scratch, accb (from loadbyte) 
                        	  1314: ; 
02:E6DF 8D13            	  1315: crck:       bsr ldv                     ; ) input crc chars
02:E6E1 8D11            	  1316:             bsr ldv                     ; )
02:E6E3 B6BE51          	  1317:             ldaa r                      ; check crc registers
02:E6E6 BABE52          	  1318:             oraa s
02:E6E9 2604            	  1319:             bne crck1
02:E6EB 8647            	  1320:             ldaa #'G'                   ;  print g for good crc
02:E6ED 2002            	  1321:             bra crck2
02:E6EF 8642            	  1322: crck1:      ldaa #'B'                   ;  print b for bad crc
02:E6F1 7EE86F          	  1323: crck2:      jmp ttyo1                   ; print it!
02:E6F4 7EE866          	  1324: ldv:        jmp loadbv                  ; get a tape byte in accb
02:E6F7 2024            	  1325: startv:     bra startf
                        	  1326: ; 
                        	  1327: ; getfile looks for: 
                        	  1328: ; 1) a start sequence 
                        	  1329: ; 2) a headerecord type 
                        	  1330: ; 3) a file id match with fidh, fidl 
                        	  1331: ; and returns when found, or escaped 
                        	  1332: ; 
                        	  1333: ; regs: acca, accb (scratch only) 
                        	  1334: ; 
02:E6F9 8658            	  1335: g1:         ldaa #'X'                   ;  indicate wrong file found
02:E6FB 8DF4            	  1336:             bsr crck2                   ; send char to tty
02:E6FD 8D1E            	  1337: getfil:     bsr startf
02:E6FF 271B            	  1338:             beq g2                      ; out iff escape
02:E701 C108            	  1339:             cmpb #0x08                  ; headerecord-type?
02:E703 26F8            	  1340:             bne getfil                  ; branch if not
02:E705 8DED            	  1341:             bsr ldv                     ; get byte in accb
02:E707 F1BE45          	  1342:             cmpb fidh                   ; good file id(h)?
02:E70A 26ED            	  1343:             bne g1
02:E70C 8DE6            	  1344:             bsr ldv
02:E70E F1BE46          	  1345:             cmpb fidl                   ; good file id(l)?
02:E711 26E6            	  1346:             bne g1
02:E713 8648            	  1347:             ldaa #'H'                   ;  indicate header found
02:E715 8DDA            	  1348:             bsr crck2
02:E717 8DDB            	  1349:             bsr ldv
02:E719 F7BE53          	  1350:             stab v                      ; store page count
02:E71C 39              	  1351: g2:         rts
                        	  1352: ; 
                        	  1353: ; startfind looks for the 16-bit start sequence 89af 
                        	  1354: ; returns with the next byte, the record type, 
                        	  1355: ; in q and accb. 
                        	  1356: ; 
                        	  1357: ; ram: q, r, s, totcnt (perm), h (scratch) 
                        	  1358: ; regs: acca, accb (scratch only) 
                        	  1359: ; exit: falls into loadbyte, which 
                        	  1360: ; falls into loadbit, which 
                        	  1361: ; falls into crc 
                        	  1362: ; escape: esc in command port gets out 
                        	  1363: ; (test done in crc) 
                        	  1364: ; 
02:E71D 7FBE4E          	  1365: startf:     clr h                       ; accumulates 16 bits
02:E720 7FBE50          	  1366:             clr q
02:E723 78BE50          	  1367: sta1:       asl q                       ; shift the 16-bit register
02:E726 79BE4E          	  1368:             rol h
02:E729 8D24            	  1369:             bsr loadb1
02:E72B 27EF            	  1370:             beq g2                      ; out iff escaped
02:E72D B6BE4E          	  1371:             ldaa h
02:E730 F6BE50          	  1372:             ldab q
02:E733 8189            	  1373:             cmpa #0x89                  ; start sequence
02:E735 26EC            	  1374:             bne sta1
02:E737 C1AF            	  1375:             cmpb #0xaf
02:E739 26E8            	  1376:             bne sta1
02:E73B 7FBE51          	  1377: sta2:       clr r                       ; clear the crc register
02:E73E 7FBE52          	  1378:             clr s
                        	  1379: ; fall into loadbyte to return a byte 
                        	  1380: ; 
                        	  1381: ; loadbyte recovers of data in q and accb, and does crc 
                        	  1382: ; 
                        	  1383: ; ram: q, r, s, totcnt (perm) 
                        	  1384: ; regs: acca, accb (scratch only) 
                        	  1385: ; exit: falls into loadbit, which 
                        	  1386: ; falls into crc 
                        	  1387: ; 
02:E741 C602            	  1388: loadby:     ldab #0x02                  ; set stop
02:E743 F7BE50          	  1389:             stab q
02:E746 8D07            	  1390: load1:      bsr loadb1
02:E748 27D2            	  1391:             beq g2                      ; out iff escape
02:E74A 78BE50          	  1392:             asl q                       ; stop into carry?
02:E74D 24F7            	  1393:             bcc load1                   ; branch if no
                        	  1394: ; fall into loadbit for last bit 
                        	  1395: ; 
                        	  1396: ; loadbit recovers one bit of data in q and accb, 
                        	  1397: ; and does crc in r and s 
                        	  1398: ; 
                        	  1399: ; ram: q, r, s, totcnt (perm) 
                        	  1400: ; regs: acca, accb (scratch only) 
                        	  1401: ; exit: branches or falls into crc routine 
                        	  1402: ; data bit goes into q lsb 
                        	  1403: ; 
02:E74F 5F              	  1404: loadb1:     clrb
02:E750 5A              	  1405: loadb6:     decb
02:E751 271F            	  1406:             beq loadb5
02:E753 8D43            	  1407:             bsr tain1v                  ; get tape data in carry
02:E755 25F9            	  1408:             bcs loadb6                  ; wait for low
02:E757 5A              	  1409: loadb2:     decb
02:E758 2718            	  1410:             beq loadb5
02:E75A 8D3C            	  1411:             bsr tain1v                  ; wait for high
02:E75C 24F9            	  1412:             bcc loadb2                  ; ) (front of sync el)
02:E75E F6BE49          	  1413:             ldab totcnt                 ; 3.5 els delay
02:E761 5A              	  1414: loadb3:     decb
02:E762 270E            	  1415:             beq loadb5
02:E764 8D32            	  1416:             bsr tain1v                  ; ) wait for low
02:E766 25F9            	  1417:             bcs loadb3                  ; ) (end of sync el)
02:E768 5A              	  1418: loadb4:     decb
02:E769 2707            	  1419:             beq loadb5                  ; done yet?
02:E76B 8D2B            	  1420:             bsr tain1v
02:E76D 24F9            	  1421:             bcc loadb4
02:E76F 7CBE50          	  1422:             inc q                       ; store a '1'  bit
02:E772 B6BE50          	  1423: loadb5:     ldaa q                      ; get data for crc
                        	  1424: ; fall into crc1 
                        	  1425: ; 
                        	  1426: ; crc enters a bit into crc registers r and s 
                        	  1427: ; uses crc polynomial: x16 + x15 + x2 + x0 
                        	  1428: ; 
                        	  1429: ; entry: acca holds new bit 
                        	  1430: ; ram: r, s (perm) 
                        	  1431: ; regs: acca, accb (scratch) 
                        	  1432: ; exit: accb = q, z = 1 iff esc 
                        	  1433: ; 
02:E775 46              	  1434: crc1:       rora                        ; lsb into carry
02:E776 46              	  1435:             rora                        ; carry into msb
02:E777 8480            	  1436: crc2:       anda #0x80                  ; mask msb (data bit)
02:E779 B8BE51          	  1437:             eora r                      ; enter data bit
02:E77C F6BE52          	  1438:             ldab s
02:E77F 58              	  1439:             aslb                        ; shift 16 bits left
02:E780 49              	  1440:             rola
02:E781 2404            	  1441:             bcc crc3                    ; if b16 high. . .
02:E783 8880            	  1442:             eora #0x80                  ; enter crc polynomial
02:E785 C805            	  1443:             eorb #0x05
02:E787 B7BE51          	  1444: crc3:       staa r
02:E78A F7BE52          	  1445:             stab s
02:E78D F6BE50          	  1446:             ldab q
02:E790 BDE86C          	  1447:             jsr ttyin1                  ; check for escape
02:E793 847F            	  1448:             anda #0x7f                  ; mask parity
02:E795 811B            	  1449:             cmpa #esc
02:E797 39              	  1450:             rts
02:E798 7EE860          	  1451: tain1v:     jmp tain1
                        	  1452: ; 
                        	  1453: ; byteout sends byte in acca to tape 
                        	  1454: ; 
                        	  1455: ; ram: r, s (changed in crc) 
                        	  1456: ; regs: acca, accb (destroyed) 
                        	  1457: ; exit: acca = 0, accb undefined 
                        	  1458: ; 
                        	  1459: ; acca = data byte (shifted) 
                        	  1460: ; accb = recording pattern (one bit) 
                        	  1461: ; 
02:E79B 36              	  1462: byteou:     psha                        ; save the data byte
02:E79C 8DD9            	  1463:             bsr crc2                    ; ) do the crc first
02:E79E 32              	  1464:             pula                        ; recover the data byte
02:E79F 0D              	  1465:             sec                         ; set stop
02:E7A0 49              	  1466:             rola                        ; data bit into carry
02:E7A1 2006            	  1467:             bra by2
02:E7A3 32              	  1468: by1:        pula                        ; recover from done test
02:E7A4 36              	  1469:             psha                        ; save shifting byte
02:E7A5 8DD0            	  1470:             bsr crc2
02:E7A7 32              	  1471:             pula                        ; recover shifting byte
02:E7A8 48              	  1472:             asla                        ; data bit into carry
02:E7A9 C60A            	  1473: by2:        ldab #0x0a                  ; recording pattern
02:E7AB BDE863          	  1474: by3:        jsr taou1                   ; send accb to tape
02:E7AE 37              	  1475:             pshb                        ; save pattern
02:E7AF F6BE4A          	  1476:             ldab patdel                 ; element delay
02:E7B2 5A              	  1477: by4:        decb
02:E7B3 26FD            	  1478:             bne by4                     ; branch if element not done
02:E7B5 33              	  1479:             pulb                        ; recover pattern
02:E7B6 59              	  1480:             rolb                        ; next element (data from carry)
02:E7B7 24F2            	  1481:             bcc by3                     ; branch if pattern not done
02:E7B9 36              	  1482:             psha                        ; save data byte before test
02:E7BA 48              	  1483:             asla                        ; test acca
02:E7BB 26E6            	  1484:             bne by1                     ; branch if byte not done
02:E7BD 31              	  1485: by5:        ins                         ; restore stack
02:E7BE 39              	  1486:             rts
                        	  1487: ; 
                        	  1488: ; preamble sends out alc bits, and the start sequence, 
                        	  1489: ; then inits the crc registers 
                        	  1490: ; 
                        	  1491: ; ram: r, s (changed) 
                        	  1492: ; regs: acca, accb (destroyed) 
                        	  1493: ; exit: acca = 0, accb undefined 
                        	  1494: ; 
02:E7BF 8D2E            	  1495: preamb:     bsr bytov1                  ; alc bits
02:E7C1 8D2C            	  1496:             bsr bytov1
02:E7C3 8689            	  1497:             ldaa #0x89                  ; start sequence (h)
02:E7C5 8D28            	  1498:             bsr bytov1
02:E7C7 86AF            	  1499:             ldaa #0xaf                  ; start sequence (l)
02:E7C9 8D24            	  1500:             bsr bytov1
02:E7CB 7FBE51          	  1501:             clr r                       ; ) clear the crc registers
02:E7CE 7FBE52          	  1502:             clr s                       ; )
02:E7D1 39              	  1503:             rts
                        	  1504: ; 
                        	  1505: ; headerecord sends alc bits, the start sequence, 
                        	  1506: ; headrecord-type, file id, and the number of 
                        	  1507: ; pages to be dumped 
                        	  1508: ; 
                        	  1509: ; ram: fidh, fidl (unmodified) 
                        	  1510: ; r, s (changed) 
                        	  1511: ; regs: acca, accb (destroyed) 
                        	  1512: ; exit: acca = 0, accb undefined 
                        	  1513: ; 
02:E7D2 8D1B            	  1514: header:     bsr bytov1                  ; alc bits
02:E7D4 8D19            	  1515:             bsr bytov1
02:E7D6 8DE7            	  1516:             bsr preamb                  ; start a record
02:E7D8 8608            	  1517:             ldaa #0x08                  ; headertype
02:E7DA 8D13            	  1518:             bsr bytov1
02:E7DC B6BE45          	  1519:             ldaa fidh                   ; file id(h)
02:E7DF 8D0E            	  1520:             bsr bytov1
02:E7E1 B6BE46          	  1521:             ldaa fidl                   ; file id(l)
02:E7E4 8D09            	  1522:             bsr bytov1
02:E7E6 B6BE48          	  1523:             ldaa stoppg                 ; stopage
02:E7E9 B0BE47          	  1524:             suba startp                 ; startpage
02:E7EC 4C              	  1525:             inca
02:E7ED 8D00            	  1526:             bsr bytov1                  ; send # pages
02:E7EF 7EE869          	  1527: bytov1:     jmp byteov                  ; extra bits
                        	  1528: ; 
                        	  1529: ; trailerecord sends a trailerecord to tape 
                        	  1530: ; 
                        	  1531: ; ram: r, s (perm) 
                        	  1532: ; regs: acca, abbc (destroyed) 
                        	  1533: ; 
02:E7F2 8DCB            	  1534: trailr:     bsr preamb                  ; start a record
