02:E1AA 8DCC            	   261: inhex:      bsr inch
02:E1AC 8030            	   262: inhex2:     suba #0x30
02:E1AE 2B6A            	   263:             bmi c1                      ; not hex
02:E1B0 8109            	   264:             cmpa #0x09
02:E1B2 2F0A            	   265:             ble in1hg
02:E1B4 8111            	   266:             cmpa #0x11
02:E1B6 2B62            	   267:             bmi c1                      ; not hex
02:E1B8 8116            	   268:             cmpa #0x16
02:E1BA 2E5E            	   269:             bgt c1                      ; not hex
02:E1BC 8007            	   270:             suba #7
02:E1BE 39              	   271: in1hg:      rts
                        	   272: ; 
02:E1BF A600            	   273: out2h:      ldaa 0,x                    ; output 2 hex char
02:E1C1 8DA4            	   274: out2ha:     bsr outhl                   ; out left hex char
02:E1C3 A600            	   275:             ldaa 0,x                    ; pick up byte again
02:E1C5 08              	   276:             inx
02:E1C6 20A3            	   277:             bra outhr                   ; output right hex char and rts
02:E1C8 8DF5            	   278: out4hs:     bsr out2h                   ; output 4 hex char + space
02:E1CA 8DF3            	   279: out2hs:     bsr out2h                   ; output 2 hex char + space
02:E1CC 8620            	   280: outs:       ldaa #0x20                  ; space
02:E1CE 20A5            	   281:             bra outch                   ; (bsr & rts)
                        	   282: load:
02:E1D0 8611            	   283:             ldaa #021
02:E1D2 8DA1            	   284:             bsr outch                   ; output char
                        	   285: ; 
                        	   286: ; turn reader relay on 
                        	   287: ; 
02:E1D4 B6BE44          	   288:             ldaa aciat                  ; get acia control reg format
02:E1D7 8A40            	   289:             oraa #0x40                  ; set rts to turn rdr relay on
02:E1D9 B7E010          	   290:             staa acias                  ; turn it on
                        	   291: ; 
02:E1DC 7CBE16          	   292:             inc outsw                   ; do not echo tape
                        	   293: ; 
02:E1DF 8D97            	   294: load3:      bsr inch
02:E1E1 2003            	   295:             bra load4
02:E1E3 7EE2A4          	   296: enter:      jmp ent1                    ; mikbug 1 entry point
                        	   297: load4:
02:E1E6 8153            	   298:             cmpa #'S'
02:E1E8 26F5            	   299:             bne load3                   ; 1st char not (s)
02:E1EA 8D8C            	   300:             bsr inch                    ; read char
02:E1EC 8139            	   301:             cmpa #'9'
02:E1EE 272A            	   302:             beq c1
02:E1F0 8131            	   303:             cmpa #'1'
02:E1F2 26EB            	   304:             bne load3                   ; 2nd char not (1)
02:E1F4 7FBE3C          	   305:             clr cksm                    ; zero checksum
02:E1F7 BDE155          	   306:             jsr byte                    ; read byte
02:E1FA 8002            	   307:             suba #2
02:E1FC B7BE3D          	   308:             staa bytect                 ; byte count
                        	   309: ; build address 
02:E1FF BDE147          	   310:             jsr baddr
