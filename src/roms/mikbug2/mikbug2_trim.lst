02:E202 BDE155          	   312: load11:     jsr byte
02:E205 7ABE3D          	   313:             dec bytect
02:E208 2709            	   314:             beq load15                  ; zero byte count
02:E20A A700            	   315:             staa 0,x                    ; store data
02:E20C A100            	   316:             cmpa 0,x                    ; check data
