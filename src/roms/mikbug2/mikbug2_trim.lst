02:E843 847F            	  1592:             anda #0x7f
02:E845 811B            	  1593:             cmpa #esc
02:E847 2708            	  1594:             beq mast3
02:E849 F6BE48          	  1595:             ldab stoppg                 ; get stopage
02:E84C F1BE4E          	  1596:             cmpb h                      ; present page
