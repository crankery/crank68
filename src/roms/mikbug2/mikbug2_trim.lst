                        	   794: ; swi-1 software interrupt level 1 processing 
                        	   795: ; 
                        	   796: swi15:
02:E476 BFBE08          	   797:             sts sp                      ; save user's sp
                        	   798: ; 
02:E479 8603            	   799:             ldaa #3
