02:E808 FEBE4E          	  1552:             ldx h                       ; point at the data
02:E80B A600            	  1553: dump1:      ldaa 0,x
02:E80D 8DE0            	  1554:             bsr bytov1                  ; send data
02:E80F 08              	  1555:             inx
02:E810 7CBE4F          	  1556:             inc l                       ; byte ctr
02:E813 26F6            	  1557:             bne dump1
