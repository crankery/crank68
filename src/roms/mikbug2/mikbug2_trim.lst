                        	   536: ; is due to break 
02:E33D FFBE1A          	   537: trace3:     stx ntrace                  ; save # inst's to trace
                        	   538: ; is due to break 
02:E340 FEBE08          	   539:             ldx sp                      ; x : = stack pointer
02:E343 EE06            	   540:             ldx 6,x                     ; x : = address of instr to be ex
02:E345 FFBE17          	   541:             stx trcadr                  ; save in trace address store
02:E348 A600            	   542:             ldaa 0,x                    ; get instruction to be traced
02:E34A B7BE19          	   543:             staa trcins                 ; save in trace instruction store
02:E34D 7EE4CB          	   544:             jmp contrc                  ; go to continue trace part of
                        	   545: ; 
