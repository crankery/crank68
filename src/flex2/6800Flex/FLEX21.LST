1723 b6d7 bd be 86              	JSR	VERIFY		YES: VERIFY SEC WRITTEN
1724 b6da 26 02                 	BNE	WRSEC3		ERROR: HANDLE
1725 b6dc 0c                    WRSEC2	CLC			SET FLAG FOR NO ERROR
1726 b6dd 39                    	RTS			RETURN
