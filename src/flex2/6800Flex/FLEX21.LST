1653                            * READ SINGLE SECTOR
1654                            *
1655 b660 8d 27                 RDSSEC	BSR	RDSEC5		CLEAR BYTES
1656 b662 fe b4 0b              	LDX	CFCBAD		POINT TO FCB
1657 b665 bd be 8c              	JSR	DRVSEL		SELECT DRIVE
1658 b668 25 0f                 	BCS	RDSEC3		ERROR? YES,RTS
1659 b66a 8d 0e                 RDSEC1	BSR	RDSEC4		SET CFCBAD TO SEC BUFFER
1660 b66c bd be 80              	JSR	READ		READ SECTOR
1661 b66f 26 02                 	BNE	RDSEC2		ERRORS: HANDLE THEM
1662 b671 0c                    	CLC			CLEAR ERROR FLAG
1663 b672 39                    	RTS			RETURN
1664 b673 37                    RDSEC2	PSHB			SAVE STATUS
1665 b674 8d 1b                 	BSR	RDSEC6		ERROR HANDLER
1666 b676 33                    	PULB			RESTORE STATUS
1667 b677 24 f1                 	BCC	RDSEC1		IF OKAY THEN TRY AGAIN
1668 b679 39                    RDSEC3	RTS			RETURN
