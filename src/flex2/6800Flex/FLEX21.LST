1712                            *
1713 b6be 8d c9                 WRSSEC	BSR	RDSEC5		CLEAR ATTEMPT AND RESTORE COUNTERS
1714 b6c0 fe b4 0b              	LDX	CFCBAD		POINT TO FCB
1715 b6c3 bd be 8c              	JSR	DRVSEL		SELECT DRIVE
1716 b6c6 25 20                 	BCS	WRSEC4		ERROR: ATTEND TO IT
1717 b6c8 fe b4 0b              WRSEC1	LDX	CFCBAD		POINT TO FCB
1718 b6cb 8d ad                 	BSR	RDSEC4		SET CFCBAD TO SEC BUFFER
1719 b6cd bd be 83              	JSR	WRITE		WRITE SECTOR
1720 b6d0 26 0c                 	BNE	WRSEC3		ERROR: HANDLE IT
1721 b6d2 b6 b4 35              	LDAA	VERFLG		NO: VERIFY FLAG?
