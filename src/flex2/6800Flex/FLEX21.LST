1673 b67a fe b4 0b              RDSEC4	LDX	CFCBAD		GET ADDRESS OF FCB
1674 b67d a6 1e                 	LDAA	30,X		GET CURRENT TRACK ADDRESS
1675 b67f e6 1f                 	LDAB	31,X		GET CURRENT SECTOR ADDRESS
1676 b681 37                    	PSHB			SAVE SECTOR
