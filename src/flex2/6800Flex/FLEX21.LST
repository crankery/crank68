1744 b6fb c1 7f                 	CMPB	#127		=127?
1745 b6fd 26 0c                 	BNE	WRBUF3		NO: OKAY RETURN
1746 b6ff 20 0c                 	BRA	WRBUF4		YES: WRITE OUT CODE
1747 b701 8d 0a                 WRBUF1	BSR	WRBUF4		WRITE OUT SPACE COMPRESSION
1748 b703 24 e8                 	BCC	WRBUF		NO ERRORS CONTINUE
1749 b705 39                    	RTS			RETURN
