1728 b6e0 26 09                 	BNE	WRSEC6		YES: SAY SO
1729 b6e2 37                    	PSHB			SAVE ERROR CODE
1730 b6e3 8d ac                 	BSR	RDSEC6		ERROR HANDLING ROUTINE
1731 b6e5 33                    	PULB			RESTORE STATUS
1732 b6e6 24 e0                 	BCC	WRSEC1		TRY AGAIN IF OKAY
1733 b6e8 39                    WRSEC4	RTS			RETURN
1734 b6e9 c6 20                 WRSEC5	LDAB	#$20		SET FOR WRITE FAULT
1735 b6eb 0d                    WRSEC6	SEC			SET ERROR FLAG
1736 b6ec 39                    	RTS			RETURN
