1599                            * REWIND FILE
1600                            *
1601 b608 bd ba d5              REWFIL	JSR	NXTSQ6		WRITE OUT CURRENT SECTOR
1602 b60b 25 09                 	BCS	REWFI1		IF ERROR THEN REPORT IT
1603 b60d 16                    	TAB			PUT FILE STATUS INTO B
1604 b60e 54                    	LSRB			OPEN FOR READ?
1605 b60f 24 05                 	BCC	REWFI1		NO: ERROR
1606 b611 a7 00                 	STAA	0,X		YES: STORE IN COMMAND BYTE
1607 b613 7e b9 cb              	JMP	OPENR2		RE-OPEN FILE
1608 b616 c6 12                 REWFI1	LDAB	#$12		SYSTEM FILE STATUS ERROR
1609 b618 0d                    	SEC			SEC CARRY FOR ERROR FLAG
1610 b619 39                    	RTS			RETURN
1611                            *
1612                            * GET DATA INDEX ( BYTE 34 OF FCB )
1613                            *
1614 b61a fe b4 0b              DINDEX	LDX	CFCBAD		GET FCB ADDRESS
1615 b61d e6 22                 	LDAB	34,X		GET DATA INDEX
1616 b61f 27 09                 	BEQ	DINDX2		IF ZERO READ NEXT SECTOR
1617 b621 6c 22                 	INC	34,X		INCREMENT DATA INDEX
1618 b623 bd b5 83              DINDX1	JSR	FMS26		ADD B-REG TO X-REG
1619 b626 a6 40                 	LDAA	64,X		GET BYTE FROM SEC BUFFER
1620 b628 0c                    	CLC			SET 'CC' FOR NO ERROR
1621 b629 39                    	RTS			RETURN
1622 b62a 8d 03                 DINDX2	BSR	RNXTS		READ NEXT SECTOR
1623 b62c 24 ec                 	BCC	DINDEX		NO ERROR: GET BYTE
1624 b62e 39                    	RTS			RETURN WITH ERROR
1625 b62f fe b4 0b              RNXTS	LDX	CFCBAD		GET FCB ADDRESS
1626 b632 a6 40                 	LDAA	64,X		GET TRACK ADDRESS OF NEXT SECTOR
1627 b634 e6 41                 	LDAB	65,X		GET SECTOR ADDRESS NEXT SECTOR
1628 b636 6c 21                 	INC	33,X		INC CURRENT RECORD #
1629 b638 26 02                 	BNE	RNXTS1		IF NOT ZERO THEN CONTINUE
1630 b63a 6c 20                 	INC	32,X		INCREMENT MSB OF RECORD NUMBER
1631 b63c 4d                    RNXTS1	TSTA			END OF FILE?
1632 b63d 26 03                 	BNE	RNXTS2		NO:READ MORE
1633 b63f 5d                    	TSTB			END OF FILE?
1634 b640 27 1a                 	BEQ	RNXTS4		YES: RETURN
1635 b642 a7 1e                 RNXTS2	STAA	30,X		SET TRACK ADDRESS OF NEXT SECTOR TO BE READ
1636 b644 e7 1f                 	STAB	31,X		SET SECTOR ADDRESS OF NEXT SECTOR TO BE READ
1637 b646 36                    	PSHA			SAVE TRACK
1638 b647 86 04                 	LDAA	#4		SET DATA INDEX TO 1ST
1639 b649 a7 22                 	STAA	34,X		DATA BYTE OF NEW SECTOR
1640 b64b 32                    	PULA			RESTORE TRACK
1641 b64c 8d 12                 	BSR	RDSSEC		READ NEW SECTOR OF FILE
1642 b64e 24 0f                 	BCC	RNXTS6		NO ERRORS: RETURN
1643 b650 c5 80                 	BITB	#$80		ERRORS: IS IT A NOT READY ERROR?
1644 b652 27 04                 	BEQ	RNXTS3		NO: READ ERROR
1645 b654 c6 10                 	LDAB	#16		DRIVES NOT READY
1646 b656 20 06                 	BRA	RNXTS5		ERROR RETURN
1647 b658 c6 09                 RNXTS3	LDAB	#9		DISK FILE READ ERROR
1648 b65a 20 02                 	BRA	RNXTS5		ERROR RETURN
1649 b65c c6 08                 RNXTS4	LDAB	#8		READ PAST END OF FILE
1650 b65e 0d                    RNXTS5	SEC			SET ERROR FLAG
1651 b65f 39                    RNXTS6	RTS			RETURN
