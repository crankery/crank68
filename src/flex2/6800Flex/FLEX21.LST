1430                            *  INTO THE MOST SIGNIFICANT BYTE OF THE X REGISTER
1431                            *  AND THEN B REGISTER INTO THE LEAST SIGNIFICANT
1432                            *  BYTE OF THE INDEX REGISTER.
1433                            *
1434 b508 a7 00                 FMS12	STAA	0,X		SAVE MSB
1435 b50a e7 01                 	STAB	1,X		SAVE LSB
1436 b50c ee 00                 	LDX	0,X		LOAD INDEX REGISTER
1437 b50e 6f 00                 	CLR	0,X		CLEAR OUT
1438 b510 6f 01                 	CLR	1,X		TEMPORARY BYTES
1439 b512 0c                    	CLC			SET FOR NO ERROR
1440 b513 39                    	RTS			RETURN
1441 b514 8d 18                 FMS13	BSR	FMS15		BUMP POINTER BY 28 DECIMAL (TO FCB CHAIN ADDRESS)
1442 b516 27 04                 	BEQ	FMS14		IF COOL THEN TRANSFER NEXT FCB BYTES TO CURRENT FCB POINTER
1443 b518 c6 0d                 	LDAB	#$D		ILLEGAL FCB CODE
1444 b51a 0d                    	SEC			SET FOR ERROR
1445 b51b 39                    	RTS			RETURN
1446 b51c ff b4 0d              FMS14	STX	FTMP1		SAVE X IN TEMP
1447 b51f ee 00                 	LDX	0,X		GET POINTED TO ADDRESS (ADDRESS OF NEXT FCB)
1448 b521 a6 00                 	LDAA	0,X		GET BYTE
1449 b523 e6 01                 	LDAB	1,X		GET NEXT BYTE
1450 b525 fe b4 0d              	LDX	FTMP1		RESTORE POINTER
1451 b528 a7 00                 	STAA	0,X		SAVE BYTE
1452 b52a e7 01                 	STAB	1,X		SAVE NEXT BYTE
1453 b52c 0c                    	CLC			SET FOR NO ERROR
1454 b52d 39                    	RTS			RETURN
1455 b52e b6 b4 0b              FMS15	LDAA	CFCBAD		MSB OF CURRENT FCB ADDRESS
1456 b531 f6 b4 0c              	LDAB	CFCBAD+1	LSB OF CURRENT FCB ADDRESS
1457 b534 cb 1c                 	ADDB	#$1C		ADD 28 TO POINT TO ADDRESS OF NEXT FCB IN CHAIN
1458 b536 89 00                 	ADCA	#0		ADD CARRY TO MSB
1459 b538 ce b4 09              	LDX	#FCBBPT		GET ADDRESS OF FCB BASE POINTER
1460 b53b 6d 00                 FMS16	TST	0,X		DO WE HAVE A CHAIN?
1461 b53d 26 08                 	BNE	FMS17		YES: CONTINUE
1462 b53f 6d 01                 	TST	1,X		DO WE HAVE A CHAIN (LSB)
1463 b541 26 04                 	BNE	FMS17		YES: CONTINUE
1464 b543 8c ff ff              	CPX	#$FFFF		SET APPROPRIATE CC BITS FOR PROPER ERROR
1465 b546 39                    	RTS			RETURN
1466 b547 a1 00                 FMS17	CMPA	0,X
1467 b549 26 05                 	BNE	FMS18
1468 b54b e1 01                 	CMPB	1,X
1469 b54d 26 01                 	BNE	FMS18
1470 b54f 39                    	RTS
1471 b550 ee 00                 FMS18	LDX	0,X
1472 b552 20 e7                 	BRA	FMS16
1473                            *
1474                            * CLEAR STARTING ADDR TO END OF FCB BUFFER
1475                            *
1476 b554 fe b4 0b              FMS19	LDX	CFCBAD		GET ADDRESS OF CURRENT FCB
1477 b557 4f                    	CLRA			CLEAR A
1478 b558 c6 00                 	LDAB	#0		CLEAR A
1479 b55a 8d 02                 	BSR	FMS20		CLEAR 'B' BYTES
1480 b55c c6 2f                 	LDAB	#$2F		CLEAR $2F (47) BYTES
1481 b55e a7 11                 FMS20	STAA	17,X		SAVE A AT X+17  (STARTING TRACK ADDRESS IF X=FCB)
1482 b560 08                    	INX			BUMP POINTER
1483 b561 5a                    	DECB			DECRIMENT LOOP COUNTER
1484 b562 26 fa                 	BNE	FMS20		NOT DONE: LOOP
1485 b564 39                    	RTS			RETURN
1486                            *
1487                            * TRANSFER FILENAME & EXT TO NAME WORK BUFFER
1488                            *
1489 b565 fe b4 0b              FMS21	LDX	CFCBAD		GET CURRECT FCB ADDRESS
1490 b568 c6 0b                 	LDAB	#11		#OF BYTES TO MOVE
1491 b56a a6 04                 FMS22	LDAA	4,X		GET FILE NAME AND EXTENSION
1492 b56c a7 24                 	STAA	36,X		AND SAVE IN NAME WORK BUFFER
1493 b56e 08                    	INX			INCREMENT POINTER
1494 b56f 5a                    	DECB			DECRIMENT COUNTER
1495 b570 26 f8                 	BNE	FMS22		LOOP UNTIL DONE
1496 b572 39                    	RTS			RETURN
1497                            *
1498                            * COMPARE FILENAME & EXT TO NAME IN WORK BUFFER
1499                            *
1500 b573 fe b4 0b              FMS23	LDX	CFCBAD		GET CURRENT FCB ADDRESS
1501 b576 c6 0b                 	LDAB	#11		# OF BYTES TO COMPARE
1502 b578 a6 04                 FMS24	LDAA	4,X		GET BYTE
1503 b57a a1 24                 	CMPA	36,X		COMPARE TO NAME WORK BUFFER
1504 b57c 26 04                 	BNE	FMS25		IF NOT EQUAL: RETURN WITH 'Z'=0
1505 b57e 08                    	INX			BUMP POINTER
1506 b57f 5a                    	DECB			DECRIMENT COUNTER
1507 b580 26 f6                 	BNE	FMS24		LOOP TILL DONE
1508 b582 39                    FMS25	RTS			RETURN
1509                            *
1510                            * ADD B-REG TO X-REG
1511                            *
1512 b583 ff b4 0d              FMS26	STX	FTMP1		SAVE INDEX REGISTER
1513 b586 fb b4 0e              	ADDB	FTMP1+1		ADD LSB OF INDEX REGISTER TO 'B'
1514 b589 f7 b4 0e              	STAB	FTMP1+1		SAVE NEW VALUE IN LSB OF X TEMPORARY
1515 b58c 24 03                 	BCC	FMS27		NO CARRY JUST RETURN
1516 b58e 7c b4 0d              	INC	FTMP1		CARRY: INCREMENT MSB OF INDEX TEMPORARY
1517 b591 fe b4 0d              FMS27	LDX	FTMP1		GET NEW VALUE INTO INDEX REGISTER
1518 b594 39                    	RTS			RETURN
1519                            *
1520                            * GET RANDOM BYTE FROM SECTOR
1521                            *
1522 b595 fe b4 0b              GRANBY	LDX	CFCBAD		GET FCB ADDRESS
1523 b598 e6 02                 	LDAB	2,X		GET STATUS
1524 b59a 54                    	LSRB			SHIFT BIT 1 INTO CARRY
1525 b59b 25 04                 	BCS	GRANB1		YES: OPEN FOR READ
1526 b59d c6 12                 	LDAB	#$12		NO, SYS FILE STAUS ERROR
1527 b59f 20 15                 	BRA	GRANB3		REPORT ERROR
1528 b5a1 e6 23                 GRANB1	LDAB	35,X		GET RANDOM INDEX
1529 b5a3 7e b6 23              	JMP	DINDX1		GET BYTE AND RETURN
1530                            *
1531                            * STORE BYTE IN FCB AND INC DATA INDEX TO
1532                            * NEXT ADDRESS DISPLACEMENT
1533                            *
1534 b5a6 fe b4 0b              GRANB2	LDX	CFCBAD		GET ADDRESS OF CURRENT FCB
1535 b5a9 e6 22                 	LDAB	34,X		GET DATA INDEX
1536 b5ab 37                    	PSHB			SAVE IT
1537 b5ac 6c 22                 	INC	34,X		BUMP INDEX
1538 b5ae 8d d3                 	BSR	FMS26		ADDB TO X FOR READ
1539 b5b0 a7 40                 	STAA	64,X		STORE IN RANDOMLY IN FCB SECTOR BUFFER
1540 b5b2 33                    	PULB			RESTORE DATA INDEX INTO B
1541 b5b3 5c                    	INCB			INCREMENT DATA INDEX
1542 b5b4 26 21                 	BNE	PRANB2		NO ERROR THEN RETURN
1543 b5b6 0d                    GRANB3	SEC			SET CARRY FOR ERROR
1544 b5b7 39                    	RTS			RETURN
1545                            *
1546                            * PUT RANDOM BYTE IN SECTOR
1547                            *
1548 b5b8 fe b4 0b              PRANBY	LDX	CFCBAD		GET ADDRESS OF FCB
1549 b5bb e6 02                 	LDAB	2,X		GET STATUS
1550 b5bd c4 03                 	ANDB	#3		MASK OUT UNNECESSARY GARBAGE
1551 b5bf c1 03                 	CMPB	#3		OPEN FOR UPDATE?
1552 b5c1 27 04                 	BEQ	PRANB1		YES: THEN PUT BYTE
1553 b5c3 c6 12                 	LDAB	#18		NO, SYS FILE STATUS ERROR
1554 b5c5 0d                    	SEC			SET ERROR FLAG
1555 b5c6 39                    	RTS			RETURN
1556 b5c7 ca 80                 PRANB1	ORAB	#$80		SET RANDOM ACCESS ACTIVITY STATUS
1557 b5c9 e7 02                 	STAB	2,X		STORE STATUS IN FCB
1558 b5cb e6 0f                 	LDAB	15,X		GET FILE ATTRIBUTES
1559 b5cd c5 80                 	BITB	#$80		IS FILE WRITE PROTECTED?
1560 b5cf 26 08                 	BNE	PRANB3		YES: REPORT IT SO
1561 b5d1 e6 23                 	LDAB	35,X		GET RANDOM BYTE ADDRESS
1562 b5d3 8d ae                 	BSR	FMS26		ADD IT TO X FOR OFFSET
1563 b5d5 a7 40                 	STAA	64,X		STORE BYTE IN SECTOR BUFFER
1564 b5d7 0c                    PRANB2	CLC			CLEAR CARRY FOR NO ERROR CONDITION
1565 b5d8 39                    	RTS			RETURN
1566                            *
1567                            * REPORT FILE OR DISK WRITE PROTECTED
1568                            *
1569 b5d9 c6 0b                 PRANB3	LDAB	#11		DISK ERROR #11 (FILE OR DISK IS WRITE PROTECTED)
1570 b5db 0d                    	SEC			SET ERROR FLAG IN 'CC'
1571 b5dc 39                    	RTS			RETURN
1572                            *
1573                            * SPACE COMPRESSION
1574                            *
1575 b5dd a6 3b                 SPCOMP	LDAA	59,X		CK SPACE COMPRESSION FLAG
1576 b5df 2b 39                 	BMI	DINDEX		NO SPACE COMPRESSION
1577 b5e1 27 07                 	BEQ	SPCOM1		IF ZERO THEN DONE
1578 b5e3 4a                    	DECA			DO SPACE COMPRESSION
1579 b5e4 a7 3b                 	STAA	59,X		SAVE NEW SPACE COUNT
1580 b5e6 86 20                 	LDAA	#32		DECIMAL CODE FOR SPACE
1581 b5e8 20 1c                 	BRA	SPCOM3		RETURN WITH SPACE IN A
1582 b5ea 8d 2e                 SPCOM1	BSR	DINDEX		GET BYTE
1583 b5ec 25 19                 	BCS	SPCOM4		ERROR RETURN
1584 b5ee 81 18                 	CMPA	#24		IS IT A CONTROL/X?
1585 b5f0 22 14                 	BHI	SPCOM3		IF GREATER THEN NO ERROR
1586 b5f2 27 f6                 	BEQ	SPCOM1		YES: IGNORE IT
1587 b5f4 81 09                 	CMPA	#9		IS IT A TAB CHARACTER?
1588 b5f6 26 0b                 	BNE	SPCOM2		NO: CONTINUE CHECK
1589 b5f8 8d 20                 	BSR	DINDEX		YES: IGNORE
1590 b5fa 25 0b                 	BCS	SPCOM4		ERROR: RETURN
1591 b5fc fe b4 0b              	LDX	CFCBAD		GET CURRENT FCB ADDRESS
1592 b5ff a7 3b                 	STAA	59,X		SAVE COUNT
1593 b601 20 da                 	BRA	SPCOMP		AND GET ANOTHER BYTE
1594 b603 4d                    SPCOM2	TSTA			NULL?
1595 b604 27 e4                 	BEQ	SPCOM1		YES: IGNORE
1596 b606 0c                    SPCOM3	CLC			NO: NO ERROR RETURN
1597 b607 39                    SPCOM4	RTS			RETURN
