1738 b6f0 e6 3b                 	LDAB	59,X		SPACE COMPRESSION?
1739 b6f2 2b 35                 	BMI	WRBUF8		NO: WRITE
1740 b6f4 81 20                 	CMPA	#$20		YES: IS IT A SPACE?
1741 b6f6 26 0e                 	BNE	WRBUF2		NO: FINISH UP SPACE COMPRESSION
