1682 b68a b7 b4 11              	STAA	FTMP3		CLEAR ATTEMPT COUNTER
1683 b68d b7 b4 12              	STAA	FTMP4		CLEAR RESTORE COUNTER
1684 b690 39                    	RTS			RETURN
1685                            *
1686                            *  INTERPRETS 1771 ERROR CODES FOR READ SINGLE SECTOR
1687                            *
1688 b691 c5 10                 RDSEC6	BITB	#$10		RECORD NOT FOUND ERROR?
1689 b693 26 11                 	BNE	RDSEC7		YES: TAKE CARE OF ATTEMPT COUNTER
1690 b695 c5 80                 	BITB	#$80		NOT READY?
1691 b697 26 23                 	BNE	RDSEC8		YES: SET ERROR AND RETURN
1692 b699 f6 b4 11              	LDAB	FTMP3		GET ATTEMPT COUNTER
1693 b69c 5c                    	INCB			INCREMENT IT
1694 b69d c1 07                 	CMPB	#7		SEVEN TRIES?
1695 b69f 27 05                 	BEQ	RDSEC7		YES: ERROR
1696 b6a1 f7 b4 11              	STAB	FTMP3		SAVE NEW ATTEMPT COUNTER VALUE
1697 b6a4 20 14                 	BRA	RESER2		TRY AGAIN
1698 b6a6 7f b4 11              RDSEC7	CLR	FTMP3		CLEAR ATTEMPT COUNTER
1699 b6a9 f6 b4 12              	LDAB	FTMP4		RESTORE COUNTER
1700 b6ac 5c                    	INCB			INCREMENT IT
1701 b6ad c1 04                 	CMPB	#4		HAVE WE RESTORED 4 TIMES?
1702 b6af 27 0b                 	BEQ	RDSEC8		YES: ERROR EXIT
1703 b6b1 f7 b4 12              	STAB	FTMP4		SAVE NEW COUNTER VALUE
1704 b6b4 fe b4 0b              	LDX	CFCBAD		POINT TO FCB
1705 b6b7 bd be 89              	JSR	RESTOR		SEEK TRACK 00
1706 b6ba 0c                    RESER2	CLC			SET NO ERROR FLAG
1707 b6bb 39                    	RTS			RETURN
1708 b6bc 0d                    RDSEC8	SEC			SET ERROR FLAG
1709 b6bd 39                    	RTS			RETURN
