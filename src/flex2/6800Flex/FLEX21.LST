1751 b707 27 20                 	BEQ	WRBUF8		YES: WRITE OUT SECTOR
1752 b709 20 f6                 	BRA	WRBUF1		NO: MORE SPACE COMPRESSION
1753 b70b 0c                    WRBUF3	CLC			CLEAR ERROR FLAG
1754 b70c 39                    	RTS			RETURN
