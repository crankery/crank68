# Preserve displaced Atari glyphs before editing their ASCII positions.
# fontedit.py copies from the unpatched font, so these moves do not chain.
copy 00 7E
copy 10 7F
copy 1B 7D
copy 7F 1B

# Grave accent (`)
@60
........
..##....
...##...
....##..
........
........
........
........

# Left brace ({)
@7B
...###..
..##....
..##....
.##.....
..##....
..##....
...###..
........

# Right brace (})
@7D
..###...
....##..
....##..
.....##.
....##..
....##..
..###...
........

# Tilde (~)
@7E
........
........
.###.##.
##.###..
........
........
........
........
