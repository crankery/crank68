00:0CD0 08              	   180:         inx
00:0CD1 5A              	   181:         decb
00:0CD2 26FA            	   182:         bne highscore_name_clear
00:0CD4 7F109B          	   183:         clr name_count
00:0CD7 CE109F          	   184:         ldx #name_prompt
00:0CDA BD179B          	   185:         jsr print_at_prompt
00:0CDD CE10BD          	   186:         ldx #cursor_on_text
00:0CE0 BD18B5          	   187:         jsr print
                        	   188: highscore_name_key:
00:0CE3 BDBF00          	   189:         jsr getc
00:0CE6 810D            	   190:         cmpa #13
00:0CE8 2745            	   191:         beq highscore_name_done
00:0CEA 810A            	   192:         cmpa #10
00:0CEC 2741            	   193:         beq highscore_name_done
00:0CEE 8108            	   194:         cmpa #8
00:0CF0 2724            	   195:         beq highscore_name_backspace
00:0CF2 817F            	   196:         cmpa #127
00:0CF4 2720            	   197:         beq highscore_name_backspace
00:0CF6 8120            	   198:         cmpa #32
00:0CF8 25E9            	   199:         bcs highscore_name_key
00:0CFA 817E            	   200:         cmpa #126
00:0CFC 22E5            	   201:         bhi highscore_name_key
00:0CFE F6109B          	   202:         ldab name_count
00:0D01 C10A            	   203:         cmpb #10
00:0D03 24DE            	   204:         bcc highscore_name_key
00:0D05 FE1099          	   205:         ldx name_ptr
00:0D08 A700            	   206:         staa 0,x
00:0D0A 08              	   207:         inx
00:0D0B FF1099          	   208:         stx name_ptr
