                        	   186:         .include "highscore.inc"

Source: "highscore.inc"
                        	     1: ; LADDER.HIS on the drive from which FLEX loaded LADDER.CMD.
                        	     2: ; One FLEX sector: "C68H", then five 16-byte records. Each record has a
                        	     3: ; big-endian score, month/day/year bytes, and an 11-byte zero-padded name.
                        	     4: highscore_init:
00:0B7C B6A843          	     5:         ldaa command_drive
00:0B7F B7108A          	     6:         staa score_drive
00:0B82 BD0BFD          	     7:         jsr clear_highscores
00:0B85 BD0C09          	     8:         jsr prepare_score_fcb
00:0B88 8601            	     9:         ldaa #1
00:0B8A B70F4A          	    10:         staa score_fcb
00:0B8D CE0F4A          	    11:         ldx #score_fcb
00:0B90 BDB406          	    12:         jsr fms
00:0B93 2667            	    13:         bne highscore_init_done
00:0B95 86FF            	    14:         ldaa #0xff
00:0B97 B70F85          	    15:         staa score_fcb+59
00:0B9A CE0EF6          	    16:         ldx #score_magic
00:0B9D FF108D          	    17:         stx high_ptr
00:0BA0 8654            	    18:         ldaa #84
00:0BA2 B7108C          	    19:         staa bytes_left
                        	    20: highscore_read_next:
00:0BA5 7F0F4A          	    21:         clr score_fcb
00:0BA8 CE0F4A          	    22:         ldx #score_fcb
00:0BAB BDB406          	    23:         jsr fms
00:0BAE 262A            	    24:         bne highscore_read_bad
00:0BB0 FE108D          	    25:         ldx high_ptr
00:0BB3 A700            	    26:         staa 0,x
00:0BB5 08              	    27:         inx
00:0BB6 FF108D          	    28:         stx high_ptr
00:0BB9 7A108C          	    29:         dec bytes_left
00:0BBC 26E7            	    30:         bne highscore_read_next
00:0BBE B60EF6          	    31:         ldaa score_magic
00:0BC1 8143            	    32:         cmpa #'C'
00:0BC3 2615            	    33:         bne highscore_read_bad
00:0BC5 B60EF7          	    34:         ldaa score_magic+1
00:0BC8 8136            	    35:         cmpa #'6'
00:0BCA 260E            	    36:         bne highscore_read_bad
00:0BCC B60EF8          	    37:         ldaa score_magic+2
00:0BCF 8138            	    38:         cmpa #'8'
00:0BD1 2607            	    39:         bne highscore_read_bad
00:0BD3 B60EF9          	    40:         ldaa score_magic+3
00:0BD6 8148            	    41:         cmpa #'H'
00:0BD8 2717            	    42:         beq highscore_read_close
                        	    43: highscore_read_bad:
00:0BDA BD0BFD          	    44:         jsr clear_highscores
00:0BDD 8643            	    45:         ldaa #'C'
00:0BDF B70EF6          	    46:         staa score_magic
00:0BE2 8636            	    47:         ldaa #'6'
00:0BE4 B70EF7          	    48:         staa score_magic+1
00:0BE7 8638            	    49:         ldaa #'8'
00:0BE9 B70EF8          	    50:         staa score_magic+2
00:0BEC 8648            	    51:         ldaa #'H'
00:0BEE B70EF9          	    52:         staa score_magic+3
                        	    53: highscore_read_close:
00:0BF1 8604            	    54:         ldaa #4
00:0BF3 B70F4A          	    55:         staa score_fcb
00:0BF6 CE0F4A          	    56:         ldx #score_fcb
00:0BF9 BDB406          	    57:         jsr fms
                        	    58: highscore_init_done:
00:0BFC 39              	    59:         rts
                        	    60: 
                        	    61: clear_highscores:
00:0BFD CE0EFA          	    62:         ldx #top_scores
00:0C00 C650            	    63:         ldab #80
                        	    64: clear_highscores_next:
00:0C02 6F00            	    65:         clr 0,x
