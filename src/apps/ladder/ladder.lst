Source: "highscore.inc"
                        	     1: ; LADDER.HIS on the drive from which FLEX loaded LADDER.CMD.
                        	     2: ; One FLEX sector: "C68H", then five 16-byte records. Each record has a
                        	     3: ; big-endian score, month/day/year bytes, and an 11-byte zero-padded name.
                        	     4: highscore_init:
00:0BC2 B6A843          	     5:         ldaa command_drive
00:0BC5 B710D0          	     6:         staa score_drive
00:0BC8 BD0C43          	     7:         jsr clear_highscores
00:0BCB BD0C4F          	     8:         jsr prepare_score_fcb
00:0BCE 8601            	     9:         ldaa #1
00:0BD0 B70F90          	    10:         staa score_fcb
00:0BD3 CE0F90          	    11:         ldx #score_fcb
00:0BD6 BDB406          	    12:         jsr fms
00:0BD9 2667            	    13:         bne highscore_init_done
00:0BDB 86FF            	    14:         ldaa #0xff
00:0BDD B70FCB          	    15:         staa score_fcb+59
00:0BE0 CE0F3C          	    16:         ldx #score_magic
00:0BE3 FF10D3          	    17:         stx high_ptr
00:0BE6 8654            	    18:         ldaa #84
00:0BE8 B710D2          	    19:         staa bytes_left
                        	    20: highscore_read_next:
00:0BEB 7F0F90          	    21:         clr score_fcb
00:0BEE CE0F90          	    22:         ldx #score_fcb
00:0BF1 BDB406          	    23:         jsr fms
00:0BF4 262A            	    24:         bne highscore_read_bad
00:0BF6 FE10D3          	    25:         ldx high_ptr
00:0BF9 A700            	    26:         staa 0,x
00:0BFB 08              	    27:         inx
00:0BFC FF10D3          	    28:         stx high_ptr
00:0BFF 7A10D2          	    29:         dec bytes_left
00:0C02 26E7            	    30:         bne highscore_read_next
00:0C04 B60F3C          	    31:         ldaa score_magic
00:0C07 8143            	    32:         cmpa #'C'
00:0C09 2615            	    33:         bne highscore_read_bad
00:0C0B B60F3D          	    34:         ldaa score_magic+1
00:0C0E 8136            	    35:         cmpa #'6'
00:0C10 260E            	    36:         bne highscore_read_bad
00:0C12 B60F3E          	    37:         ldaa score_magic+2
00:0C15 8138            	    38:         cmpa #'8'
00:0C17 2607            	    39:         bne highscore_read_bad
00:0C19 B60F3F          	    40:         ldaa score_magic+3
00:0C1C 8148            	    41:         cmpa #'H'
00:0C1E 2717            	    42:         beq highscore_read_close
                        	    43: highscore_read_bad:
00:0C20 BD0C43          	    44:         jsr clear_highscores
00:0C23 8643            	    45:         ldaa #'C'
00:0C25 B70F3C          	    46:         staa score_magic
00:0C28 8636            	    47:         ldaa #'6'
00:0C2A B70F3D          	    48:         staa score_magic+1
00:0C2D 8638            	    49:         ldaa #'8'
00:0C2F B70F3E          	    50:         staa score_magic+2
00:0C32 8648            	    51:         ldaa #'H'
00:0C34 B70F3F          	    52:         staa score_magic+3
                        	    53: highscore_read_close:
00:0C37 8604            	    54:         ldaa #4
00:0C39 B70F90          	    55:         staa score_fcb
00:0C3C CE0F90          	    56:         ldx #score_fcb
00:0C3F BDB406          	    57:         jsr fms
                        	    58: highscore_init_done:
00:0C42 39              	    59:         rts
                        	    60: 
                        	    61: clear_highscores:
00:0C43 CE0F40          	    62:         ldx #top_scores
00:0C46 C650            	    63:         ldab #80
                        	    64: clear_highscores_next:
00:0C48 6F00            	    65:         clr 0,x
00:0C4A 08              	    66:         inx
00:0C4B 5A              	    67:         decb
00:0C4C 26FA            	    68:         bne clear_highscores_next
00:0C4E 39              	    69:         rts
                        	    70: 
                        	    71: prepare_score_fcb:
00:0C4F CE0F90          	    72:         ldx #score_fcb
00:0C52 C640            	    73:         ldab #64
                        	    74: prepare_score_clear:
00:0C54 6F00            	    75:         clr 0,x
00:0C56 08              	    76:         inx
00:0C57 5A              	    77:         decb
00:0C58 26FA            	    78:         bne prepare_score_clear
00:0C5A B610D0          	    79:         ldaa score_drive
00:0C5D B70F93          	    80:         staa score_fcb+3
00:0C60 CE0F31          	    81:         ldx #score_filename
00:0C63 C60B            	    82:         ldab #11
00:0C65 FF10D3          	    83:         stx high_ptr
00:0C68 CE0F94          	    84:         ldx #score_fcb+4
                        	    85: prepare_score_name:
00:0C6B FF10D5          	    86:         stx high_dst
00:0C6E FE10D3          	    87:         ldx high_ptr
00:0C71 A600            	    88:         ldaa 0,x
00:0C73 08              	    89:         inx
00:0C74 FF10D3          	    90:         stx high_ptr
00:0C77 FE10D5          	    91:         ldx high_dst
00:0C7A A700            	    92:         staa 0,x
00:0C7C 08              	    93:         inx
00:0C7D 5A              	    94:         decb
00:0C7E 26EB            	    95:         bne prepare_score_name
00:0C80 39              	    96:         rts
                        	    97: 
                        	    98: ; Called only when the last Lad dies. The original game records scores at
                        	    99: ; game over, so returning to the menu during a run does not submit it.
                        	   100: highscore_finish:
00:0C81 7D10D1          	   101:         tst highscore_eligible
00:0C84 2726            	   102:         beq highscore_finish_done
00:0C86 B61B71          	   103:         ldaa score
00:0C89 BA1B72          	   104:         oraa score+1
00:0C8C 271E            	   105:         beq highscore_finish_done
00:0C8E CE0F40          	   106:         ldx #top_scores
                        	   107: highscore_find:
00:0C91 B61B71          	   108:         ldaa score
00:0C94 A100            	   109:         cmpa 0,x
00:0C96 2215            	   110:         bhi highscore_qualifies
00:0C98 2507            	   111:         bcs highscore_next
00:0C9A B61B72          	   112:         ldaa score+1
00:0C9D A101            	   113:         cmpa 1,x
00:0C9F 240C            	   114:         bcc highscore_qualifies
                        	   115: highscore_next:
00:0CA1 C610            	   116:         ldab #16
                        	   117: highscore_step:
00:0CA3 08              	   118:         inx
00:0CA4 5A              	   119:         decb
00:0CA5 26FC            	   120:         bne highscore_step
00:0CA7 8C0F90          	   121:         cpx #top_scores+80
00:0CAA 26E5            	   122:         bne highscore_find
                        	   123: highscore_finish_done:
00:0CAC 39              	   124:         rts
                        	   125: highscore_qualifies:
00:0CAD FF10D7          	   126:         stx insert_ptr
00:0CB0 CE0F80          	   127:         ldx #top_scores+64
00:0CB3 FF10D9          	   128:         stx shift_dst
                        	   129: highscore_shift:
00:0CB6 BC10D7          	   130:         cpx insert_ptr
00:0CB9 272B            	   131:         beq highscore_insert
00:0CBB C610            	   132:         ldab #16
                        	   133: highscore_back:
00:0CBD 09              	   134:         dex
00:0CBE 5A              	   135:         decb
00:0CBF 26FC            	   136:         bne highscore_back
00:0CC1 FF10DB          	   137:         stx shift_src
00:0CC4 FF10DD          	   138:         stx shift_base
00:0CC7 C610            	   139:         ldab #16
                        	   140: highscore_copy:
00:0CC9 FE10DB          	   141:         ldx shift_src
00:0CCC A600            	   142:         ldaa 0,x
00:0CCE 08              	   143:         inx
00:0CCF FF10DB          	   144:         stx shift_src
00:0CD2 FE10D9          	   145:         ldx shift_dst
00:0CD5 A700            	   146:         staa 0,x
00:0CD7 08              	   147:         inx
00:0CD8 FF10D9          	   148:         stx shift_dst
00:0CDB 5A              	   149:         decb
00:0CDC 26EB            	   150:         bne highscore_copy
00:0CDE FE10DD          	   151:         ldx shift_base
00:0CE1 FF10D9          	   152:         stx shift_dst
00:0CE4 20D0            	   153:         bra highscore_shift
                        	   154: highscore_insert:
00:0CE6 B61B71          	   155:         ldaa score
00:0CE9 A700            	   156:         staa 0,x
00:0CEB B61B72          	   157:         ldaa score+1
00:0CEE A701            	   158:         staa 1,x
00:0CF0 B6AC0E          	   159:         ldaa flex_date
00:0CF3 A702            	   160:         staa 2,x
00:0CF5 B6AC0F          	   161:         ldaa flex_date+1
00:0CF8 A703            	   162:         staa 3,x
00:0CFA B6AC10          	   163:         ldaa flex_date+2
00:0CFD A704            	   164:         staa 4,x
00:0CFF BD0D06          	   165:         jsr highscore_name
00:0D02 BD0D8F          	   166:         jsr highscore_save
00:0D05 39              	   167:         rts
                        	   168: 
                        	   169: highscore_name:
00:0D06 FE10D7          	   170:         ldx insert_ptr
00:0D09 C605            	   171:         ldab #5
                        	   172: highscore_name_start:
00:0D0B 08              	   173:         inx
00:0D0C 5A              	   174:         decb
00:0D0D 26FC            	   175:         bne highscore_name_start
00:0D0F FF10DF          	   176:         stx name_ptr
00:0D12 C60B            	   177:         ldab #11
                        	   178: highscore_name_clear:
00:0D14 6F00            	   179:         clr 0,x
00:0D16 08              	   180:         inx
00:0D17 5A              	   181:         decb
00:0D18 26FA            	   182:         bne highscore_name_clear
00:0D1A 7F10E1          	   183:         clr name_count
00:0D1D CE10E5          	   184:         ldx #name_prompt
00:0D20 BD18D7          	   185:         jsr print_at_prompt
00:0D23 CE1103          	   186:         ldx #cursor_on_text
00:0D26 BD1A2E          	   187:         jsr print
                        	   188: highscore_name_key:
00:0D29 BDBF00          	   189:         jsr getc
00:0D2C 810D            	   190:         cmpa #13
00:0D2E 2745            	   191:         beq highscore_name_done
00:0D30 810A            	   192:         cmpa #10
00:0D32 2741            	   193:         beq highscore_name_done
00:0D34 8108            	   194:         cmpa #8
00:0D36 2724            	   195:         beq highscore_name_backspace
00:0D38 817F            	   196:         cmpa #127
00:0D3A 2720            	   197:         beq highscore_name_backspace
00:0D3C 8120            	   198:         cmpa #32
00:0D3E 25E9            	   199:         bcs highscore_name_key
00:0D40 817E            	   200:         cmpa #126
00:0D42 22E5            	   201:         bhi highscore_name_key
00:0D44 F610E1          	   202:         ldab name_count
00:0D47 C10A            	   203:         cmpb #10
00:0D49 24DE            	   204:         bcc highscore_name_key
00:0D4B FE10DF          	   205:         ldx name_ptr
00:0D4E A700            	   206:         staa 0,x
00:0D50 08              	   207:         inx
00:0D51 FF10DF          	   208:         stx name_ptr
00:0D54 7C10E1          	   209:         inc name_count
00:0D57 BDAD0F          	   210:         jsr outch
00:0D5A 20CD            	   211:         bra highscore_name_key
                        	   212: highscore_name_backspace:
00:0D5C 7D10E1          	   213:         tst name_count
00:0D5F 27C8            	   214:         beq highscore_name_key
00:0D61 7A10E1          	   215:         dec name_count
00:0D64 FE10DF          	   216:         ldx name_ptr
00:0D67 09              	   217:         dex
00:0D68 FF10DF          	   218:         stx name_ptr
00:0D6B 6F00            	   219:         clr 0,x
