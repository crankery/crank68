00: "org0001:300" (300-1891)


Source: "flex/ladder.s"
                        	     1: ; Easy Street prototype for C68 FLEX and an ANSI/VT100 terminal.
                        	     2: ; Terrain is generated from Pascal layouts with original-game corrections.
                        	     3: ; Movement follows the probed original CP/M Ladder rules.
                        	     4: ; SPDX-License-Identifier: GPL-2.0-or-later
                        	     5:         .equ outch, 0xad0f
                        	     6:         .equ warms, 0xad03
