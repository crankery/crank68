00:0C1F FF108D          	    83:         stx high_ptr
00:0C22 CE0F4E          	    84:         ldx #score_fcb+4
                        	    85: prepare_score_name:
00:0C25 FF108F          	    86:         stx high_dst
00:0C28 FE108D          	    87:         ldx high_ptr
00:0C2B A600            	    88:         ldaa 0,x
00:0C2D 08              	    89:         inx
00:0C2E FF108D          	    90:         stx high_ptr
00:0C31 FE108F          	    91:         ldx high_dst
00:0C34 A700            	    92:         staa 0,x
00:0C36 08              	    93:         inx
00:0C37 5A              	    94:         decb
00:0C38 26EB            	    95:         bne prepare_score_name
00:0C3A 39              	    96:         rts
                        	    97: 
                        	    98: ; Called only when the last Lad dies. The original game records scores at
                        	    99: ; game over, so returning to the menu during a run does not submit it.
                        	   100: highscore_finish:
00:0C3B 7D108B          	   101:         tst highscore_eligible
00:0C3E 2726            	   102:         beq highscore_finish_done
00:0C40 B619F0          	   103:         ldaa score
00:0C43 BA19F1          	   104:         oraa score+1
00:0C46 271E            	   105:         beq highscore_finish_done
00:0C48 CE0EFA          	   106:         ldx #top_scores
                        	   107: highscore_find:
00:0C4B B619F0          	   108:         ldaa score
00:0C4E A100            	   109:         cmpa 0,x
00:0C50 2215            	   110:         bhi highscore_qualifies
00:0C52 2507            	   111:         bcs highscore_next
00:0C54 B619F1          	   112:         ldaa score+1
00:0C57 A101            	   113:         cmpa 1,x
00:0C59 240C            	   114:         bcc highscore_qualifies
                        	   115: highscore_next:
00:0C5B C610            	   116:         ldab #16
                        	   117: highscore_step:
00:0C5D 08              	   118:         inx
00:0C5E 5A              	   119:         decb
00:0C5F 26FC            	   120:         bne highscore_step
00:0C61 8C0F4A          	   121:         cpx #top_scores+80
00:0C64 26E5            	   122:         bne highscore_find
                        	   123: highscore_finish_done:
00:0C66 39              	   124:         rts
                        	   125: highscore_qualifies:
00:0C67 FF1091          	   126:         stx insert_ptr
00:0C6A CE0F3A          	   127:         ldx #top_scores+64
00:0C6D FF1093          	   128:         stx shift_dst
                        	   129: highscore_shift:
00:0C70 BC1091          	   130:         cpx insert_ptr
00:0C73 272B            	   131:         beq highscore_insert
00:0C75 C610            	   132:         ldab #16
                        	   133: highscore_back:
00:0C77 09              	   134:         dex
00:0C78 5A              	   135:         decb
00:0C79 26FC            	   136:         bne highscore_back
00:0C7B FF1095          	   137:         stx shift_src
00:0C7E FF1097          	   138:         stx shift_base
00:0C81 C610            	   139:         ldab #16
                        	   140: highscore_copy:
00:0C83 FE1095          	   141:         ldx shift_src
00:0C86 A600            	   142:         ldaa 0,x
00:0C88 08              	   143:         inx
00:0C89 FF1095          	   144:         stx shift_src
00:0C8C FE1093          	   145:         ldx shift_dst
00:0C8F A700            	   146:         staa 0,x
00:0C91 08              	   147:         inx
00:0C92 FF1093          	   148:         stx shift_dst
00:0C95 5A              	   149:         decb
00:0C96 26EB            	   150:         bne highscore_copy
00:0C98 FE1097          	   151:         ldx shift_base
00:0C9B FF1093          	   152:         stx shift_dst
00:0C9E 20D0            	   153:         bra highscore_shift
                        	   154: highscore_insert:
00:0CA0 B619F0          	   155:         ldaa score
00:0CA3 A700            	   156:         staa 0,x
00:0CA5 B619F1          	   157:         ldaa score+1
00:0CA8 A701            	   158:         staa 1,x
00:0CAA B6AC0E          	   159:         ldaa flex_date
00:0CAD A702            	   160:         staa 2,x
00:0CAF B6AC0F          	   161:         ldaa flex_date+1
00:0CB2 A703            	   162:         staa 3,x
00:0CB4 B6AC10          	   163:         ldaa flex_date+2
00:0CB7 A704            	   164:         staa 4,x
00:0CB9 BD0CC0          	   165:         jsr highscore_name
00:0CBC BD0D49          	   166:         jsr highscore_save
00:0CBF 39              	   167:         rts
