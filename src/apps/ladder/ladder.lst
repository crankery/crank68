Source: "menu.inc"
                        	     1: ; The opening menu follows the original Ladder logo and option layout.
                        	     2: ; Only options supported by this Easy Street port are shown.
                        	     3: start_screen:
00:03E6 BD0455          	     4:         jsr draw_start_screen
                        	     5: menu_wait:
