00:0D11 BDAD0F          	   210:         jsr outch
00:0D14 20CD            	   211:         bra highscore_name_key
                        	   212: highscore_name_backspace:
00:0D16 7D109B          	   213:         tst name_count
00:0D19 27C8            	   214:         beq highscore_name_key
00:0D1B 7A109B          	   215:         dec name_count
00:0D1E FE1099          	   216:         ldx name_ptr
00:0D21 09              	   217:         dex
00:0D22 FF1099          	   218:         stx name_ptr
00:0D25 6F00            	   219:         clr 0,x
00:0D27 CE10CB          	   220:         ldx #erase_char_text
00:0D2A BD18B5          	   221:         jsr print
