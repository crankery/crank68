Sections:
00: "org0001:300" (300-DF5)


Source: "flex/ladder.s"
                        	     1: ; Easy Street prototype for C68 FLEX and an ANSI/VT100 terminal.
                        	     2: ; Terrain is generated from Pascal layouts with original-game corrections.
                        	     3: ; Movement follows the probed original CP/M Ladder rules.
                        	     4: ; SPDX-License-Identifier: GPL-2.0-or-later
                        	     5:         .equ outch, 0xad0f
                        	     6:         .equ warms, 0xad03
                        	     7:         .equ getc, 0xbf00
                        	     8:         .equ poll, 0xbf2a
                        	     9: 
                        	    10:         .org 0x0300
                        	    11: start:
00:0300 BF078F          	    12:         sts saved_sp
00:0303 8606            	    13:         ldaa #6
00:0305 B70791          	    14:         staa player_x
00:0308 8613            	    15:         ldaa #19
00:030A B70792          	    16:         staa player_y
00:030D 7F0797          	    17:         clr direction
00:0310 7F0798          	    18:         clr jump_step
