                        	   281: 
                        	   282: ; Original jump: up/up, two apex steps, down/down.
                        	   283: ; Horizontal motion is applied on each step of a moving jump.
                        	   284: move_jump:
00:052C B60791          	   285:         ldaa player_x
00:052F B70795          	   286:         staa target_x
