                        	   250: ; Ordinary sideways movement consumes '-' below the departed cell.
                        	   251: ; A jump's horizontal apex uses move_jump and leaves that floor intact.
                        	   252: clear_departed_floor:
00:04F2 B60793          	   253:         ldaa old_x
00:04F5 B70795          	   254:         staa target_x
00:04F8 B7079B          	   255:         staa cursor_col
00:04FB B60794          	   256:         ldaa old_y
00:04FE 4C              	   257:         inca
00:04FF B70796          	   258:         staa target_y
00:0502 B7079C          	   259:         staa cursor_row
00:0505 BD061A          	   260:         jsr target_tile
00:0508 812D            	   261:         cmpa #'-'
00:050A 260C            	   262:         bne floor_clear_done
