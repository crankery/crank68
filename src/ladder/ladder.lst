00:05C9 B60791          	   363:         ldaa player_x
00:05CC B70795          	   364:         staa target_x
00:05CF B60792          	   365:         ldaa player_y
00:05D2 B70796          	   366:         staa target_y
00:05D5 BD061A          	   367:         jsr target_tile
00:05D8 8148            	   368:         cmpa #'H'
